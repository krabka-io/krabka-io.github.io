---
import Logo from './Logo.astro';
import { getPath } from '../utils/paths';
---

<footer class="border-t border-white/10 bg-ocean-950/80 pt-16 pb-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-white/10">
      
      <!-- Column 1: Brand & Origin -->
      <div class="md:col-span-1 space-y-4">
        <div class="flex items-center gap-3">
          <Logo className="w-8 h-8" />
          <span class="text-xl font-bold tracking-tight text-white">Krabka</span>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed">
          Native-Rust Apache Kafka-compatible broker, KRaft consensus quorum, and polyglot streaming engine.
        </p>
      </div>

      <!-- Column 2: Navigation -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-300 mb-4">Platform</h4>
        <ul class="space-y-2.5 text-sm text-gray-400">
          <li><a href={getPath('/get-started')} class="hover:text-krab-400 transition-colors">Get Started</a></li>
          <li><a href={getPath('/features')} class="hover:text-krab-400 transition-colors">Features & Architecture</a></li>
          <li><a href={getPath('/versions')} class="hover:text-krab-400 transition-colors">Versions & Matrix</a></li>
          <li><a href={getPath('/benchmarks')} class="hover:text-krab-400 transition-colors">Benchmarks</a></li>
          <li><a href={getPath('/docs')} class="hover:text-krab-400 transition-colors">Documentation</a></li>
        </ul>
      </div>

      <!-- Column 3: Ecosystem -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-300 mb-4">Ecosystem</h4>
        <ul class="space-y-2.5 text-sm text-gray-400">
          <li><a href="https://github.com/krabka-io/krabka-broker" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-broker</a></li>
          <li><a href="https://github.com/krabka-io/krabka-client-rs" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-client-rs</a></li>
          <li><a href="https://github.com/krabka-io/krabka-streams-go" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-streams-go (Arrow)</a></li>
          <li><a href="https://github.com/krabka-io/krabka-operator" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-operator (K8s)</a></li>
          <li><a href="https://github.com/krabka-io/krabka-connect" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-connect (CDC)</a></li>
        </ul>
      </div>

      <!-- Column 4: Community & License -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-300 mb-4">Community</h4>
        <ul class="space-y-2.5 text-sm text-gray-400">
          <li>
            <a href="https://github.com/krabka-io" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors flex items-center gap-2">
              <span>GitHub Organization</span>
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li><a href={getPath('/docs/quickstart')} class="hover:text-krab-400 transition-colors">Quickstart Guide</a></li>
          <li><a href={getPath('/versions#slsa')} class="hover:text-krab-400 transition-colors">SLSA Build Provenance</a></li>
          <li><span class="text-xs text-gray-500">Apache License 2.0</span></li>
        </ul>
      </div>

    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between pt-8 text-xs text-gray-500 gap-4">
      <div>
        &copy; {new Date().getFullYear()} The Krabka Authors. Released under the Apache License 2.0.
      </div>
      <div>
        Hosted at <a href="https://krabka.io" class="text-gray-400 hover:text-krab-400 font-medium">krabka.io</a>
      </div>
    </div>
  </div>
</footer>
