---
import Logo from './Logo.astro';
import { getPath } from '../utils/paths';

// Four short columns. Pages already in the top nav (Features, Versions,
// Verification, Benchmarks, News, Docs, API, GitHub) are not repeated here,
// except Get started and Documentation as the usual next steps. The full,
// grouped repository list is the GitHub organization README, so the footer
// cannot drift from it.
const external = { target: '_blank', rel: 'noopener noreferrer' };
const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Get started', href: getPath('/get-started') },
      { label: 'Migrate from Kafka', href: getPath('/docs/migration') },
      { label: 'Operate a cluster', href: getPath('/docs/operations') },
      { label: 'Kafka compatibility', href: getPath('/docs/kip-matrix') },
      { label: 'Documentation', href: getPath('/docs') },
    ],
  },
  {
    title: 'Try it',
    links: [
      { label: 'All browser tools', href: getPath('/docs/browser-tools') },
      { label: 'Cluster Lab', href: getPath('/docs/lab') },
      { label: 'Consensus playground', href: getPath('/docs/playground') },
      { label: 'Proof explorer', href: getPath('/docs/proof-explorer') },
    ],
  },
  {
    title: 'Repositories',
    links: [
      { label: 'krabka-broker', href: 'https://github.com/krabka-io/krabka-broker', external: true },
      { label: 'krabka-operator', href: 'https://github.com/krabka-io/krabka-operator', external: true },
      { label: 'krabka-client-rs', href: 'https://github.com/krabka-io/krabka-client-rs', external: true },
      { label: 'Streams libraries', href: getPath('/features/streams') },
      { label: 'All repositories', href: 'https://github.com/krabka-io', external: true },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'Report an issue', href: 'https://github.com/krabka-io/krabka-broker/issues', external: true },
      { label: 'Contributing', href: 'https://github.com/krabka-io/krabka-broker/blob/main/CONTRIBUTING.md', external: true },
      { label: 'Security policy', href: 'https://github.com/krabka-io/krabka-broker/blob/main/SECURITY.md', external: true },
      { label: 'Release feed (RSS)', href: getPath('/releases.xml') },
      { label: 'Brand assets', href: getPath('/brand') },
    ],
  },
];
---

<footer class="border-t border-white/10 bg-ocean-950/80 pt-14 pb-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 border-b border-white/10 pb-10 lg:grid-cols-[1.5fr_repeat(4,1fr)]">
      <div class="col-span-2 space-y-4 lg:col-span-1 lg:pr-6">
        <div class="flex items-center gap-3">
          <Logo className="w-8 h-8" />
          <span class="text-xl font-bold tracking-tight text-white">krabka</span>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-gray-400">
          An open-source broker compatible with the Kafka protocol, written in safe Rust with its own KRaft quorum. Key consensus and replication decisions are proved with Creusot and model-checked with Stateright.
        </p>
      </div>

      {columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-gray-300">{column.title}</p>
          <ul class="space-y-2.5 text-sm text-gray-400">
            {column.links.map((link) => (
              <li>
                <a href={link.href} {...(link.external ? external : {})} class="inline-block py-0.5 transition-colors hover:text-krab-400">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <p class="pt-8 text-center text-xs text-gray-400 sm:text-left">
      &copy; {new Date().getFullYear()} The krabka Authors. Released under the
      <a href="https://github.com/krabka-io/krabka-broker/blob/main/LICENSE" {...external} class="underline underline-offset-2 hover:text-krab-400">Apache License 2.0</a>.
    </p>
  </div>
</footer>
