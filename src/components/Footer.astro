---
import Logo from './Logo.astro';
import { getPath } from '../utils/paths';
---

<footer class="border-t border-white/10 bg-ocean-950/80 pt-16 pb-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-white/10">
      
      <!-- Column 1: Brand & Origin -->
      <div class="sm:col-span-2 lg:col-span-1 space-y-4">
        <div class="flex items-center gap-3">
          <Logo className="w-8 h-8" />
          <span class="text-xl font-bold tracking-tight text-white">krabka</span>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed">
          Apache Kafka-compatible broker and KRaft consensus quorum in safe Rust, with <a href="https://creusot.rs/" target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Creusot</a>-proved kernels and <a href="https://www.stateright.rs/" target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Stateright</a>-checked models.
        </p>
      </div>

      <!-- Column 2: Navigation -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-300 mb-4">Platform</p>
        <ul class="space-y-2.5 text-sm text-gray-400">
          <li><a href={getPath('/get-started')} class="hover:text-krab-400 transition-colors">Get Started</a></li>
          <li><a href={getPath('/features')} class="hover:text-krab-400 transition-colors">Features & Architecture</a></li>
          <li><a href={getPath('/versions')} class="hover:text-krab-400 transition-colors">Versions & Matrix</a></li>
          <li><a href={getPath('/verification')} class="hover:text-krab-400 transition-colors">Correctness & Verification</a></li>
          <li><a href={getPath('/benchmarks')} class="hover:text-krab-400 transition-colors">Broker Benchmarks</a></li>
          <li><a href={getPath('/releases')} class="hover:text-krab-400 transition-colors">Release Notes</a></li>
          <li><a href={getPath('/docs/migration')} class="hover:text-krab-400 transition-colors">Migrating from Kafka</a></li>
          <li><a href={getPath('/docs')} class="hover:text-krab-400 transition-colors">Documentation</a></li>
          <li><a href={getPath('/docs/operations')} class="hover:text-krab-400 transition-colors">Operate a cluster</a></li>
          <li><a href={getPath('/api')} class="hover:text-krab-400 transition-colors">API Reference Directory</a></li>
          <li><a href={getPath('/docs/browser-tools')} class="hover:text-krab-400 transition-colors">Browser tools</a></li>
          <li><a href={getPath('/docs/lab')} class="hover:text-krab-400 transition-colors">Cluster Lab</a></li>
          <li><a href={getPath('/docs/playground')} class="hover:text-krab-400 transition-colors">Consensus Playground</a></li>
          <li><a href={getPath('/docs/verification-playground')} class="hover:text-krab-400 transition-colors">Verification Playground</a></li>
          <li><a href={getPath('/docs/proof-explorer')} class="hover:text-krab-400 transition-colors">Proof Explorer</a></li>
        </ul>
      </div>

      <!-- Column 3: Kafka ecosystem and the broader krabka ecosystem -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-300 mb-4">Kafka Ecosystem</p>
        <ul class="space-y-2.5 text-sm text-gray-400">
          <li><a href="https://github.com/krabka-io/krabka-broker" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-broker</a></li>
          <li><a href="https://github.com/krabka-io/krabka-protocol" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-protocol</a></li>
          <li><a href="https://github.com/krabka-io/krabka-client-rs" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-client-rs</a></li>
          <li><a href="https://github.com/krabka-io/krabka-streams-java" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-streams-java (JVM & Arrow)</a></li>
          <li><a href="https://github.com/krabka-io/krabka-streams-go" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-streams-go (Arrow)</a></li>
          <li><a href="https://github.com/krabka-io/krabka-schema-registry" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-schema-registry</a></li>
          <li><a href="https://github.com/krabka-io/krabka-operator" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-operator (K8s)</a></li>
          <li><a href="https://github.com/krabka-io/krabka-connect" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-connect (CDC)</a></li>
        </ul>
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-300 mb-3 mt-6">Broader krabka Ecosystem</p>
        <ul class="space-y-2.5 text-sm text-gray-400">
          <li><a href="https://krabka.io/krabka-o11y/" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">krabka-o11y (observability)</a></li>
          <li><a href="https://github.com/krabka-io/gres" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">gres (Postgres on krabka)</a></li>
        </ul>
      </div>

      <!-- Column 4: Community & License -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-300 mb-4">Community</p>
        <ul class="space-y-2.5 text-sm text-gray-400">
          <li>
            <a href="https://github.com/krabka-io" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors flex items-center gap-2">
              <span>GitHub Organization</span>
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li><a href="https://github.com/krabka-io/krabka-broker/issues" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">Report a Bug or Ask a Question</a></li>
          <li><a href="https://github.com/krabka-io/krabka-broker/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">Contributing Guide</a></li>
          <li><a href="https://github.com/krabka-io/krabka-broker/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">Security Policy</a></li>
          <li><a href={getPath('/releases.xml')} class="hover:text-krab-400 transition-colors">Release Feed (RSS)</a></li>
          <li><a href={getPath('/docs/helm-charts')} class="hover:text-krab-400 transition-colors">Helm Chart Repository</a></li>
          <li><a href={getPath('/brand')} class="hover:text-krab-400 transition-colors">Brand Assets</a></li>
          <li><a href={getPath('/versions#slsa')} class="hover:text-krab-400 transition-colors">SLSA Build Provenance</a></li>
          <li><a href="https://github.com/krabka-io/krabka-broker/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="hover:text-krab-400 transition-colors">Apache License 2.0</a></li>
        </ul>
      </div>

    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between pt-8 text-xs text-gray-400 gap-4">
      <div class="text-center sm:text-left">
        &copy; {new Date().getFullYear()} The krabka Authors. Released under the Apache License 2.0.
      </div>
      <div>
        Hosted at <a href="https://krabka.io" class="text-gray-400 hover:text-krab-400 font-medium">krabka.io</a>
      </div>
    </div>
  </div>
</footer>
