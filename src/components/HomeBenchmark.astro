---
// The home page's benchmark summary. The copy and the grid are computed from
// the published OpenMessaging run; see src/utils/home-benchmark.mjs.
import { openmessaging } from '../utils/benchmarks.mjs';
import { homeBenchmark } from '../utils/home-benchmark.mjs';
import { getPath } from '../utils/paths';

const result = homeBenchmark(openmessaging);
---

{result && (
  <section aria-labelledby="benchmark-heading" data-no-anchor class="py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="benchmark-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{result.heading}</h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-gray-300">{result.body}</p>

      <table class="mt-8 w-full max-w-xl border-collapse text-left">
        <caption class="mb-3 text-left text-sm font-semibold text-gray-200">Publish rate as a share of Apache Kafka’s (median per group)</caption>
        <thead>
          <tr class="border-b border-white/10">
            <td class="py-2 pr-4"></td>
            {result.grid.columns.map((column) => (
              <th scope="col" class="px-4 py-2 text-right text-sm font-semibold text-gray-300">{column}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {result.grid.rows.map((row) => (
            <tr class="border-b border-white/5">
              <th scope="row" class="py-3 pr-4 text-sm font-semibold text-gray-300">{row.label}</th>
              {row.cells.map((cell) => (
                <td class="px-4 py-3 text-right text-2xl font-bold tabular-nums text-white">{cell?.value ?? '–'}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>

      <p class="mt-4 max-w-3xl text-sm text-gray-400">
        100% is Kafka’s rate on the same workload. {result.rounds}, on a shared host.
        <a href={getPath('/benchmarks')} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Every workload, latency, and methodology</a>
      </p>
    </div>
  </section>
)}
