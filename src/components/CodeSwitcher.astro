---
const snippets = [
  {
    id: 'rust',
    label: 'Rust Client',
    tag: 'krabka-client-rs',
    code: `use krabka_client::producer::{FutureProducer, ProducerRecord};

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let producer = FutureProducer::builder()
        .bootstrap_servers("localhost:9092")
        .build()?;

    // Zero-allocation async produce
    let delivery = producer.send(
        ProducerRecord::to("telemetry")
            .key("sensor-042")
            .payload(b"{\\"temp\\": 23.4, \\"status\\": \\"nominal\\"}"),
    ).await?;

    println!("Acked at partition {} offset {}", delivery.partition, delivery.offset);
    Ok(())
}`
  },
  {
    id: 'go',
    label: 'Go Streams (Arrow)',
    tag: 'krabka-streams-go',
    code: `package main

import (
	"context"
	"github.com/krabka-io/krabka-streams-go/streams"
	"github.com/apache/arrow/go/v17/arrow"
)

func main() {
	builder := streams.NewTopologyBuilder()
	
	// Stream processing with Zero-Copy Apache Arrow record batches
	builder.Stream("events").
		Filter(func(record arrow.Record) bool {
			return record.NumRows() > 0
		}).
		To("aggregated-events")

	app := streams.NewApplication(builder.Build(), streams.Config{
		BootstrapServers: []string{"localhost:9092"},
	})
	app.Run(context.Background())
}`
  },
  {
    id: 'java',
    label: 'Java Streams',
    tag: 'krabka-streams-java',
    code: `import io.krabka.streams.KrabkaStreams;
import io.krabka.streams.StreamsBuilder;
import io.krabka.streams.kstream.KStream;

public class FraudDetectionApp {
    public static void main(String[] args) {
        StreamsBuilder builder = new StreamsBuilder();
        KStream<String, Transaction> transactions = builder.stream("transactions");

        transactions
            .filter((key, tx) -> tx.getAmount() > 10000.0)
            .to("flagged-transactions");

        KrabkaStreams streams = new KrabkaStreams(builder.build(), "localhost:9092");
        streams.start();
    }
}`
  },
  {
    id: 'k8s',
    label: 'Kubernetes CRD',
    tag: 'krabka-operator',
    code: `apiVersion: krabka.io/v1alpha1
kind: KrabkaCluster
metadata:
  name: production-cluster
  namespace: streaming
spec:
  replicas: 3
  version: "1.0.0"
  storage:
    tiered:
      enabled: true
      bucket: "s3://krabka-cold-storage"
      region: "us-west-2"
  resources:
    limits:
      cpu: "4"
      memory: "2Gi"
    requests:
      cpu: "500m"
      memory: "512Mi"`
  }
];
---

<section class="py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-8">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Native Polyglot Developer Experience
      </h2>
      <p class="mt-3 text-lg text-gray-400">
        First-class client libraries and stream processing engines for Rust, Go, Java, and Kubernetes.
      </p>
    </div>

    <div class="frosted-card rounded-2xl overflow-hidden shadow-2xl border border-white/10">
      <!-- Tabs Header -->
      <div class="flex flex-wrap items-center justify-between border-b border-white/10 bg-slate-950/80 px-4 py-2.5">
        <div class="flex items-center space-x-2" role="tablist">
          {snippets.map((s, index) => (
            <button
              role="tab"
              data-target={s.id}
              aria-selected={index === 0 ? "true" : "false"}
              class={`code-tab-btn rounded-lg px-3.5 py-1.5 text-sm font-semibold transition-all ${
                index === 0
                  ? 'bg-krab-500 text-white shadow'
                  : 'text-gray-400 hover:text-white hover:bg-white/5'
              }`}
            >
              {s.label}
            </button>
          ))}
        </div>

        <div id="active-tag" class="hidden sm:inline-flex items-center rounded-full bg-white/5 border border-white/10 px-2.5 py-0.5 text-xs font-mono text-krab-400">
          krabka-client-rs
        </div>
      </div>

      <!-- Code Panels -->
      <div class="relative bg-slate-950/95 p-4 sm:p-6 overflow-x-auto">
        {snippets.map((s, index) => (
          <div
            id={`panel-${s.id}`}
            class={`code-panel ${index === 0 ? 'block' : 'hidden'}`}
            data-tag={s.tag}
          >
            <pre class="font-mono text-sm leading-relaxed text-gray-200"><code class="language-rust">{s.code}</code></pre>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.code-tab-btn');
  const panels = document.querySelectorAll('.code-panel');
  const tagDisplay = document.getElementById('active-tag');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');

      // Update button states
      tabBtns.forEach((b) => {
        b.classList.remove('bg-krab-500', 'text-white', 'shadow');
        b.classList.add('text-gray-400', 'hover:text-white', 'hover:bg-white/5');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('bg-krab-500', 'text-white', 'shadow');
      btn.classList.remove('text-gray-400', 'hover:text-white', 'hover:bg-white/5');
      btn.setAttribute('aria-selected', 'true');

      // Show matching panel
      panels.forEach((p) => {
        if (p.id === `panel-${targetId}`) {
          p.classList.remove('hidden');
          p.classList.add('block');
          if (tagDisplay) {
            tagDisplay.textContent = p.getAttribute('data-tag') || '';
          }
        } else {
          p.classList.add('hidden');
          p.classList.remove('block');
        }
      });
    });
  });
</script>
