---
import CodeBlock from './CodeBlock.astro';
const snippets = [
  {
    id: 'rust',
    lang: 'rust',
    label: 'Rust Client',
    tag: 'krabka-client-rs',
    code: `// Cargo.toml:
//   krabka-client-producer = { git = "https://github.com/krabka-io/krabka-client-rs" }
//   plus the [patch.crates-io] block from that repository's Cargo.toml (see /docs/streams-rs)
//   bytes = "1"
//   tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
use bytes::Bytes;
use krabka_client_producer::{Acks, Producer, ProducerRecord};

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let producer = Producer::builder()
        .bootstrap("localhost:9092")
        .acks(Acks::All)
        .build()
        .await?;

    let metadata = producer
        .send(ProducerRecord {
            topic: "quickstart-events".into(),
            key: Some(Bytes::from("user-1")),
            value: Some(Bytes::from("Hello Krabka from Rust!")),
            ..Default::default()
        })
        .await
        .await??;

    producer.flush().await?;
    producer.close().await?;
    println!("Delivered to partition {} at offset {}.", metadata.partition, metadata.offset);
    Ok(())
}`
  },
  {
    id: 'go',
    lang: 'go',
    label: 'Go Streams (Arrow)',
    tag: 'krabka-streams-go',
    code: `package main

import (
	"log"

	"github.com/apache/arrow-go/v18/arrow"
	"github.com/apache/arrow-go/v18/arrow/array"
	"github.com/apache/arrow-go/v18/arrow/memory"

	"github.com/krabka-io/krabka-streams-go/columnar"
)

func main() {
	mem := memory.NewGoAllocator()
	codec := columnar.NewBlobCodec(mem)
	topology := columnar.NewTopology(mem)

	source, err := topology.AddSource("source", []string{"transactions"}, codec)
	if err != nil {
		log.Fatal(err)
	}
	// Records carry Arrow IPC streams; column 1 of the payload is an int64 amount.
	large, err := topology.AddOperator("large",
		columnar.Filter(mem, func(batch arrow.Record, row int) bool {
			return batch.Column(1).(*array.Int64).Value(row) > 4
		}), source)
	if err != nil {
		log.Fatal(err)
	}
	if _, err := topology.AddSink("archive", "large-transactions", codec, large); err != nil {
		log.Fatal(err)
	}

	built, err := topology.Build()
	if err != nil {
		log.Fatal(err)
	}
	_ = built
}`
  },
  {
    id: 'java',
    lang: 'java',
    label: 'Java Streams',
    tag: 'krabka-streams-java',
    code: `import io.krabka.streams.KrabkaStreamsConfig;
import java.util.Map;
import org.apache.kafka.common.serialization.Serdes;
import org.apache.kafka.streams.KafkaStreams;
import org.apache.kafka.streams.StreamsBuilder;
import org.apache.kafka.streams.StreamsConfig;
import org.apache.kafka.streams.kstream.Consumed;
import org.apache.kafka.streams.kstream.Materialized;
import org.apache.kafka.streams.kstream.Produced;

public class OrderCounterApp {
    public static void main(String[] args) {
        StreamsBuilder builder = new StreamsBuilder();
        builder.stream("orders", Consumed.with(Serdes.String(), Serdes.String()))
            .filter((key, value) -> value.startsWith("keep"))
            .groupByKey()
            .count(Materialized.as("counts"))
            .toStream()
            .to("order-counts", Produced.with(Serdes.String(), Serdes.Long()));

        Map<String, Object> settings = Map.of(
            StreamsConfig.APPLICATION_ID_CONFIG, "order-counter",
            StreamsConfig.BOOTSTRAP_SERVERS_CONFIG, "localhost:9092");

        KafkaStreams streams = new KafkaStreams(builder.build(), KrabkaStreamsConfig.withDefaults(settings));
        streams.start();
        Runtime.getRuntime().addShutdownHook(new Thread(streams::close));
    }
}
`
  },
  {
    id: 'k8s',
    lang: 'yaml',
    label: 'Kubernetes CRD',
    tag: 'krabka-operator',
    code: `apiVersion: krabka.io/v1alpha1
kind: Kafka
metadata:
  name: production-cluster
  namespace: streaming
spec:
  kafkaVersion: "4.0.0"
  tieredStorage:
    type: S3
    s3:
      bucket: krabka-cold-storage
      region: us-west-2
---
apiVersion: krabka.io/v1alpha1
kind: KafkaNodePool
metadata:
  name: brokers
  namespace: streaming
  labels:
    krabka.io/cluster: production-cluster
spec:
  roles: [Controller, Broker]
  replicas: 3
  nodeIdStart: 0
  resources:
    requests:
      cpu: 500m
      memory: 512Mi
    limits:
      cpu: "4"
      memory: 2Gi
  storage:
    type: PersistentClaim
    size: 100Gi
    deleteClaim: false`
  }
];
---

<section class="py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-8">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Native Polyglot Developer Experience
      </h2>
      <p class="mt-3 text-lg text-gray-400">
        First-class client libraries and stream processing engines for Rust, Go, Java, and Kubernetes.
      </p>
    </div>

    <div class="frosted-card rounded-2xl overflow-hidden shadow-2xl border border-white/10">
      <!-- Tabs Header -->
      <div class="flex flex-wrap items-center justify-between border-b border-white/10 bg-slate-950/80 px-4 py-2.5">
        <div class="flex flex-wrap items-center gap-2" role="tablist" id="code-tabs" aria-label="Code examples">
          {snippets.map((s, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${s.id}`}
              aria-controls={`panel-${s.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              class="rounded-lg px-3.5 py-1.5 text-sm font-semibold transition-all text-gray-400 hover:text-white hover:bg-white/5 aria-selected:bg-krab-600 aria-selected:text-white aria-selected:shadow"
            >
              {s.label}
            </button>
          ))}
        </div>

        <div id="active-tag" class="hidden sm:inline-flex items-center text-xs font-mono text-gray-400">
          krabka-client-rs
        </div>
      </div>

      <!-- Code Panels -->
      <div class="relative bg-slate-950/95 p-4 sm:p-6 overflow-x-auto">
        {snippets.map((s, index) => (
          <div
            id={`panel-${s.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${s.id}`}
            hidden={index !== 0}
            data-tag={s.tag}
          >
            <CodeBlock code={s.code} lang={s.lang} size="sm" class="code-block-bare" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { initTabs } from '../utils/tabs';

  const tagDisplay = document.getElementById('active-tag');
  const list = document.getElementById('code-tabs');
  if (list) {
    initTabs(list, (_tab, panel) => {
      if (tagDisplay) tagDisplay.textContent = panel.getAttribute('data-tag') || '';
    });
  }
</script>
