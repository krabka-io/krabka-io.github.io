---
import { getPath } from '../utils/paths';
import { loadVerificationData } from '../utils/verification-loader';

// Counts come from the broker's verification catalog at build time; see
// src/utils/verification-loader.ts. Without a synced catalog the cards keep
// their qualitative copy and drop the count lines.
const { stats } = loadVerificationData();
const n = (value: number) => value.toLocaleString('en-US');
const compact = (value: number) =>
  value >= 1_000_000 ? `${(value / 1_000_000).toFixed(value >= 10_000_000 ? 0 : 1)}M` : n(value);

const creusotPoints = [
  {
    text: 'Pure decision functions in the ',
    code: 'krabka-verified',
    tail: ' crate. Creusot uses automated provers to establish postconditions for inputs that satisfy the preconditions.',
  },
  {
    text: 'KRaft vote admission and quorum size, ISR and leader failover, KIP-534 compaction retention, ACL precedence, quota token buckets, and idempotent-producer sequencing are proved kernels.',
  },
  {
    text: 'Host crates call the kernel. There is no second copy of any decision, so the proved body is the one that runs.',
  },
];

const staterightPoints = [
  { text: 'Models enumerate crashes, retries, failover, replay, and concurrent operations within stated bounds.' },
  { text: 'KRaft consensus, the quorum WAL, leader failover, transactions and exactly-once, group coordination, log compaction, and client failover each have a checked model.' },
  { text: 'Each runner pins its unique-state count. A search that shrinks without an explained model change fails the build.' },
];
---

<section class="py-14 bg-ocean-950/40 border-y border-white/5">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Proofs and model checks
      </h2>
      <p class="mt-3 text-base text-gray-400">
        The broker forbids unsafe Rust. <a href="https://creusot.rs/" target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Creusot</a> proves decision-kernel contracts, and <a href="https://www.stateright.rs/" target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Stateright</a> checks event sequences within each model’s bounds. CI reruns the proofs and models on pull requests.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- Creusot -->
      <div class="frosted-card rounded-2xl p-6 min-w-0 flex flex-col">
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-lg font-bold text-white">Creusot Proof Kernels</h3>
          <span class="shrink-0 rounded bg-krab-500/10 border border-krab-500/30 px-2 py-0.5 text-xs font-semibold text-krab-400">Deductive proofs</span>
        </div>
        <p class="text-xs text-gray-400 mt-1">Contracts proved on the exact executable bodies the broker calls</p>
        {stats.catalogAvailable && (
          <dl class="mt-4 grid grid-cols-3 gap-2 text-center">
            <div class="rounded-lg border border-white/10 bg-black/20 px-2 py-2 min-w-0">
              <dt class="text-[11px] uppercase tracking-wider text-gray-400">Kernels</dt>
              <dd class="text-lg font-extrabold text-white leading-tight">{n(stats.functions)}</dd>
            </div>
            <div class="rounded-lg border border-white/10 bg-black/20 px-2 py-2 min-w-0">
              <dt class="text-[11px] uppercase tracking-wider text-gray-400">Modules</dt>
              <dd class="text-lg font-extrabold text-white leading-tight">{n(stats.modules)}</dd>
            </div>
            <div class="rounded-lg border border-white/10 bg-black/20 px-2 py-2 min-w-0">
              <dt class="text-[11px] uppercase tracking-wider text-gray-400">Proof sessions</dt>
              <dd class="text-lg font-extrabold text-white leading-tight">{n(stats.proofSessions)}</dd>
            </div>
          </dl>
        )}

        <ul class="mt-4 space-y-2 text-sm text-gray-300">
          {creusotPoints.map((point) => (
            <li class="flex items-start gap-2.5 min-w-0">
              <svg class="h-4 w-4 mt-0.5 text-krab-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="[overflow-wrap:anywhere]">
                {point.text}{point.code && <code class="font-mono text-xs text-krab-300">{point.code}</code>}{point.tail}
              </span>
            </li>
          ))}
        </ul>

        <div class="mt-4 pt-3 border-t border-white/5 flex flex-wrap items-center justify-between gap-2 text-xs text-gray-400">
          <span>Proof sessions are committed beside the code and redischarged by a pinned Creusot image on each pull request.</span>
          <a href={getPath('/verification#creusot')} class="font-semibold text-krab-400 hover:text-krab-300 whitespace-nowrap">
            {stats.catalogAvailable ? `Browse all ${n(stats.rows)} ledger rows →` : 'Browse the proof ledger →'}
          </a>
        </div>
      </div>

      <!-- Stateright -->
      <div class="frosted-card rounded-2xl p-6 min-w-0 flex flex-col">
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-lg font-bold text-white">Stateright Model Checking</h3>
          <span class="shrink-0 rounded bg-krab-500/10 border border-krab-500/30 px-2 py-0.5 text-xs font-semibold text-krab-400">Exhaustive search</span>
        </div>
        <p class="text-xs text-gray-400 mt-1">Every reachable state within each model’s stated bounds</p>
        {stats.catalogAvailable && (
          <dl class="mt-4 grid grid-cols-3 gap-2 text-center">
            <div class="rounded-lg border border-white/10 bg-black/20 px-2 py-2 min-w-0">
              <dt class="text-[11px] uppercase tracking-wider text-gray-400">Models</dt>
              <dd class="text-lg font-extrabold text-white leading-tight">{n(stats.models)}</dd>
            </div>
            <div class="rounded-lg border border-white/10 bg-black/20 px-2 py-2 min-w-0">
              <dt class="text-[11px] uppercase tracking-wider text-gray-400">Pinned states</dt>
              <dd class="text-lg font-extrabold text-white leading-tight">
                <span class="sm:hidden" title={n(stats.pinnedTotal)}>{compact(stats.pinnedTotal)}</span>
                <span class="hidden sm:inline">{n(stats.pinnedTotal)}</span>
              </dd>
            </div>
            <div class="rounded-lg border border-white/10 bg-black/20 px-2 py-2 min-w-0">
              <dt class="text-[11px] uppercase tracking-wider text-gray-400">With catalog notes</dt>
              <dd class="text-lg font-extrabold text-white leading-tight">{n(stats.modelsWithNotes)}</dd>
            </div>
          </dl>
        )}

        <ul class="mt-4 space-y-2 text-sm text-gray-300">
          {staterightPoints.map((point) => (
            <li class="flex items-start gap-2.5 min-w-0">
              <svg class="h-4 w-4 mt-0.5 text-krab-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="[overflow-wrap:anywhere]">{point.text}</span>
            </li>
          ))}
        </ul>

        <div class="mt-4 pt-3 border-t border-white/5 flex flex-wrap items-center justify-between gap-2 text-xs text-gray-400">
          <span>Many models call production decision functions directly. Their results apply within the model’s stated bounds.</span>
          <a href={getPath('/verification#stateright')} class="font-semibold text-krab-400 hover:text-krab-300 whitespace-nowrap">
            {stats.catalogAvailable ? `Browse all ${n(stats.models)} models →` : 'Browse the model inventory →'}
          </a>
        </div>
      </div>
    </div>

    <div class="mt-8 text-center">
      <a
        href={getPath('/verification')}
        class="inline-block text-center text-sm font-semibold text-krab-400 hover:text-krab-300 transition-colors"
      >
        Read how krabka is verified, and where the formal boundary ends
        <svg class="ml-1.5 inline h-4 w-4 align-text-bottom" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>
