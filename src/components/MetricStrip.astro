---
import { getPath } from '../utils/paths';

const metrics = [
  {
    value: 'Zero',
    label: 'Lines of unsafe Rust',
    subtext: 'unsafe_code is a forbid-level lint under Cargo and Bazel',
    badge: 'Memory safe',
    href: getPath('/verification#memory-safety'),
  },
  {
    value: 'Proved',
    label: 'Creusot Decision Kernels',
    subtext: 'Contracts on election, ISR, retention, ACL, and quota decisions',
    badge: null,
    href: getPath('/verification#creusot'),
  },
  {
    value: 'Exhaustive',
    label: 'Stateright Model Checks',
    subtext: 'Every reachable state within each model’s stated bounds',
    badge: null,
    href: getPath('/verification#stateright'),
  },
  {
    value: 'Byte-exact',
    label: 'Kafka Wire Protocol',
    subtext: 'Apache Kafka 4.3 codecs generated from upstream schemas',
    badge: null,
    href: getPath('/versions'),
  },
];
---

<section class="py-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {metrics.map((metric) => (
        <a href={metric.href} class="frosted-card block rounded-2xl p-6 transition-all hover:translate-y-[-2px] hover:border-krab-500/40">
          <div class="flex items-baseline justify-between">
            <span class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
              {metric.value}
            </span>
            {metric.badge && (
              <span class="text-xs font-semibold text-krab-400 tracking-wide">
                {metric.badge}
              </span>
            )}
          </div>
          <h2 class="mt-3 text-base font-semibold text-gray-200">
            {metric.label}
          </h2>
          <p class="mt-1 text-sm text-gray-400">
            {metric.subtext}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
