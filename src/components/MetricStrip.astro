---
const metrics = [
  {
    value: '114 MiB',
    label: 'Baseline Memory',
    subtext: 'vs 2.5–5.5 GiB in JVM Strimzi Kafka',
    highlight: true,
  },
  {
    value: '1.2s',
    label: 'Cold Start to Ready',
    subtext: 'No JVM warmup, no heap tuning',
    highlight: false,
  },
  {
    value: 'Zero',
    label: 'GC Latency Spikes',
    subtext: 'Predictable sub-millisecond p99 latencies',
    highlight: false,
  },
  {
    value: '100%',
    label: 'Byte-Level Parity',
    subtext: 'Speaks Apache Kafka 4.3 wire protocol',
    highlight: false,
  },
];
---

<section class="py-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {metrics.map((metric) => (
        <div class="frosted-card rounded-2xl p-6 transition-all hover:translate-y-[-2px] hover:border-krab-500/40">
          <div class="flex items-baseline justify-between">
            <span class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
              {metric.value}
            </span>
            {metric.highlight && (
              <span class="rounded-full bg-krab-500/10 border border-krab-500/20 px-2 py-0.5 text-xs font-semibold text-krab-400">
                10x Savings
              </span>
            )}
          </div>
          <h2 class="mt-3 text-base font-semibold text-gray-200">
            {metric.label}
          </h2>
          <p class="mt-1 text-sm text-gray-400">
            {metric.subtext}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
