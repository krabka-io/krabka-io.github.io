---
import { getPath } from '../utils/paths';
import { loadVerificationData } from '../utils/verification-loader';

// The proof and model counts come from the broker's verification catalog,
// which sync-docs copies in before every build. A checkout that has not synced
// falls back to the qualitative labels.
const { stats } = loadVerificationData();
const n = (value: number) => value.toLocaleString('en-US');
const compact = (value: number) =>
  value >= 1_000_000 ? `${(value / 1_000_000).toFixed(value >= 10_000_000 ? 0 : 1)}M` : n(value);

const metrics = [
  {
    value: 'Zero',
    label: 'Lines of unsafe Rust',
    subtext: 'unsafe_code is a forbid-level lint under Cargo and Bazel',
    badge: 'Memory safe',
    href: getPath('/verification#memory-safety'),
  },
  {
    value: stats.catalogAvailable ? n(stats.functions) : 'Proved',
    label: 'Creusot-proved kernel functions',
    subtext: stats.catalogAvailable
      ? `${n(stats.rows)} ledger rows across ${n(stats.modules)} modules, ${n(stats.proofSessions)} proof sessions`
      : 'Contracts on election, ISR, retention, ACL, and quota decisions',
    badge: null,
    href: getPath('/verification#creusot'),
  },
  {
    value: stats.catalogAvailable ? n(stats.models) : 'Exhaustive',
    label: 'Stateright model checks',
    subtext: stats.catalogAvailable
      ? `${compact(stats.pinnedTotal)} pinned unique states, every reachable one within each model’s bounds`
      : 'Every reachable state within each model’s stated bounds',
    badge: null,
    href: getPath('/verification#stateright'),
  },
  {
    value: 'Byte-exact',
    label: 'Kafka Wire Protocol',
    subtext: 'Apache Kafka 4.3 codecs generated from upstream schemas',
    badge: null,
    href: getPath('/versions'),
  },
];
---

<section class="py-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {metrics.map((metric) => (
        <a href={metric.href} class="frosted-card block min-w-0 rounded-2xl p-6 transition-all hover:translate-y-[-2px] hover:border-krab-500/40">
          <div class="flex items-baseline justify-between gap-3">
            <span class="text-3xl sm:text-4xl lg:text-3xl xl:text-4xl font-extrabold tracking-tight text-white whitespace-nowrap">
              {metric.value}
            </span>
            {metric.badge && (
              <span class="text-xs font-semibold text-krab-400 tracking-wide">
                {metric.badge}
              </span>
            )}
          </div>
          <h2 class="mt-3 text-base font-semibold text-gray-200">
            {metric.label}
          </h2>
          <p class="mt-1 text-sm text-gray-400 [overflow-wrap:anywhere]">
            {metric.subtext}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
