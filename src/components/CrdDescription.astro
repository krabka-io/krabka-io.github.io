---
interface Props {
  text: string;
}

type Block =
  | { kind: 'paragraph'; text: string }
  | { kind: 'list'; items: string[] }
  | { kind: 'code'; text: string };

const { text } = Astro.props;
const blocks: Block[] = [];

for (const [index, part] of text.replace(/\r\n?/g, '\n').split(/```([\s\S]*?)```/).entries()) {
  if (index % 2) {
    blocks.push({ kind: 'code', text: part.trim() });
    continue;
  }

  let current: Block | undefined;
  for (const line of part.split('\n')) {
    const bullet = /^\s*[-*]\s+(.+)$/.exec(line);
    if (!line.trim()) {
      current = undefined;
    } else if (bullet) {
      if (current?.kind !== 'list') {
        current = { kind: 'list', items: [] };
        blocks.push(current);
      }
      current.items.push(bullet[1]);
    } else if (current?.kind === 'list' && /^\s+/.test(line)) {
      current.items[current.items.length - 1] += ` ${line.trim()}`;
    } else {
      if (current?.kind !== 'paragraph') {
        current = { kind: 'paragraph', text: '' };
        blocks.push(current);
      }
      current.text += `${current.text ? ' ' : ''}${line.trim()}`;
    }
  }
}

const inline = (value: string) => value.split(/`([^`]+)`/g);
---

<div class="crd-description">
  {blocks.map((block) => block.kind === 'code' ? (
    <pre><code>{block.text}</code></pre>
  ) : block.kind === 'list' ? (
    <ul>
      {block.items.map((item) => <li>{inline(item).map((segment, index) => index % 2 ? <code>{segment}</code> : segment)}</li>)}
    </ul>
  ) : (
    <p>{inline(block.text).map((segment, index) => index % 2 ? <code>{segment}</code> : segment)}</p>
  ))}
</div>

<style>
  .crd-description {
    max-width: 75ch;
    min-width: 0;
    font-size: .85rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  p, ul, pre {
    margin: 0 0 .65rem;
  }

  .crd-description > :last-child {
    margin-bottom: 0;
  }

  ul {
    padding-left: 1.35rem;
  }

  li + li {
    margin-top: .3rem;
  }

  code {
    font-size: .85em;
    overflow-wrap: anywhere;
  }

  pre {
    max-width: 100%;
    padding: .75rem;
    border: 1px solid rgba(255, 255, 255, .08);
    border-radius: .4rem;
    background: rgba(255, 255, 255, .03);
    overflow-x: auto;
  }

  pre code {
    white-space: pre-wrap;
  }
</style>
