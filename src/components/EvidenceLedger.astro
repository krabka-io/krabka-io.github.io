---
// Dense, filterable ledger of the verification evidence: Creusot proof rows,
// Stateright models, and any other evidence a page wants beside them. Each
// row is a native <details> so the page works without JavaScript; the script
// adds the tab bar, the filter toolbar and deep-link handling on top.
//
// The component renders what it is given. Pages load the rows with
// `loadVerificationData()` and pass them in; nothing here touches the
// filesystem. Styles live in ../styles/evidence.css and are scoped under
// `.el`; the palette follows kernels.css so the two explorers look alike.
import '../styles/evidence.css';
import type { KernelRow, ModelRow } from '../utils/verification-data';
import { kernelRowAnchor, modelRowAnchor } from '../utils/verification-data';

export interface EvidenceItem {
  id: string;
  title: string;
  /** Short badge on the row, e.g. "Mutation testing". */
  kind: string;
  /** Group heading and filter chip; defaults to `kind`. */
  area?: string;
  claim: string;
  body_html: string;
  links?: { label: string; url: string }[];
}

interface Props {
  kernels?: KernelRow[];
  models?: ModelRow[];
  evidence?: EvidenceItem[];
  kernelNotes?: string[];
  modelNotes?: string[];
  initialTab?: 'kernels' | 'models' | 'evidence';
  playgroundPath?: string;
  catalogPath?: string;
  /** When set, each proof-session chip in a kernel row gets an "explore" chip linking to `${explorerPath}#session=<id>`. */
  explorerPath?: string;
  id?: string;
}

const { kernels, models, evidence, kernelNotes = [], modelNotes = [], initialTab, playgroundPath, catalogPath, explorerPath, id = 'evidence-ledger' } = Astro.props;

/** Session id of a proof URL, `.../verif/krabka_verified_rlib/<id>/proof.json`, or undefined. */
function proofSessionId(url: string): string | undefined {
  const m = /verif\/krabka_verified_rlib\/(.+)\/proof\.json(?:[#?].*)?$/.exec(url);
  return m?.[1];
}

function explorerLink(url: string): string | undefined {
  if (!explorerPath) return undefined;
  const sessionId = proofSessionId(url);
  return sessionId === undefined ? undefined : `${explorerPath}#session=${encodeURIComponent(sessionId)}`;
}

type GroupKey = 'kernels' | 'models' | 'evidence';

interface Area {
  name: string;
  count: number;
}

interface Group {
  key: GroupKey;
  /** Fixed panel id; other pages link to `#creusot` and `#stateright`. */
  panelId: string;
  label: string;
  count: number;
  placeholder: string;
  notes: string[];
  notesTitle: string;
  areas: Area[];
}

/** Areas in the order the rows arrive, each with its row count. */
function areasOf(rows: { area: string }[]): Area[] {
  const areas: Area[] = [];
  for (const row of rows) {
    const found = areas.find((a) => a.name === row.area);
    if (found) found.count += 1;
    else areas.push({ name: row.area, count: 1 });
  }
  return areas;
}

/** Plain text of trusted inline HTML, for the evidence rows' search index. */
function textOf(html: string): string {
  return html
    .replace(/<[^>]*>/g, ' ')
    .replace(/&[a-z#0-9]+;/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

/** Thousands separators: 46672 -> "46,672". */
function formatCount(n: number): string {
  return n.toLocaleString('en-US');
}

/** Collapsed-row form: 4573249 -> "4.57M", below a million with separators. */
function compactCount(n: number): string {
  if (n < 1_000_000) return formatCount(n);
  const millions = (n / 1_000_000).toFixed(2).replace(/\.?0+$/, '');
  return `${millions}M`;
}

function plural(n: number, one: string, many: string): string {
  return `${formatCount(n)} ${n === 1 ? one : many}`;
}

// Where a long Rust path may wrap: after `_` and `::`. Rendered as <wbr>, not a
// zero-width space, so a copied name carries no invisible character.
function breakParts(name: string): string[] {
  return name.split(/(?<=_|::)/);
}

function fileStem(path: string): string {
  const base = path.split('/').pop() ?? path;
  return base.replace(/\.rs$/, '');
}

const evidenceRows = (evidence ?? []).map((item) => ({
  ...item,
  area: item.area ?? item.kind,
  search: [item.title, item.kind, item.claim, textOf(item.body_html), ...(item.links ?? []).map((l) => l.label)].join(' ').toLowerCase(),
}));

const groups: Group[] = [];
if (kernels !== undefined) {
  groups.push({
    key: 'kernels',
    panelId: 'creusot',
    label: 'Creusot kernels',
    count: kernels.length,
    placeholder: 'Filter by kernel, module, host, precondition…',
    notes: kernelNotes,
    notesTitle: 'What the ledger claims',
    areas: areasOf(kernels),
  });
}
if (models !== undefined) {
  groups.push({
    key: 'models',
    panelId: 'stateright',
    label: 'Stateright models',
    count: models.length,
    placeholder: 'Filter by model, property, driven function, bounds…',
    notes: modelNotes,
    notesTitle: 'What a model check claims',
    areas: areasOf(models),
  });
}
if (evidence !== undefined) {
  groups.push({
    key: 'evidence',
    panelId: 'evidence',
    label: 'Other evidence',
    count: evidenceRows.length,
    placeholder: 'Filter by title, kind, claim…',
    notes: [],
    notesTitle: '',
    areas: areasOf(evidenceRows),
  });
}

const tabbed = groups.length > 1;
const tabId = (panelId: string) => `${id}-tab-${panelId}`;
const initialPanel = groups.find((g) => g.key === initialTab)?.panelId ?? groups[0]?.panelId ?? '';
const kernelCatalog = catalogPath ? `${catalogPath}#creusot-proof-ledger` : undefined;
const modelCatalog = catalogPath ? `${catalogPath}#stateright-model-check-tier` : undefined;
---

<section id={id} class="el" data-initial={initialPanel}>
  {tabbed && (
    <div class="el-tabs" role="tablist" aria-label="Evidence tiers">
      {groups.map((g) => (
        <button
          type="button"
          class="el-tab"
          role="tab"
          id={tabId(g.panelId)}
          aria-controls={g.panelId}
          aria-selected={g.panelId === initialPanel ? 'true' : 'false'}
          tabindex={g.panelId === initialPanel ? 0 : -1}
        >
          {g.label}{' '}
          <span class="el-tab-count">{formatCount(g.count)}</span>
        </button>
      ))}
    </div>
  )}

  {groups.length === 0 && <p class="el-none">No evidence rows were passed to this ledger.</p>}

  <div class="el-panels">
    {groups.map((g) => (
      <section
        class="el-panel"
        id={g.panelId}
        data-group={g.key}
        role={tabbed ? 'tabpanel' : undefined}
        aria-labelledby={tabbed ? tabId(g.panelId) : undefined}
      >
        <h3 class="el-panel-title">
          {g.label}{' '}
          <span class="el-panel-count">{formatCount(g.count)}</span>
        </h3>

        {g.notes.length > 0 && (
          <details class="el-notes">
            <summary>
              <svg class="el-chevron el-chevron-inline" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {g.notesTitle}{' '}
              <span class="el-notes-hint">from the broker catalog</span>
            </summary>
            <div class="el-prose">
              {g.notes.map((html) => <Fragment set:html={html} />)}
            </div>
          </details>
        )}

        {g.count > 0 && (
          <div class="el-toolbar">
            <label class="el-search">
              <span class="el-visually-hidden">Filter {g.label.toLowerCase()}</span>
              <input type="search" class="el-filter" placeholder={g.placeholder} autocomplete="off" spellcheck="false" />
            </label>
            <div class="el-tools">
              <span class="el-count" role="status" aria-live="polite">Showing <b class="el-count-n">{formatCount(g.count)}</b> of {formatCount(g.count)}</span>
              <button type="button" class="el-btn" data-action="expand">Expand all</button>
              <button type="button" class="el-btn" data-action="collapse">Collapse all</button>
            </div>
            {g.areas.length > 1 && (
              <div class="el-chips" role="group" aria-label="Filter by area">
                <button type="button" class="el-chip el-chip-all" aria-pressed="true">All</button>
                {g.areas.map((area) => (
                  <button type="button" class="el-chip" data-area={area.name} aria-pressed="false">
                    {area.name}{' '}
                    <span class="el-chip-n">{formatCount(area.count)}</span>
                  </button>
                ))}
              </div>
            )}
          </div>
        )}

        {g.count === 0 && <p class="el-none">No rows.</p>}
        <p class="el-empty" hidden>No rows match the current filter.</p>

        {g.key === 'kernels' &&
          g.areas.map((area) => (
            <section class="el-group" data-area={area.name}>
              {g.areas.length > 1 && (
                <h4 class="el-group-title">
                  {area.name}{' '}
                  <span class="el-group-count">{formatCount(area.count)}</span>
                </h4>
              )}
              {(kernels ?? [])
                .filter((row) => row.area === area.name)
                .map((row) => {
                  const anchor = kernelRowAnchor(row.id);
                  return (
                    <details class="el-row el-row-kernel" id={anchor} data-area={row.area} data-search={row.search}>
                      <summary class="el-summary">
                        <span class="el-names">
                          {row.kernels.map((k) => <code class="el-fn">{k.label}</code>)}
                          {row.files.map((f) => <span class="el-module">{f}</span>)}
                        </span>
                        <span class="el-meta">
                          <span class="el-meta-item">{plural(row.proofs.length, 'proof', 'proofs')}</span>{' '}
                          {row.playground && <span class="el-meta-item el-meta-play">Runs in browser</span>}
                        </span>
                        <span class="el-claim">{row.claim}</span>
                        <svg class="el-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </summary>
                      <div class="el-body">
                        <dl class="el-grid">
                          <dt>Proves</dt>
                          <dd class="el-html" set:html={row.contract_html} />
                          <dt>Host caller</dt>
                          <dd class="el-html" set:html={row.host_html} />
                          <dt>Proof sessions</dt>
                          <dd class="el-links">
                            {row.proofs.map((p) => {
                              const explore = explorerLink(p.url);
                              return (
                                <>
                                  <a class="el-link-chip" href={p.url} target="_blank" rel="noopener noreferrer">{p.label}<span class="el-ext" aria-hidden="true">↗</span></a>
                                  {explore && <a class="el-link-chip" href={explore} title={`Open ${p.label} in the proof explorer`}>explore</a>}
                                </>
                              );
                            })}
                          </dd>
                          <dt>Caller preconditions</dt>
                          {row.preconditions_html === '' ? (
                            <dd><em class="el-none-text">Accepts every value of the Rust input types.</em></dd>
                          ) : (
                            <dd class="el-html" set:html={row.preconditions_html} />
                          )}
                        </dl>
                        <div class="el-foot">
                          {row.kernels[0] && <a href={row.kernels[0].url} target="_blank" rel="noopener noreferrer">Source<span class="el-ext" aria-hidden="true">↗</span></a>}
                          {row.playground && playgroundPath && <a class="el-foot-primary" href={`${playgroundPath}#kernel=${row.playground.id}`}>Try in the playground</a>}
                          <a href={`#${anchor}`} class="el-permalink">Permalink</a>
                          {kernelCatalog && <a href={kernelCatalog}>Full catalog</a>}
                        </div>
                      </div>
                    </details>
                  );
                })}
            </section>
          ))}

        {g.key === 'models' &&
          g.areas.map((area) => (
            <section class="el-group" data-area={area.name}>
              {g.areas.length > 1 && (
                <h4 class="el-group-title">
                  {area.name}{' '}
                  <span class="el-group-count">{formatCount(area.count)}</span>
                </h4>
              )}
              {(models ?? [])
                .filter((model) => model.area === area.name)
                .map((model) => {
                  const anchor = modelRowAnchor(model.id);
                  return (
                    <details class="el-row el-row-model" id={anchor} data-area={model.area} data-search={model.search}>
                      <summary class="el-summary">
                        <span class="el-names">
                          <strong class="el-name">{model.name}</strong>
                          <span class="el-badge el-badge-repo">{model.repo}</span>
                          <span class="el-module">{fileStem(model.path)}.rs</span>
                        </span>
                        <span class="el-meta">
                          {model.pinnedTotal > 0 && <span class="el-meta-item">{compactCount(model.pinnedTotal)} states</span>}{' '}
                          {model.properties.length > 0 && <span class="el-meta-item">{plural(model.properties.length, 'property', 'properties')}</span>}
                        </span>
                        <span class="el-claim">{model.summary}</span>
                        <svg class="el-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </summary>
                      <div class="el-body">
                        <dl class="el-grid">
                          <dt>Summary</dt>
                          <dd>{model.summary}</dd>
                          {model.drives.length > 0 && (
                            <>
                              <dt>Drives</dt>
                              <dd class="el-taglist">{model.drives.map((d) => <code class="el-tag">{breakParts(d).map((part, i) => <>{i > 0 && <wbr />}{part}</>)}</code>)}</dd>
                            </>
                          )}
                          {model.bounds && (
                            <>
                              <dt>Bounds</dt>
                              <dd>{model.bounds}</dd>
                            </>
                          )}
                          {model.properties.length > 0 && (
                            <>
                              <dt>Properties</dt>
                              <dd class="el-taglist">{model.properties.map((p) => <code class="el-tag el-tag-prop">{breakParts(p).map((part, i) => <>{i > 0 && <wbr />}{part}</>)}</code>)}</dd>
                            </>
                          )}
                          {model.pinned_states.length > 0 && (
                            <>
                              <dt>Pinned unique states</dt>
                              <dd>
                                <table class="el-table">
                                  <thead>
                                    <tr><th scope="col">Config</th><th scope="col" class="el-num">Unique states</th></tr>
                                  </thead>
                                  <tbody>
                                    {model.pinned_states.map((p) => (
                                      <tr><td><code>{p.config}</code></td><td class="el-num">{formatCount(p.count)}</td></tr>
                                    ))}
                                    {model.pinned_states.length > 1 && (
                                      <tr class="el-total"><td>Total</td><td class="el-num">{formatCount(model.pinnedTotal)}</td></tr>
                                    )}
                                  </tbody>
                                </table>
                              </dd>
                            </>
                          )}
                          {model.outside && (
                            <>
                              <dt>Outside the model</dt>
                              <dd>{model.outside}</dd>
                            </>
                          )}
                        </dl>
                        {model.note && (
                          <details class="el-more">
                            <summary>
                              <svg class="el-chevron el-chevron-inline" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                              What the catalog says
                            </summary>
                            <div class="el-more-body">
                              <p class="el-hint">The broker catalog's own description of this model, reproduced from its verification document.</p>
                              {model.note.paragraphs_html.map((html) => <p class="el-html" set:html={html} />)}
                            </div>
                          </details>
                        )}
                        <div class="el-foot">
                          <a href={model.source_url} target="_blank" rel="noopener noreferrer">Model source<span class="el-ext" aria-hidden="true">↗</span></a>
                          <a href={`#${anchor}`} class="el-permalink">Permalink</a>
                          {modelCatalog && <a href={modelCatalog}>Full catalog</a>}
                        </div>
                      </div>
                    </details>
                  );
                })}
            </section>
          ))}

        {g.key === 'evidence' &&
          g.areas.map((area) => (
            <section class="el-group" data-area={area.name}>
              {g.areas.length > 1 && (
                <h4 class="el-group-title">
                  {area.name}{' '}
                  <span class="el-group-count">{formatCount(area.count)}</span>
                </h4>
              )}
              {evidenceRows
                .filter((item) => item.area === area.name)
                .map((item) => {
                  const anchor = `evidence-${item.id}`;
                  const links = item.links ?? [];
                  return (
                    <details class="el-row el-row-evidence" id={anchor} data-area={item.area} data-search={item.search}>
                      <summary class="el-summary">
                        <span class="el-names">
                          <span class="el-badge el-badge-kind">{item.kind}</span>
                          <strong class="el-name">{item.title}</strong>
                        </span>
                        <span class="el-meta">
                          {links.length > 0 && <span class="el-meta-item">{plural(links.length, 'link', 'links')}</span>}
                        </span>
                        <span class="el-claim">{item.claim}</span>
                        <svg class="el-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </summary>
                      <div class="el-body">
                        <p class="el-lead">{item.claim}</p>
                        <div class="el-html el-html-block" set:html={item.body_html} />
                        {links.length > 0 && (
                          <div class="el-links">
                            {links.map((l) => (
                              <a class="el-link-chip" href={l.url} target={/^https?:\/\//i.test(l.url) ? '_blank' : undefined} rel={/^https?:\/\//i.test(l.url) ? 'noopener noreferrer' : undefined}>{l.label}</a>
                            ))}
                          </div>
                        )}
                        <div class="el-foot">
                          <a href={`#${anchor}`} class="el-permalink">Permalink</a>
                        </div>
                      </div>
                    </details>
                  );
                })}
            </section>
          ))}
      </section>
    ))}
  </div>
</section>

<script>
  // Progressive layer over the static markup: tabs, filtering, expand and
  // collapse, and deep links. Every `.el` on the page is initialised, and a
  // root is upgraded only once.
  const FLASH_MS = 1800;

  const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setupPanel(panel: HTMLElement) {
    const rows = Array.from(panel.querySelectorAll<HTMLDetailsElement>('.el-row'));
    const groups = Array.from(panel.querySelectorAll<HTMLElement>('.el-group'));
    const groupRows = new Map<HTMLElement, HTMLDetailsElement[]>(groups.map((g) => [g, Array.from(g.querySelectorAll<HTMLDetailsElement>('.el-row'))]));
    const input = panel.querySelector<HTMLInputElement>('.el-filter');
    const chips = Array.from(panel.querySelectorAll<HTMLButtonElement>('.el-chip[data-area]'));
    const allChip = panel.querySelector<HTMLButtonElement>('.el-chip-all');
    const countOut = panel.querySelector<HTMLElement>('.el-count-n');
    const empty = panel.querySelector<HTMLElement>('.el-empty');
    const selected = new Set<string>();
    let query = '';

    function apply() {
      const tokens = query.toLowerCase().split(/\s+/).filter((t) => t !== '');
      let visible = 0;
      for (const row of rows) {
        const haystack = row.getAttribute('data-search') ?? '';
        const area = row.getAttribute('data-area') ?? '';
        const show = (selected.size === 0 || selected.has(area)) && tokens.every((t) => haystack.includes(t));
        row.hidden = !show;
        if (show) visible += 1;
      }
      for (const [group, members] of groupRows) {
        const shown = members.filter((r) => !r.hidden).length;
        group.hidden = shown === 0;
        const label = group.querySelector('.el-group-count');
        if (label) label.textContent = shown === members.length ? String(members.length) : `${shown} of ${members.length}`;
      }
      if (countOut) countOut.textContent = visible.toLocaleString('en-US');
      if (empty) empty.hidden = visible !== 0 || rows.length === 0;
      for (const chip of chips) chip.setAttribute('aria-pressed', String(selected.has(chip.dataset.area ?? '')));
      if (allChip) allChip.setAttribute('aria-pressed', String(selected.size === 0));
    }

    function reset() {
      query = '';
      if (input) input.value = '';
      selected.clear();
      apply();
    }

    if (input) {
      input.addEventListener('input', () => {
        query = input.value;
        apply();
      });
    }
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const area = chip.dataset.area ?? '';
        if (selected.has(area)) selected.delete(area);
        else selected.add(area);
        apply();
      });
    }
    if (allChip) {
      allChip.addEventListener('click', () => {
        selected.clear();
        apply();
      });
    }
    for (const button of panel.querySelectorAll<HTMLButtonElement>('.el-btn[data-action]')) {
      button.addEventListener('click', () => {
        const open = button.dataset.action === 'expand';
        for (const row of rows) {
          if (open) {
            if (!row.hidden) row.open = true;
          } else {
            row.open = false;
            for (const nested of row.querySelectorAll<HTMLDetailsElement>('details')) nested.open = false;
          }
        }
      });
    }

    return { reset };
  }

  function initLedger(root: HTMLElement) {
    if (root.classList.contains('el-ready')) return;
    const panels = Array.from(root.querySelectorAll<HTMLElement>(':scope > .el-panels > .el-panel'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(':scope > .el-tabs > [role="tab"]'));
    const controllers = new Map(panels.map((panel) => [panel, setupPanel(panel)]));

    function activate(panelId: string, updateHash: boolean) {
      if (!panels.some((p) => p.id === panelId)) return;
      for (const panel of panels) panel.hidden = panel.id !== panelId;
      for (const tab of tabs) {
        const selected = tab.getAttribute('aria-controls') === panelId;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      }
      if (updateHash) history.replaceState(null, '', `#${panelId}`);
    }

    for (const tab of tabs) {
      const target = tab.getAttribute('aria-controls') ?? '';
      tab.addEventListener('click', () => activate(target, true));
      tab.addEventListener('keydown', (event) => {
        const i = tabs.indexOf(tab);
        let next = -1;
        if (event.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        if (next === -1) return;
        event.preventDefault();
        tabs[next].focus();
        activate(tabs[next].getAttribute('aria-controls') ?? '', true);
      });
    }

    function revealRow(row: HTMLDetailsElement, target: Element, instant: boolean) {
      const panel = row.closest<HTMLElement>('.el-panel');
      if (panel) {
        activate(panel.id, false);
        if (row.hidden) controllers.get(panel)?.reset();
      }
      row.open = true;
      // A hash that names something inside a nested drilldown opens that too.
      let nested = target === row ? null : target.closest('details');
      while (nested && nested !== row && row.contains(nested)) {
        nested.open = true;
        nested = nested.parentElement?.closest('details') ?? null;
      }
      requestAnimationFrame(() => {
        row.scrollIntoView({ block: 'start', behavior: instant || prefersReducedMotion() ? 'instant' : 'auto' });
        row.classList.remove('el-flash');
        void row.offsetWidth;
        row.classList.add('el-flash');
        window.setTimeout(() => row.classList.remove('el-flash'), FLASH_MS);
      });
    }

    // On first load the jump is instant, like the browser's own fragment
    // navigation; a later hash change follows the page's scroll-behavior.
    function applyHash(instant: boolean): boolean {
      const raw = location.hash.slice(1);
      if (raw === '') return false;
      let hash: string;
      try {
        hash = decodeURIComponent(raw);
      } catch {
        hash = raw;
      }
      if (panels.some((p) => p.id === hash)) {
        activate(hash, false);
        return true;
      }
      const target = root.querySelector(`#${CSS.escape(hash)}`);
      const row = target?.closest<HTMLDetailsElement>('.el-row');
      if (!target || !row) return false;
      revealRow(row, target, instant);
      return true;
    }

    root.classList.add('el-ready');
    if (!applyHash(true)) {
      const initial = root.getAttribute('data-initial') ?? '';
      activate(panels.some((p) => p.id === initial) ? initial : panels[0]?.id ?? '', false);
    }
    window.addEventListener('hashchange', () => {
      applyHash(false);
    });
  }

  for (const root of document.querySelectorAll<HTMLElement>('.el')) initLedger(root);
</script>
