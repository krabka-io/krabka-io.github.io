---
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;

const featureSubLinks = [
  { name: 'All Features Overview', href: '/features' },
  { name: 'Native KRaft Consensus', href: '/features/kraft' },
  { name: 'Tiered Storage Engine', href: '/features/tiered-storage' },
  { name: 'Postgres CDC & Connect', href: '/features/connect' },
  { name: 'Polyglot Streams & Arrow', href: '/features/streams' },
  { name: 'Kubernetes Operator', href: '/features/operator' },
  { name: 'Full-Signal Observability', href: '/features/observability' },
];

const navLinks = [
  { name: 'Get Started', href: '/get-started' },
  { name: 'Features', href: '/features', hasDropdown: true },
  { name: 'Versions', href: '/versions' },
  { name: 'Benchmarks', href: '/benchmarks' },
  { name: 'Docs', href: '/docs' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-ocean-950/95 backdrop-blur-md transition-colors">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-90">
        <Logo className="w-8 h-8" />
        <span class="text-xl font-bold tracking-tight text-white">Krabka</span>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => {
          if (link.hasDropdown) {
            const isFeaturesActive = currentPath.startsWith('/features');
            return (
              <div class="relative group">
                <a
                  href="/features"
                  class={`inline-flex items-center gap-1 px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
                    isFeaturesActive
                      ? 'text-krab-500 bg-white/5'
                      : 'text-gray-300 hover:text-white hover:bg-white/5'
                  }`}
                >
                  <span>Features</span>
                  <svg class="h-3.5 w-3.5 opacity-70 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>

                <!-- Solid Dropdown Menu -->
                <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 w-64">
                  <div class="rounded-xl p-1.5 shadow-2xl border border-slate-700 bg-slate-900 divide-y divide-slate-800">
                    <div class="pb-1">
                      <a
                        href="/features"
                        class="flex items-center justify-between rounded-lg px-3 py-2 text-xs font-bold text-krab-400 hover:bg-slate-800 transition-colors"
                      >
                        <span>All Features Overview</span>
                        <span>&rarr;</span>
                      </a>
                    </div>
                    <div class="pt-1 space-y-0.5">
                      {featureSubLinks.slice(1).map((sub) => (
                        <a
                          href={sub.href}
                          class="block rounded-lg px-3 py-2 text-xs font-semibold text-gray-200 hover:bg-slate-800 hover:text-krab-400 transition-colors"
                        >
                          {sub.name}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            );
          }

          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
                isActive
                  ? 'text-krab-500 bg-white/5'
                  : 'text-gray-300 hover:text-white hover:bg-white/5'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="https://github.com/krabka-io"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg border border-white/15 bg-white/5 px-3.5 py-1.5 text-sm font-medium text-gray-200 transition-all hover:border-white/30 hover:bg-white/10 hover:text-white"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
        <span class="rounded bg-white/10 px-1.5 py-0.5 text-xs text-krab-400 font-semibold">krabka-io</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-button"
        aria-label="Toggle Menu"
        class="inline-flex md:hidden items-center justify-center rounded-lg p-2 text-gray-400 hover:bg-white/5 hover:text-white"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-slate-900 px-4 pt-2 pb-4 space-y-1">
    <a
      href="/get-started"
      class="block rounded-lg px-3 py-2 text-base font-medium text-gray-300 hover:bg-white/5 hover:text-white"
    >
      Get Started
    </a>
    <div class="py-1">
      <span class="block px-3 text-xs font-bold uppercase tracking-wider text-krab-400">Features</span>
      <div class="mt-1 pl-2 space-y-1">
        {featureSubLinks.map((sub) => (
          <a
            href={sub.href}
            class="block rounded-lg px-3 py-1.5 text-sm text-gray-300 hover:bg-white/5 hover:text-white"
          >
            {sub.name}
          </a>
        ))}
      </div>
    </div>
    <a
      href="/versions"
      class="block rounded-lg px-3 py-2 text-base font-medium text-gray-300 hover:bg-white/5 hover:text-white"
    >
      Versions
    </a>
    <a
      href="/benchmarks"
      class="block rounded-lg px-3 py-2 text-base font-medium text-gray-300 hover:bg-white/5 hover:text-white"
    >
      Benchmarks
    </a>
    <a
      href="/docs"
      class="block rounded-lg px-3 py-2 text-base font-medium text-gray-300 hover:bg-white/5 hover:text-white"
    >
      Docs
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
