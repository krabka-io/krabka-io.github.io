---
import Logo from './Logo.astro';
import { getPath } from '../utils/paths';

const currentPath = Astro.url.pathname;

const featureSubLinks = [
  { name: 'All Features Overview', href: getPath('/features') },
  { name: 'Native KRaft Consensus', href: getPath('/features/kraft') },
  { name: 'Tiered Storage Engine', href: getPath('/features/tiered-storage') },
  { name: 'Postgres CDC & Connect', href: getPath('/features/connect') },
  { name: 'Polyglot Streams & Arrow', href: getPath('/features/streams') },
  { name: 'Kubernetes Operator', href: getPath('/features/operator') },
];

const navLinks = [
  { name: 'Get Started', href: getPath('/get-started') },
  { name: 'Features', href: getPath('/features'), hasDropdown: true },
  { name: 'Versions', href: getPath('/versions') },
  { name: 'Verification', href: getPath('/verification') },
  { name: 'Benchmarks', href: getPath('/benchmarks') },
  { name: 'News', href: getPath('/news') },
  { name: 'Docs', href: getPath('/docs') },
  { name: 'API', href: getPath('/api') },
];

// aria-current follows the highlight: a section link stays lit, and current, on its
// sub-pages; a dropdown sub-link only on its own page.
const isCurrent = (href: string) =>
  currentPath === href || (href !== getPath('/') && currentPath.startsWith(href));
const current = (href: string) => (isCurrent(href) ? 'page' : undefined);
const exactly = (href: string) => (currentPath.replace(/\/$/, '') === href ? 'page' : undefined);
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-ocean-950/95 backdrop-blur-md transition-colors">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <div class="flex min-w-0 items-center gap-4 xl:gap-8">
      <a href={getPath('/')} class="flex min-w-0 items-center gap-3 lg:shrink-0 transition-opacity hover:opacity-90">
        <Logo className="w-8 h-8 shrink-0" />
        <span class="truncate text-xl font-bold tracking-tight text-white">krabka</span>
      </a>

      <nav aria-label="Main" class="hidden lg:flex items-center gap-0.5 xl:gap-1">
        {navLinks.map((link) => {
          if (link.hasDropdown) {
            const isFeaturesActive = currentPath.includes('/features');
            return (
              <div class="relative group" data-features-menu>
                <a
                  href={getPath('/features')}
                  aria-current={isFeaturesActive ? 'page' : undefined}
                  class={`inline-flex items-center gap-1 px-2.5 xl:px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
                    isFeaturesActive
                      ? 'text-krab-500 bg-white/5'
                      : 'text-gray-300 hover:text-white hover:bg-white/5'
                  }`}
                >
                  <span>Features</span>
                  <svg class="h-3.5 w-3.5 opacity-70 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>

                <!-- Solid Dropdown Menu. Opens on hover or keyboard focus; Escape sets
                     data-dismissed on the group to close it until the pointer or focus leaves. -->
                <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible group-data-[dismissed]:opacity-0 group-data-[dismissed]:invisible transition-all duration-150 w-64">
                  <div class="rounded-xl p-1.5 shadow-2xl border border-slate-700 bg-slate-900 divide-y divide-slate-800">
                    <div class="pb-1">
                      <a
                        href={getPath('/features')}
                        aria-current={exactly(getPath('/features'))}
                        class="flex items-center justify-between rounded-lg px-3 py-2 text-xs font-bold text-krab-400 hover:bg-slate-800 transition-colors"
                      >
                        <span>All Features Overview</span>
                      </a>
                    </div>
                    <div class="pt-1 space-y-0.5">
                      {featureSubLinks.slice(1).map((sub) => (
                        <a
                          href={sub.href}
                          aria-current={exactly(sub.href)}
                          class="block rounded-lg px-3 py-2 text-xs font-semibold text-gray-200 hover:bg-slate-800 hover:text-krab-400 transition-colors"
                        >
                          {sub.name}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            );
          }

          const isActive = isCurrent(link.href);
          return (
            <a
              href={link.href}
              aria-current={current(link.href)}
              class={`px-2.5 xl:px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
                isActive
                  ? 'text-krab-500 bg-white/5'
                  : 'text-gray-300 hover:text-white hover:bg-white/5'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <a
        href={getPath('/search')}
        aria-label="Search"
        aria-current={current(getPath('/search'))}
        class="inline-flex items-center justify-center rounded-lg p-2 text-gray-300 transition-colors hover:bg-white/5 hover:text-white"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 110-15 7.5 7.5 0 010 15z" />
        </svg>
      </a>
      <button
        type="button"
        id="theme-toggle"
        aria-label="Switch to light theme"
        class="inline-flex items-center justify-center rounded-lg p-2 text-gray-300 transition-colors hover:bg-white/5 hover:text-white"
      >
        <!-- Sun in the dark theme, moon in the light one. -->
        <svg class="theme-icon-sun h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="theme-icon-moon h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
      <!-- Below 30rem (in rem, so a larger browser font gets it sooner) the link is the icon alone. -->
      <a
        href="https://github.com/krabka-io"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="krabka-io on GitHub"
        class="inline-flex items-center gap-2 rounded-lg border border-white/15 bg-white/5 px-3.5 py-1.5 max-[30rem]:p-2.5 lg:max-xl:p-2.5 text-sm font-medium text-gray-200 transition-all hover:border-white/30 hover:bg-white/10 hover:text-white"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span class="max-[30rem]:hidden lg:max-xl:hidden">GitHub</span>
        <span class="hidden xl:inline whitespace-nowrap rounded bg-white/10 px-1.5 py-0.5 text-xs text-krab-400 font-semibold">krabka-io</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-button"
        aria-label="Toggle Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex lg:hidden items-center justify-center rounded-lg p-2 text-gray-400 hover:bg-white/5 hover:text-white"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <!-- On a short screen (a phone on its side) the menu scrolls inside the space under
       the 4rem header instead of running off the bottom of the sticky bar. -->
  <nav id="mobile-menu" aria-label="Main" class="hidden lg:hidden max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-white/10 bg-slate-900 px-4 pt-2 pb-4 space-y-1">
    {navLinks.map((link) =>
      link.hasDropdown ? (
        <div class="py-1">
          <span class="block px-3 text-xs font-bold uppercase tracking-wider text-krab-400">Features</span>
          <div class="mt-1 pl-2 space-y-1">
            {featureSubLinks.map((sub) => (
              <a
                href={sub.href}
                aria-current={exactly(sub.href)}
                class="block rounded-lg px-3 py-2 text-sm text-gray-300 hover:bg-white/5 hover:text-white"
              >
                {sub.name}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={link.href}
          aria-current={current(link.href)}
          class="block rounded-lg px-3 py-2 text-base font-medium text-gray-300 hover:bg-white/5 hover:text-white"
        >
          {link.name}
        </a>
      ),
    )}
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const group = document.querySelector<HTMLElement>('[data-features-menu]');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
  };
  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));

  // Theme: the head script in BaseLayout applies the saved choice before paint.
  const themeBtn = document.getElementById('theme-toggle');
  const label = () => {
    const light = document.documentElement.dataset.theme === 'light';
    themeBtn?.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
  };
  label();
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch { /* storage blocked: the choice lasts this page */ }
    label();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menu && !menu.classList.contains('hidden')) {
      setOpen(false);
      btn?.focus();
    }
    // The dropdown is open for a hovering pointer as well as for focus (WCAG 1.4.13).
    if (group?.matches(':hover, :focus-within')) {
      group.dataset.dismissed = '';
      if (group.contains(document.activeElement)) group.querySelector('a')?.focus();
    }
  });

  // Leaving with the pointer re-arms it too, so a later keyboard visit still opens it.
  const reopen = () => group && delete group.dataset.dismissed;
  group?.addEventListener('mouseenter', reopen);
  group?.addEventListener('mouseleave', reopen);
  group?.addEventListener('focusout', (e) => {
    if (!group.contains(e.relatedTarget as Node | null)) reopen();
  });
</script>
