---
// A syntax-highlighted code block for the hand-written pages. The Markdown
// guides get the same theme through the processor in astro.config.mjs.
import { Code } from 'astro:components';
import theme from '../utils/krabka-shiki-theme.mjs';
import compactCodeTokens from '../utils/compact-code-tokens.mjs';

interface Props {
  code: string;
  // A Shiki language id: bash, rust, go, java, kotlin, yaml, toml, xml, json.
  lang?: string;
  size?: 'xs' | 'sm';
  class?: string;
  // 1-based line numbers to mark with `.line-highlight`.
  highlight?: number[];
}

const { code, lang = 'text', size = 'xs', class: className, highlight = [] } = Astro.props;
const marked = new Set(highlight);
const transformers = [compactCodeTokens(), {
  line(node: { properties: Record<string, unknown> }, line: number) {
    if (marked.has(line)) node.properties.class = [node.properties.class, 'line-highlight'].filter(Boolean).join(' ');
  },
}];
---

<div class:list={['code-block', size === 'sm' ? 'text-sm' : 'text-xs', className]}>
  <Code code={code.replace(/\n+$/, '')} lang={lang} theme={theme} wrap={null} transformers={transformers} />
</div>
