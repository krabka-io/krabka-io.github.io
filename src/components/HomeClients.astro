---
// The home page's client section: excerpts of the get-started client snippets,
// which CI runs against a real broker. See src/utils/client-excerpts.mjs.
import fs from 'node:fs';
import CodeBlock from './CodeBlock.astro';
import { getPath } from '../utils/paths';
import { readDeclaration } from '../../scripts/snippets/extract.mjs';
import { buildExcerpts } from '../utils/client-excerpts.mjs';

const source = fs.readFileSync('src/pages/get-started.astro', 'utf8');
const excerpts = buildExcerpts(readDeclaration(source, 'clientSnippets', {}, 'get-started'));
---

<section aria-labelledby="clients-heading" class="py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 id="clients-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Just change one line: the broker address
    </h2>

    <div class="mt-8 max-w-5xl overflow-hidden rounded-xl border border-white/10 bg-slate-950/95">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 px-3 py-2">
        <!-- One row that scrolls on a phone, rather than stacked rows that read as a list. -->
        <div class="flex max-w-full items-center gap-1 overflow-x-auto" role="tablist" id="home-client-tabs" aria-label="Client examples">
          {excerpts.map((e, index) => (
            <button
              type="button"
              role="tab"
              id={`home-tab-${e.id}`}
              aria-controls={`home-panel-${e.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              class="shrink-0 whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-semibold text-gray-400 transition-colors hover:text-white aria-selected:bg-white/10 aria-selected:text-white"
            >
              {e.label}
            </button>
          ))}
        </div>
        <span id="home-client-library" class="hidden font-mono text-xs text-gray-400 sm:inline">{excerpts[0].library}</span>
      </div>

      <div class="p-4 sm:p-6">
        {excerpts.map((e, index) => (
          <div id={`home-panel-${e.id}`} role="tabpanel" aria-labelledby={`home-tab-${e.id}`} hidden={index !== 0} data-library={e.library}>
            <CodeBlock code={e.text} lang={e.lang} size="sm" class="code-block-bare" highlight={e.highlight} />
          </div>
        ))}
      </div>
    </div>

    <p class="mt-3 text-sm text-gray-400">
      Each example runs against krabka nightly in CI. <a href={getPath('/get-started')} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Full runnable versions</a>
    </p>
  </div>
</section>

<script>
  import { initTabs } from '../utils/tabs';

  const list = document.getElementById('home-client-tabs');
  const library = document.getElementById('home-client-library');
  if (list) {
    initTabs(list, (_tab, panel) => {
      if (library) library.textContent = panel.getAttribute('data-library') || '';
    });
  }
</script>
