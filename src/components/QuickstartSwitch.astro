---
import { getPath } from '../utils/paths';

interface Props {
  current: 'local' | 'kubernetes';
}
const { current } = Astro.props;
const options = [
  { id: 'local', label: 'Docker Compose', href: '/docs/quickstart' },
  { id: 'kubernetes', label: 'Kubernetes', href: '/docs/kubernetes-quickstart' },
];
---

<nav aria-label="Quickstart environment" class="mt-4 inline-flex rounded-lg border border-white/10 p-1">
  {options.map((option) => (
    <a
      href={getPath(option.href)}
      aria-current={current === option.id ? 'page' : undefined}
      class={`rounded-lg px-3 py-2 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-krab-500 ${current === option.id ? 'text-krab-500 bg-white/5' : 'text-gray-300 hover:text-white hover:bg-white/5'}`}
    >
      {option.label}
    </a>
  ))}
</nav>
