---
import { Code } from 'astro:components';
import { getPath } from '../utils/paths';
import krabTheme from '../utils/krabka-shiki-theme.mjs';

const startCommand = 'curl -fsSL https://krabka.io/quickstart/docker-compose.yml -o docker-compose.yml && docker compose up -d';
const produceCommand = 'kafka-console-producer.sh --bootstrap-server localhost:9092 --topic events';

// Shiki puts the space before a word inside that word's span. The stylesheet keeps
// each word whole (`.code-block-wrap`), so the space has to sit outside it, or the
// only break a command has would be hidden inside the span.
const spaceOutsideToken = {
  line(line) {
    line.children = line.children.flatMap((token) => {
      const first = token.children?.[0];
      const space = first?.type === 'text' && first.value.match(/^\s+/)?.[0];
      if (!space) return [token];
      const rest = [{ ...first, value: first.value.slice(space.length) }, ...token.children.slice(1)];
      return [{ type: 'text', value: space }, { ...token, children: rest }];
    });
  },
};
---

<section class="relative overflow-hidden pt-12 pb-10 md:pt-20 md:pb-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
      
      <!-- Left Column: Content & CTAs -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.1]">
          Kafka-compatible broker. <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-krab-500 via-krab-400 to-amber-400">
            Written in safe Rust.
          </span>
        </h1>

        <p class="text-lg text-gray-300 sm:text-xl max-w-2xl font-normal leading-relaxed">
          krabka is an open-source broker that implements the <a href={getPath('/docs/kip-matrix')} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Apache Kafka wire protocol</a> and a <a href={getPath('/features/kraft')} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">KRaft metadata quorum</a> in <a href={getPath('/verification#memory-safety')} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">safe Rust</a>. <a href="https://creusot.rs/" target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Creusot</a> proves selected <a href={getPath('/verification#proof-contracts')} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">decision-kernel contracts</a>, and <a href="https://www.stateright.rs/" target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Stateright</a> checks failure sequences within each <a href={getPath('/verification#model-bounds')} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">model’s bounds</a>.
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href={getPath('/get-started')}
            class="inline-flex items-center justify-center rounded-xl bg-krab-600 px-6 py-3 text-base font-semibold text-white shadow-lg transition-all hover:bg-krab-700 hover:shadow-krab-500/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-krab-500"
          >
            Get Started
            <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>

          <a
            href="https://github.com/krabka-io"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/5 px-6 py-3 text-base font-semibold text-white transition-all hover:border-white/40 hover:bg-white/10"
          >
            <svg class="mr-2.5 h-5 w-5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            GitHub
          </a>
        </div>

      </div>

      <!-- Right Column: Two Clean Split Terminal Boxes with Copy Buttons -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Box 1: Run Broker -->
        <div class="frosted-card rounded-2xl p-4 shadow-xl border border-white/10 bg-slate-900/85">
          <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-2.5 mb-3">
            <span class="text-xs font-semibold text-gray-300 font-sans">1. Start a single-node broker</span>
            <button
              type="button"
              class="copy-btn flex shrink-0 items-center gap-1 rounded bg-white/5 px-2 py-1 text-xs text-gray-300 hover:bg-white/10 hover:text-white transition-all font-sans"
              data-copy={startCommand}
            >
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span>Copy</span>
            </button>
          </div>

          <div class="font-mono text-xs sm:text-sm text-gray-200 bg-black/40 p-2.5 rounded-lg border border-white/5 overflow-x-auto flex items-start gap-2">
            <span class="text-gray-500 select-none leading-[1.65]">$</span>
            <div class="code-block code-block-bare code-block-wrap min-w-0 flex-1 select-all"><Code code={startCommand} lang="bash" theme={krabTheme} wrap={null} transformers={[spaceOutsideToken]} /></div>
          </div>
        </div>

        <!-- Box 2: Produce Records -->
        <div class="frosted-card rounded-2xl p-4 shadow-xl border border-white/10 bg-slate-900/85">
          <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-2.5 mb-3">
            <span class="text-xs font-semibold text-gray-300 font-sans">2. Produce records with existing Kafka CLI</span>
            <button
              type="button"
              class="copy-btn flex shrink-0 items-center gap-1 rounded bg-white/5 px-2 py-1 text-xs text-gray-300 hover:bg-white/10 hover:text-white transition-all font-sans"
              data-copy={produceCommand}
            >
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span>Copy</span>
            </button>
          </div>

          <div class="font-mono text-xs sm:text-sm text-gray-200 bg-black/40 p-2.5 rounded-lg border border-white/5 overflow-x-auto flex items-start gap-2">
            <span class="text-gray-500 select-none leading-[1.65]">$</span>
            <div class="code-block code-block-bare code-block-wrap min-w-0 flex-1 select-all"><Code code={produceCommand} lang="bash" theme={krabTheme} wrap={null} transformers={[spaceOutsideToken]} /></div>
          </div>
        </div>

        <!-- Example listener -->
        <div class="rounded-xl bg-black/40 p-3 text-xs text-gray-300 font-medium border border-white/5 font-sans">
          Example listener: localhost:9092
        </div>

      </div>

    </div>
  </div>
</section>
