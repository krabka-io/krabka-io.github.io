---
import { openmessaging, format } from '../utils/benchmarks.mjs';
import { getPath } from '../utils/paths';

const highlights = (openmessaging?.rows ?? []).flatMap(group => {
  const workload = group.cases.find(c => c.id === 'max-rate-1-topic-16-partitions-1kb');
  return workload ? [{ rf: group.rf, workload }] : [];
});
const colors = { krabka: 'bg-krab-500', kafka: 'bg-sky-400', redpanda: 'bg-violet-400' };
---

<section id="benchmarks" aria-labelledby="benchmark-heading" class="py-16 border-y border-white/5 bg-ocean-950/40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-krab-400 mb-3">OpenMessaging Benchmark</p>
        <h2 id="benchmark-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Publish rate and end-to-end latency</h2>
        <p class="mt-4 text-gray-300 leading-relaxed">
          Upstream OMB workloads against krabka, Apache Kafka, and Redpanda.
          {openmessaging && <>Below: maximum-rate 1 KiB records, one topic with 16 partitions, no compression, and <code>acks=all</code>. {openmessaging.provenance.repetitions === 1 ? 'One measured round per workload.' : `Medians of ${openmessaging.provenance.repetitions} rounds.`}</>}

        </p>
      </div>
      <a href={getPath('/benchmarks')} class="inline-flex rounded-xl border border-white/20 bg-white/5 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10 transition-colors">All results and methodology →</a>
    </div>

    {!openmessaging && <p class="text-gray-300">No complete OpenMessaging run has been published yet.</p>}
    {openmessaging && <p class="mb-6 text-sm text-gray-400">{openmessaging.images.map(image => image.label).join(', ')} · Run {openmessaging.provenance.run_id}</p>}
    <div class="grid gap-6 lg:grid-cols-2">
      {highlights.map(topology => {
        const rows = topology.workload.vendors;
        const maximum = Math.max(...rows.map(row => row.publish_rate));
        return (
          <article class="frosted-card rounded-2xl p-5 sm:p-6 min-w-0">
            <h3 class="text-lg font-bold text-white">{topology.rf === 1 ? 'One broker' : 'Three brokers'} <span class="text-sm font-normal text-gray-400">· RF{topology.rf}</span></h3>
            <div class="mt-5 flex justify-between gap-4 text-xs text-gray-400" aria-hidden="true">
              <span>Messages/s</span><span>End-to-end p99</span>
            </div>
            <dl class="mt-4 space-y-5">
              {rows.map(row => (
                <div>
                  <dt class={`text-sm font-semibold ${row.id === 'krabka' ? 'text-krab-400' : 'text-gray-200'}`}>{row.name}</dt>
                  <dd class="mt-1 flex justify-between gap-3 text-sm tabular-nums text-white">
                    <span>{format(row.publish_rate)} <span class="sr-only">messages per second</span></span>
                    <span>{format(row.end_to_end_p99_ms, 1)} ms <span class="sr-only">end-to-end p99 latency</span></span>
                  </dd>
                  <div class="mt-2 h-2 overflow-hidden rounded-full bg-white/5" aria-hidden="true">
                    <div class={`h-full rounded-full ${colors[row.id]}`} style={`width: ${row.publish_rate / maximum * 100}%`}></div>
                  </div>
                </div>
              ))}
            </dl>
          </article>
        );
      })}
    </div>

    <p class="mt-6 max-w-4xl text-sm leading-relaxed text-gray-400">
      Buffered writes on a shared host. Acknowledgment contracts differ between brokers; crash durability was not tested.
      OMB reports rates and latency; these measurements apply to the published images, host, and workloads.
      <a href={getPath('/benchmarks')} class="text-krab-400 underline underline-offset-4 hover:text-krab-300">Read the ranges, resource settings, and limits of this comparison.</a>
    </p>
  </div>
</section>
