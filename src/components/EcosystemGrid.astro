---
import { getPath } from '../utils/paths';

const repos = [
  {
    name: 'krabka-broker',
    language: 'Rust',
    desc: 'Kafka-compatible broker with KRaft and tiered storage.',
    github: 'https://github.com/krabka-io/krabka-broker',
  },
  {
    name: 'krabka-protocol',
    language: 'Rust',
    desc: 'Kafka wire codecs, KRaft records, and SASL/TLS.',
    github: 'https://github.com/krabka-io/krabka-protocol',
  },
  {
    name: 'krabka-client-rs',
    language: 'Rust',
    desc: 'Kafka producer, consumer, and admin APIs.',
    github: 'https://github.com/krabka-io/krabka-client-rs',
  },
  {
    name: 'krabka-streams-rs',
    language: 'Rust',
    desc: 'Stream processing, windowing, and state stores.',
    github: 'https://github.com/krabka-io/krabka-streams-rs',
  },
  {
    name: 'krabka-streams-go',
    language: 'Go',
    desc: 'Arrow batch processing and barrier cuts.',
    github: 'https://github.com/krabka-io/krabka-streams-go',
  },
  {
    name: 'krabka-streams-java',
    language: 'Java',
    desc: 'Kafka Streams APIs, Arrow batches, and schema serdes.',
    github: 'https://github.com/krabka-io/krabka-streams-java',
  },
  {
    name: 'krabka-schema-registry',
    language: 'Rust',
    desc: 'Confluent-compatible schemas stored in Kafka.',
    github: 'https://github.com/krabka-io/krabka-schema-registry',
  },
  {
    name: 'krabka-operator',
    language: 'Rust',
    desc: 'Kubernetes cluster and resource management.',
    github: 'https://github.com/krabka-io/krabka-operator',
  },
  {
    name: 'krabka-connect',
    language: 'Rust',
    desc: 'PostgreSQL CDC and cross-cluster replication.',
    github: 'https://github.com/krabka-io/krabka-connect',
  },
  {
    name: 'krabka-rebalancer',
    language: 'Rust',
    desc: 'Partition assignment and cluster balancing.',
    github: 'https://github.com/krabka-io/krabka-rebalancer',
  },
  {
    name: 'krabka-cli',
    language: 'Rust',
    desc: 'Cluster, topic, ACL, and consumer-group administration.',
    github: 'https://github.com/krabka-io/krabka-cli',
  },
];

const broader = [
  {
    name: 'krabka-o11y',
    desc: 'Metrics, traces, profiles, and logs.',
    github: 'https://github.com/krabka-io/krabka-o11y',
  },
  {
    name: 'krabka-o11y-demo',
    desc: 'Grafana dashboards and an example orders pipeline.',
    github: 'https://github.com/krabka-io/krabka-o11y-demo',
  },
  {
    name: 'gres',
    desc: 'Postgres-compatible compute backed by krabka and object storage.',
    github: 'https://github.com/krabka-io/gres',
  },
];
---

<section class="py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 gap-4">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Repositories
        </h2>
        <p class="mt-2 text-lg text-gray-400">
          Broker, clients, streams, and operations.
        </p>
      </div>

      <a
        href="https://github.com/krabka-io"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center text-sm font-semibold text-krab-400 hover:text-krab-300 transition-colors"
      >
        GitHub organization
        <svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <div class="frosted-card overflow-hidden rounded-xl border border-white/10">
      <table class="w-full table-fixed text-left text-sm sm:table-auto" aria-label="krabka repositories">
        <thead class="border-b border-white/10 bg-black/20 text-gray-300">
          <tr>
            <th scope="col" class="w-[46%] px-2 py-3 sm:w-auto sm:px-4">Repository</th>
            <th scope="col" class="px-2 py-3 sm:px-4">Description</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {repos.map((repo) => (
            <tr class="align-top hover:bg-white/5">
              <th scope="row" class="px-2 py-2.5 font-semibold sm:px-4 [overflow-wrap:anywhere]">
                <a href={repo.github} target="_blank" rel="noopener noreferrer" class="flex items-start gap-2 text-krab-400 underline underline-offset-2 hover:text-krab-300">
                  <img
                    src={getPath(`/icons/languages/${repo.language.toLowerCase()}.svg`)}
                    alt={repo.language}
                    title={repo.language}
                    width="20"
                    height="20"
                    class:list={['h-5 w-5 shrink-0', { invert: repo.language !== 'Go', 'brightness-0': repo.language === 'Java' }]}
                  />
                  <span class="min-w-0">{repo.name}</span>
                </a>
              </th>
              <td class="px-2 py-2.5 text-gray-400 sm:px-4 [overflow-wrap:anywhere]">{repo.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Broader krabka ecosystem: projects built on the broker, documented on their own sites -->
    <div class="mt-8">
      <h3 class="mb-4 text-xl font-bold text-white">Built on krabka</h3>
      <div class="frosted-card overflow-hidden rounded-xl border border-white/10">
        <table class="w-full table-fixed text-left text-sm sm:table-auto" aria-label="Projects built on krabka">
          <thead class="border-b border-white/10 bg-black/20 text-gray-300">
            <tr>
              <th scope="col" class="w-[42%] px-2 py-3 sm:w-auto sm:px-4">Repository</th>
              <th scope="col" class="px-2 py-3 sm:px-4">Description</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {broader.map((repo) => (
              <tr class="align-top hover:bg-white/5">
                <th scope="row" class="px-2 py-2.5 font-semibold sm:px-4 [overflow-wrap:anywhere]">
                  <a href={repo.github} target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">{repo.name}</a>
                </th>
                <td class="px-2 py-2.5 text-gray-400 sm:px-4 [overflow-wrap:anywhere]">{repo.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
