---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPath } from '../utils/paths';
import benchmarkData from '../data/benchmarks/latest-summary.json';

const reproSnippet = `git clone https://github.com/krabka-io/krabka-o11y-demo
cd krabka-o11y-demo/benchmarks
./run-suite.sh --cluster-type gke --target krabka --workload omb-standard`;

const formattedDate = new Date(benchmarkData.lastUpdated).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const benchmarkSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Krabka vs Apache Kafka: Empirical Benchmark Results & Performance Matrix",
  "description": "Comparative benchmarks between Krabka (native Rust) and Apache Kafka (Strimzi on OpenJDK 21) across memory working set RSS, cold start duration, throughput saturation, and p99 latency.",
  "author": {
    "@type": "Organization",
    "name": "Krabka Authors",
    "url": "https://krabka.io"
  },
  "keywords": "Krabka benchmarks, Apache Kafka vs Krabka, Kafka memory working set, Kafka startup time, Kafka throughput per core, OpenMessaging Benchmark, KRaft performance",
  "datePublished": "2026-08-26",
  "dateModified": benchmarkData.lastUpdated
};
---

<BaseLayout
  title="Benchmarks: Krabka vs Apache Kafka Performance | Krabka"
  description="Empirical benchmarks comparing Krabka to Apache Kafka (Strimzi on OpenJDK 21): 114 MiB memory working set, sub-second cold starts, and low tail latency."
>
  <script type="application/ld+json" set:html={JSON.stringify(benchmarkSchema)} slot="head" />

  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 font-sans">
    <header class="text-left border-b border-white/10 pb-8 mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
          Benchmark Results & Methodology
        </h1>
        <p class="mt-4 text-lg text-gray-300 max-w-3xl leading-relaxed">
          Empirical measurements comparing Krabka against Strimzi (Apache Kafka on OpenJDK 21) under identical Kubernetes cluster topologies.
        </p>
        <div class="mt-3 text-xs text-gray-400">
          Latest matrix: <a
            href={`https://github.com/krabka-io/krabka-broker/commit/${benchmarkData.commit}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-krab-400 hover:text-krab-300 underline font-semibold transition-colors"
          >commit {benchmarkData.commit}</a> &bull; <span>{formattedDate}</span>
        </div>
      </div>
      <div>
        <a
          href={getPath('/docs/benchmarks')}
          class="inline-flex items-center gap-2 rounded-xl bg-krab-600/30 px-4 py-2.5 text-sm font-semibold text-krab-300 hover:bg-krab-600/50 hover:text-white border border-krab-500/30 transition-all"
        >
          <span>Read Methodology & Docs</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </header>

    <!-- Side-by-Side Headline Cards: Memory Footprint & Cold Start -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-14" aria-label="Core Benchmark Comparisons">
      
      <!-- Memory Footprint Card -->
      <div class="frosted-card rounded-2xl p-6 border border-white/10 flex flex-col justify-between space-y-6">
        <div>
          <h2 class="text-xl font-bold text-white mb-2">{benchmarkData.headlineMetrics.memoryRss.metric}</h2>
          <p class="text-gray-400 text-sm leading-relaxed mb-6">
            {benchmarkData.headlineMetrics.memoryRss.description}
          </p>

          <div class="space-y-5">
            <div>
              <div class="flex justify-between text-sm font-semibold mb-1.5">
                <span class="text-krab-400 font-bold">Krabka Broker (RSS)</span>
                <span class="text-white font-bold">{benchmarkData.headlineMetrics.memoryRss.krabka} {benchmarkData.headlineMetrics.memoryRss.unit}</span>
              </div>
              <div class="h-4 w-full bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-krab-600 to-krab-500 rounded-full" style={`width: ${benchmarkData.headlineMetrics.memoryRss.krabkaPercent}%`}></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-sm font-semibold mb-1.5">
                <span class="text-gray-400">Strimzi Kafka JVM (Heap + Off-Heap)</span>
                <span class="text-gray-300 font-bold">{benchmarkData.headlineMetrics.memoryRss.strimzi.toLocaleString()} {benchmarkData.headlineMetrics.memoryRss.unit}</span>
              </div>
              <div class="h-4 w-full bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-slate-600 rounded-full" style={`width: ${benchmarkData.headlineMetrics.memoryRss.strimziPercent}%`}></div>
              </div>
            </div>
          </div>
        </div>

        <div class="text-xs text-gray-300 pt-3 border-t border-white/5 leading-relaxed">
          {benchmarkData.headlineMetrics.memoryRss.keyInsight}
        </div>
      </div>

      <!-- Cold Start & Failover Card -->
      <div class="frosted-card rounded-2xl p-6 border border-white/10 flex flex-col justify-between space-y-6">
        <div>
          <h2 class="text-xl font-bold text-white mb-2">{benchmarkData.headlineMetrics.startupTime.metric}</h2>
          <p class="text-gray-400 text-sm leading-relaxed mb-6">
            {benchmarkData.headlineMetrics.startupTime.description}
          </p>

          <div class="space-y-5">
            <div>
              <div class="flex justify-between text-sm font-semibold mb-1.5">
                <span class="text-krab-400 font-bold">Krabka Startup Time</span>
                <span class="text-white font-bold">{benchmarkData.headlineMetrics.startupTime.krabka} {benchmarkData.headlineMetrics.startupTime.unit}</span>
              </div>
              <div class="h-4 w-full bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-krab-600 to-krab-500 rounded-full" style={`width: ${benchmarkData.headlineMetrics.startupTime.krabkaPercent}%`}></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-sm font-semibold mb-1.5">
                <span class="text-gray-400">Strimzi JVM Startup Time</span>
                <span class="text-gray-300 font-bold">{benchmarkData.headlineMetrics.startupTime.strimzi} {benchmarkData.headlineMetrics.startupTime.unit}</span>
              </div>
              <div class="h-4 w-full bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-slate-600 rounded-full" style={`width: ${benchmarkData.headlineMetrics.startupTime.strimziPercent}%`}></div>
              </div>
            </div>
          </div>
        </div>

        <div class="text-xs text-gray-300 pt-3 border-t border-white/5 leading-relaxed">
          {benchmarkData.headlineMetrics.startupTime.keyInsight}
        </div>
      </div>

    </section>

    <!-- Saturated Scenario Matrix -->
    <section class="mb-14" aria-labelledby="scenario-matrix-heading">
      <h2 id="scenario-matrix-heading" class="text-2xl font-bold text-white mb-2">Workload Scenario Matrix</h2>
      <p class="text-gray-400 text-sm mb-6 max-w-3xl leading-relaxed">
        Throughput saturation and latency measurements across individual benchmark scenario runs.
      </p>

      <div class="frosted-card rounded-2xl overflow-x-auto border border-white/10">
        <table class="w-full text-left text-sm border-collapse" aria-label="Workload Scenario Matrix Table">
          <thead>
            <tr class="border-b border-white/10 bg-white/5 text-gray-300 text-xs uppercase tracking-wider">
              <th scope="col" class="py-3.5 px-4 font-semibold">Scenario</th>
              <th scope="col" class="py-3.5 px-4 font-semibold">Payload</th>
              <th scope="col" class="py-3.5 px-4 font-semibold">Topology</th>
              <th scope="col" class="py-3.5 px-4 font-semibold">Duration</th>
              <th scope="col" class="py-3.5 px-4 font-semibold text-krab-300">Krabka Metric</th>
              <th scope="col" class="py-3.5 px-4 font-semibold text-gray-400">Strimzi Metric</th>
              <th scope="col" class="py-3.5 px-4 font-semibold text-right">Advantage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-gray-300 text-xs">
            {benchmarkData.scenarios.map((s) => (
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-4 font-bold text-white">{s.name}</td>
                <td class="py-3.5 px-4">{s.payloadSize}</td>
                <td class="py-3.5 px-4">{s.partitions}p / RF={s.replicationFactor}</td>
                <td class="py-3.5 px-4">{s.duration}</td>
                <td class="py-3.5 px-4 text-krab-400 font-bold">
                  {s.krabkaThroughputMb ? `${s.krabkaThroughputMb} MB/s` : s.krabkaP99Ms ? `${s.krabkaP99Ms} ms (p99)` : `${s.krabkaRecoverySec} s (failover)`}
                </td>
                <td class="py-3.5 px-4 text-gray-400">
                  {s.strimziThroughputMb ? `${s.strimziThroughputMb} MB/s` : s.strimziP99Ms ? `${s.strimziP99Ms} ms (p99)` : `${s.strimziRecoverySec} s (failover)`}
                </td>
                <td class="py-3.5 px-4 text-right font-bold text-krab-300">
                  {s.throughputRatio || s.latencyReduction || s.recoverySpeedup}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Reproduction Box -->
    <section class="frosted-card rounded-2xl p-8 border border-white/10" aria-labelledby="reproduction-heading">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 id="reproduction-heading" class="text-xl font-bold text-white mb-1">Reproducing the Benchmarks</h2>
          <p class="text-gray-400 text-sm">
            All benchmarking scripts and Terraform recipes are open source in the <code class="text-gray-200">krabka-o11y-demo</code> repository.
          </p>
        </div>
        <button
          type="button"
          class="copy-btn flex items-center gap-1.5 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-gray-200 hover:bg-white/20 hover:text-white transition-all"
          data-copy={reproSnippet}
          aria-label="Copy reproduction commands"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
          <span>Copy Commands</span>
        </button>
      </div>

      <pre class="bg-black/50 p-4 rounded-xl font-mono text-xs text-krab-300 overflow-x-auto border border-white/5"><code>{reproSnippet}</code></pre>
    </section>

  </div>
</BaseLayout>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const textToCopy = btn.getAttribute('data-copy');
      if (textToCopy) {
        navigator.clipboard.writeText(textToCopy);
        const span = btn.querySelector('span');
        if (span) {
          span.textContent = 'Copied!';
          setTimeout(() => {
            span.textContent = 'Copy Commands';
          }, 2000);
        }
      }
    });
  });
</script>
