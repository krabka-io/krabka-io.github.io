---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import OpenMessagingCharts from '../components/OpenMessagingCharts.astro';
import { methodologyURL, format, openmessaging } from '../utils/benchmarks.mjs';

const latency = (ms: number | null) => ms === null ? '—' : ms >= 1000 ? format(ms / 1000, 1) + ' s' : format(ms, ms < 10 ? 1 : 0) + ' ms';
const offered = (rate: number) => rate > 0 ? format(rate) + '/s' : 'max (probed)';
const ombShards = openmessaging?.provenance.shards ?? [];
const ombSameHost = !ombShards.length || new Set(ombShards.map(s => JSON.stringify([s.host?.cpu_model, s.host?.memory_total_bytes]))).size === 1;
const ombDerived = ombShards.filter(s => s.derived_from);
const ombRetriable = (openmessaging?.trials ?? []).reduce((sum, t) => sum + (t.retriable_commit_failures ?? 0), 0);
const ombCompleted = openmessaging ? new Date(openmessaging.provenance.completed_at).toISOString() : null;
const repeat = `# Resolve and check the pinned images and local prerequisites
npm run benchmark -- --suite openmessaging --dry-run

# Run the upstream OMB workload catalog on a Linux host with Docker
npm run benchmark -- --suite openmessaging`;
---

<BaseLayout
  image="/og/benchmarks.png"
  title="Broker benchmarks | krabka" description="OpenMessaging Benchmark rates and latency for krabka, Apache Kafka, and Redpanda, with published results and reproducible methodology.">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="max-w-4xl">
      <p class="mb-3 text-sm font-semibold text-krab-400">OpenMessaging Benchmark</p>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">Broker benchmarks</h1>
      <p class="mt-4 text-base text-gray-300 leading-relaxed">Compare krabka, Apache Kafka, and Redpanda using the upstream OpenMessaging Benchmark (OMB) workloads. All performance figures on this website come from published full OMB runs.</p>
      <p class="mt-4 text-sm text-gray-400">These are our measurements using OMB, with source and configuration linked below.</p>
      {!openmessaging && <p class="mt-4 text-gray-300">No complete OpenMessaging run has been published yet.</p>}
      {openmessaging && <a href="#charts" class="mt-6 mr-6 inline-block text-sm font-semibold text-krab-400 underline underline-offset-4">Explore the charts</a>}
      <a href="#methodology" class="mt-6 inline-block text-sm font-semibold text-krab-400 underline underline-offset-4">Methodology and reproduction</a>
    </header>

    {openmessaging && (
      <section id="openmessaging" aria-labelledby="openmessaging-heading" class="mt-16 scroll-mt-24">
        <h2 id="openmessaging-heading" class="text-2xl font-bold text-white sm:text-3xl">OpenMessaging Benchmark</h2>
        <div class="mt-4 max-w-4xl space-y-3 text-sm text-gray-300 leading-relaxed [overflow-wrap:anywhere]">
          <p>
            The upstream <a href="https://openmessaging.cloud/docs/benchmarks/" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">OpenMessaging Benchmark</a> workloads, run by its Kafka driver and Kafka {openmessaging.provenance.openmessaging?.kafka_client_version ?? '3.6.1'} client against every broker:
            {openmessaging.images.map((image, i) => <>{i ? (i === openmessaging.images.length - 1 ? ', and ' : ', ') : ' '}{image.label}</>)}.
            {(openmessaging.provenance.openmessaging?.patches && Object.keys(openmessaging.provenance.openmessaging.patches).length)
              ? <>The driver carries one patch, applied identically to every broker, that keeps at most one offset commit in flight, as Redpanda's fork of the benchmark does. </>
              : null}
            {ombSameHost
              ? <>All trials ran on one {openmessaging.provenance.host.cpu_model} host with {openmessaging.provenance.host.logical_cpus} logical CPUs, the brokers one at a time,</>
              : <>Each workload and replication factor ran on its own {openmessaging.provenance.host.logical_cpus}-vCPU machine ({openmessaging.provenance.shards.length} in all), the brokers one at a time on that machine,</>}
            with fresh storage per trial, four CPUs and 10 GiB per broker, and a separate client.
            {ombDerived.length > 0 && <>The run merges {openmessaging.provenance.shards.length} invocations; {ombDerived.map(s => `RF${s.derived_from.replication_factor}${s.derived_from.workloads ? ` (${s.derived_from.workloads.length} workloads)` : ''}`).join(' and ')} came from {ombDerived.length === 1 ? 'an invocation' : 'invocations'} that did not finish cleanly, keeping only workloads whose trials had all completed and passed; anything left out was rerun for all three brokers. Each shard's source run and reason are in the provenance. </>}
            {ombRetriable > 0 && <>{ombRetriable} offset {ombRetriable === 1 ? 'commit' : 'commits'} failed with a retriable error after a leader or coordinator move and {ombRetriable === 1 ? 'was' : 'were'} superseded by the next commit; these are counted, not failed. </>}
            Run {openmessaging.provenance.run_id}, completed <time datetime={ombCompleted}>{ombCompleted.slice(0, 10)}</time>; {openmessaging.provenance.repetitions === 1 ? 'one round' : openmessaging.provenance.repetitions + ' rounds (medians shown)'} per workload.
          </p>
          <p>
            Writes are buffered: Kafka and krabka acknowledge in-sync replication with <code>acks=all</code>; Redpanda acknowledges a Raft majority with <code>write.caching=true</code>. This does not establish equal crash durability.
            OMB reports rates and latency, not exact delivery or duplicate checks. Backlog workloads fill a 100 GB backlog before consumers drain it, so their end-to-end latency includes that wait.
            CPU and memory windows include client startup, warm-up, rate probing, measurement and shutdown. Results apply only to this runner, these images and these workloads.
          </p>
        </div>
        <OpenMessagingCharts />
        {openmessaging.rows.map(group => (
          <div class="mt-8">
            <h3 class="text-lg font-semibold text-white">Replication factor {group.rf}</h3>
            <div class="relative mt-3 overflow-x-auto rounded-xl border border-white/10">
              <table class="w-full min-w-[46rem] text-left text-xs" aria-label={`Mean publish rate and end-to-end p99 latency per broker, RF${group.rf}`}>
                <thead class="bg-slate-950/60 text-gray-400">
                  <tr>
                    <th scope="col" rowspan="2" class="px-3 py-2 font-semibold">Workload</th>
                    <th scope="col" rowspan="2" class="px-3 py-2 font-semibold text-right">Offered</th>
                    {openmessaging.images.map(image => <th scope="colgroup" colspan="2" class="px-3 pt-2 font-semibold text-center text-white">{image.name}</th>)}
                  </tr>
                  <tr>
                    {openmessaging.images.map(() => <><th scope="col" class="px-3 pb-2 font-normal text-right">msg/s</th><th scope="col" class="px-3 pb-2 font-normal text-right">E2E p99</th></>)}
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5 text-gray-300">
                  {group.cases.map(workload => (
                    <tr>
                      <th scope="row" class="px-3 py-2 font-mono font-normal text-gray-200 whitespace-nowrap">{workload.id}</th>
                      <td class="px-3 py-2 text-right whitespace-nowrap">{offered(workload.config.producerRate)}</td>
                      {workload.vendors.map(v => <><td class="px-3 py-2 text-right tabular-nums">{format(v.publish_rate)}</td><td class="px-3 py-2 text-right tabular-nums whitespace-nowrap">{latency(v.end_to_end_p99_ms)}</td></>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
        <details class="frosted-card rounded-2xl mt-6 p-5 sm:p-6">
          <summary class="cursor-pointer font-semibold text-white hover:text-krab-400">Publish p99 and pinned images</summary>
          {openmessaging.rows.map(group => (
            <div class="relative mt-5 overflow-x-auto">
              <table class="w-full min-w-[32rem] text-left text-xs">
                <caption class="text-left font-semibold text-white pb-2">RF{group.rf}: publish p99 latency</caption>
                <thead class="text-gray-400"><tr><th scope="col" class="px-3 py-2">Workload</th>{openmessaging.images.map(image => <th scope="col" class="px-3 py-2 text-right">{image.name}</th>)}</tr></thead>
                <tbody class="divide-y divide-white/5 text-gray-300">
                  {group.cases.map(workload => <tr>
                    <th scope="row" class="px-3 py-2 font-mono font-normal text-gray-200 whitespace-nowrap">{workload.id}</th>
                    {workload.vendors.map(v => <td class="px-3 py-2 text-right tabular-nums whitespace-nowrap">{latency(v.publish_p99_ms)}</td>)}
                  </tr>)}
                </tbody>
              </table>
            </div>
          ))}
          <dl class="mt-6 space-y-4 text-sm">
            {openmessaging.images.map(image => <div>
              <dt class="font-semibold text-white [overflow-wrap:anywhere]">{image.label}</dt>
              <dd class="mt-1 font-mono text-xs text-gray-300 break-all">{image.requested}</dd>
              <dd class="mt-1 font-mono text-xs text-gray-400 break-all">{image.reference}</dd>
            </div>)}
          </dl>
          <p class="mt-5 text-sm text-gray-300">The <a href={openmessaging.summaryURL} class="text-krab-400 underline underline-offset-4 hover:text-krab-300">run summary</a> lists every trial, and the <a href={openmessaging.provenanceURL} class="text-krab-400 underline underline-offset-4 hover:text-krab-300">provenance</a> records the host, CPU sets, OMB commit, client jar hashes and effective driver settings.</p>
        </details>
      </section>
    )}

    <section id="methodology" aria-labelledby="methodology-heading" class="mt-16 scroll-mt-24 max-w-4xl">
      <h2 id="methodology-heading" class="text-2xl font-bold text-white sm:text-3xl">Methodology and resource settings</h2>
      <p class="mt-4 text-sm text-gray-300 leading-relaxed">Full runs preserve the upstream workload payloads, partition counts, offered rates, backlog sizes, and durations. The pinned OMB commit, driver patch, immutable broker images, host resources, and effective configurations are recorded in each run’s provenance. Smoke runs are wiring checks and cannot supply website figures.</p>
      <p class="mt-4 text-sm text-gray-300 leading-relaxed">Publish rates are means of OMB’s measurement intervals; p99 latency comes from OMB’s aggregate latency results. When a run has multiple rounds, the tables show medians across those rounds.</p>
    </section>

    <section aria-labelledby="repeat-heading" class="mt-14 max-w-4xl">
      <h2 id="repeat-heading" class="text-2xl font-bold text-white">Repeat the comparison</h2>
      <p class="mt-3 mb-5 text-sm text-gray-300 leading-relaxed">From this website repository, use Node 22.12 or later, JDK 17 or later, and native Linux/amd64 with local Docker. Check the benchmark instructions for resource requirements and deadlines.</p>
      <CodeBlock code={repeat} lang="bash" />
      <p class="mt-5 text-sm text-gray-300">See the <a href={methodologyURL} class="text-krab-400 underline underline-offset-4 hover:text-krab-300">benchmark instructions</a> for the upstream catalog, resource requirements, and publication checks.</p>
    </section>
  </div>
</BaseLayout>
