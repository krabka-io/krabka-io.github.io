---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import OpenMessagingCharts from '../components/OpenMessagingCharts.astro';
import BenchmarkOverview from '../components/BenchmarkOverview.astro';
import BenchmarkMatrix from '../components/BenchmarkMatrix.astro';
import BenchmarkHint from '../components/BenchmarkHint.astro';
import { getPath } from '../utils/paths';
import { methodologyURL, format, openmessaging, openmessagingDirect } from '../utils/benchmarks.mjs';
import { comparison } from '../utils/benchmark-story.mjs';

const latency = (ms: number | null) => ms === null ? '—' : ms >= 1000 ? format(ms / 1000, 1) + ' s' : format(ms, ms < 10 ? 1 : 0) + ' ms';
const offered = (rate: number) => rate > 0 ? format(rate) + '/s' : 'max (probed)';
const ombShards = openmessaging?.provenance.shards ?? [];
const ombSameHost = !ombShards.length || new Set(ombShards.map(s => JSON.stringify([s.host?.cpu_model, s.host?.memory_total_bytes]))).size === 1;
const ombDerived = ombShards.filter(s => s.derived_from);
const ombRetriable = (openmessaging?.trials ?? []).reduce((sum, t) => sum + (t.retriable_commit_failures ?? 0), 0);
const ombCompleted = openmessaging ? new Date(openmessaging.provenance.completed_at).toISOString() : null;
// The direct-storage run: krabka with preallocated segments written with
// O_DIRECT, published separately for the comparison with Redpanda. The page
// shows it only when one is published.
const direct = openmessagingDirect;
const directBrokers = direct ? direct.images.filter(image => image.id !== 'kafka') : [];
const directShards = direct?.provenance.shards ?? [];
const directSameHost = !directShards.length || new Set(directShards.map(s => JSON.stringify([s.host?.cpu_model, s.host?.memory_total_bytes]))).size === 1;
const directCompleted = direct ? new Date(direct.provenance.completed_at).toISOString() : null;
const directSummary = direct ? comparison(direct, 'redpanda') : null;
const percent = (value: number) => `${Math.round(value * 100)}%`;
const repeat = `# Resolve and check the pinned images and local prerequisites
npm run benchmark -- --suite openmessaging --dry-run

# Run the upstream OMB workload catalog on a Linux host with Docker
npm run benchmark -- --suite openmessaging`;
---

<BaseLayout
  image="/og/benchmarks.png"
  title="Broker benchmarks | krabka" description="OpenMessaging Benchmark rates and latency for krabka, Apache Kafka, and Redpanda, with published results and reproducible methodology.">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="max-w-4xl">
      <p class="mb-3 text-sm font-semibold text-krab-400">OpenMessaging Benchmark</p>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">Broker benchmarks</h1>
      <p class="mt-4 text-base text-gray-300 leading-relaxed">Compare throughput, tail latency and CPU use across published OpenMessaging Benchmark runs. Inspect release changes and the limits of each comparison.</p>
      <p class="mt-4 text-sm text-gray-400">These are our measurements using OMB, with source and configuration linked below.</p>
      {!openmessaging && <p class="mt-4 text-gray-300">No complete OpenMessaging run has been published yet.</p>}
      {openmessaging && <a href="#charts" class="mt-6 mr-6 inline-block text-sm font-semibold text-krab-400 underline underline-offset-4">Explore the charts</a>}
      {direct && <a href="#openmessaging-direct" class="mt-6 mr-6 inline-block text-sm font-semibold text-krab-400 underline underline-offset-4">Compare with Redpanda using direct I/O</a>}
      <a href={getPath('/benchmarks/explorer')} class="mt-6 mr-6 inline-block text-sm font-semibold text-krab-400 underline underline-offset-4">Explore every captured sample</a>
      <a href="#methodology" class="mt-6 inline-block text-sm font-semibold text-krab-400 underline underline-offset-4">Methodology and reproduction</a>
    </header>
    <div class="mt-10"><BenchmarkOverview /><BenchmarkMatrix /></div>

    {openmessaging && (
      <section id="openmessaging" aria-labelledby="openmessaging-heading" class="mt-16 scroll-mt-24">
        <h2 id="openmessaging-heading" class="text-2xl font-bold text-white sm:text-3xl">OpenMessaging Benchmark</h2>
        <div class="mt-4 max-w-4xl space-y-3 text-sm text-gray-300 leading-relaxed [overflow-wrap:anywhere]">
          <p>
            The upstream <a href="https://openmessaging.cloud/docs/benchmarks/" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">OpenMessaging Benchmark</a> workloads, run by its Kafka driver and Kafka {openmessaging.provenance.openmessaging?.kafka_client_version ?? '3.6.1'} client against every broker:
            {openmessaging.images.map((image, i) => <>{i ? (i === openmessaging.images.length - 1 ? ', and ' : ', ') : ' '}{image.label}</>)}.
            {(openmessaging.provenance.openmessaging?.patches && Object.keys(openmessaging.provenance.openmessaging.patches).length)
              ? <>The driver carries one patch, applied identically to every broker, that keeps at most one offset commit in flight, as Redpanda's fork of the benchmark does. </>
              : null}
            {ombSameHost
              ? <>All trials ran on one {openmessaging.provenance.host.cpu_model} host with {openmessaging.provenance.host.logical_cpus} logical CPUs, the brokers one at a time,</>
              : <>Each workload and replication factor ran as its own shard on a {openmessaging.provenance.host.logical_cpus}-vCPU machine ({openmessaging.provenance.shards.length} shards), the brokers one at a time on that machine,</>}
            with fresh storage per trial, four CPUs and 10 GiB per broker, and a separate client.
            {ombDerived.length > 0 && <>The run merges {openmessaging.provenance.shards.length} invocations; {ombDerived.map(s => `RF${s.derived_from.replication_factor}${s.derived_from.workloads ? ` (${s.derived_from.workloads.length} workloads)` : ''}`).join(' and ')} came from {ombDerived.length === 1 ? 'an invocation' : 'invocations'} that did not finish cleanly, keeping only workloads whose trials had all completed and passed; anything left out was rerun for all three brokers{openmessaging.omitted.length > 0 && ', except the trials listed as not measured below'}. Each shard's source run and reason are in the provenance. </>}
            {openmessaging.omitted.map(o => <>{openmessaging.images.find(image => image.id === o.vendor).name} was not measured on {o.workload} at RF{o.rf}: {o.reason} </>)}
            {ombRetriable > 0 && <>{ombRetriable} offset {ombRetriable === 1 ? 'commit' : 'commits'} failed with a retriable error after a leader or coordinator move and {ombRetriable === 1 ? 'was' : 'were'} superseded by the next commit; these are counted, not failed. </>}
            Run {openmessaging.provenance.run_id}, completed <time datetime={ombCompleted}>{ombCompleted.slice(0, 10)}</time>; {openmessaging.provenance.repetitions === 1 ? 'one round' : openmessaging.provenance.repetitions + ' rounds (medians shown)'} per workload.
          </p>
          <p>
            Writes are buffered: Kafka and krabka acknowledge in-sync replication with <code>acks=all</code>; Redpanda acknowledges a Raft majority with <code>write.caching=true</code>. This does not establish equal crash durability.
            OMB reports rates and latency, not exact delivery or duplicate checks. Backlog workloads fill a 100 GB backlog before consumers drain it, so their end-to-end latency includes that wait.
            CPU and memory windows include client startup, warm-up, rate probing, measurement and shutdown. Results apply only to this runner, these images and these workloads.
          </p>
          {direct && <p>Krabka writes its segments through the Linux page cache in this run. Redpanda writes with <code>O_DIRECT</code>, so the comparison with Redpanda uses <a href="#openmessaging-direct" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">a separate run with Krabka's direct I/O</a>.</p>}
        </div>
        <OpenMessagingCharts />
        {openmessaging.rows.map(group => (
          <div class="mt-8">
            <h3 class="text-lg font-semibold text-white">Replication factor {group.rf}</h3>
            <div class="relative mt-3 overflow-x-auto rounded-xl border border-white/10">
              <table class="w-full min-w-[46rem] text-left text-xs" aria-label={`Mean publish rate and end-to-end p99 latency per broker, RF${group.rf}`}>
                <thead class="bg-slate-950/60 text-gray-400">
                  <tr>
                    <th scope="col" rowspan="2" class="px-3 py-2 font-semibold">Workload</th>
                    <th scope="col" rowspan="2" class="px-3 py-2 font-semibold text-right">Offered</th>
                    {openmessaging.images.map(image => <th scope="colgroup" colspan="2" class="px-3 pt-2 font-semibold text-center text-white">{image.name}</th>)}
                  </tr>
                  <tr>
                    {openmessaging.images.map(() => <><th scope="col" class="px-3 pb-2 font-normal text-right">msg/s</th><th scope="col" class="px-3 pb-2 font-normal text-right">E2E p99</th></>)}
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5 text-gray-300">
                  {group.cases.map(workload => (
                    <tr>
                      <th scope="row" class="px-3 py-2 font-mono font-normal text-gray-200 whitespace-nowrap"><BenchmarkHint workload={workload} rf={group.rf} label={workload.id} /></th>
                      <td class="px-3 py-2 text-right whitespace-nowrap">{offered(workload.config.producerRate)}</td>
                      {workload.vendors.map(v => <><td class="px-3 py-2 text-right tabular-nums">{v.omitted ? <span title={v.omitted}>not measured</span> : format(v.publish_rate)}</td><td class="px-3 py-2 text-right tabular-nums whitespace-nowrap">{latency(v.end_to_end_p99_ms)}</td></>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
        <details class="frosted-card rounded-2xl mt-6 p-5 sm:p-6">
          <summary class="cursor-pointer font-semibold text-white hover:text-krab-400">Publish p99 and pinned images</summary>
          {openmessaging.rows.map(group => (
            <div class="relative mt-5 overflow-x-auto">
              <table class="w-full min-w-[32rem] text-left text-xs">
                <caption class="text-left font-semibold text-white pb-2">RF{group.rf}: publish p99 latency</caption>
                <thead class="text-gray-400"><tr><th scope="col" class="px-3 py-2">Workload</th>{openmessaging.images.map(image => <th scope="col" class="px-3 py-2 text-right">{image.name}</th>)}</tr></thead>
                <tbody class="divide-y divide-white/5 text-gray-300">
                  {group.cases.map(workload => <tr>
                    <th scope="row" class="px-3 py-2 font-mono font-normal text-gray-200 whitespace-nowrap"><BenchmarkHint workload={workload} rf={group.rf} label={workload.id} /></th>
                    {workload.vendors.map(v => <td class="px-3 py-2 text-right tabular-nums whitespace-nowrap">{latency(v.publish_p99_ms)}</td>)}
                  </tr>)}
                </tbody>
              </table>
            </div>
          ))}
          <dl class="mt-6 space-y-4 text-sm">
            {openmessaging.images.map(image => <div>
              <dt class="font-semibold text-white [overflow-wrap:anywhere]">{image.label}</dt>
              <dd class="mt-1 font-mono text-xs text-gray-300 break-all">{image.requested}</dd>
              <dd class="mt-1 font-mono text-xs text-gray-400 break-all">{image.reference}</dd>
            </div>)}
          </dl>
          <p class="mt-5 text-sm text-gray-300">The <a href={openmessaging.summaryURL} class="text-krab-400 underline underline-offset-4 hover:text-krab-300">run summary</a> lists every trial, and the <a href={openmessaging.provenanceURL} class="text-krab-400 underline underline-offset-4 hover:text-krab-300">provenance</a> records the host, CPU sets, OMB commit, client jar hashes and effective driver settings.</p>
        </details>
      </section>
    )}

    {direct && (
      <section id="openmessaging-direct" aria-labelledby="openmessaging-direct-heading" class="mt-16 scroll-mt-24">
        <h2 id="openmessaging-direct-heading" class="text-2xl font-bold text-white sm:text-3xl">Krabka with direct I/O compared with Redpanda</h2>
        <div class="mt-4 max-w-4xl space-y-3 text-sm text-gray-300 leading-relaxed [overflow-wrap:anywhere]">
          <p>
            Redpanda writes its log segments with <code>O_DIRECT</code>, which bypasses the Linux page cache. For the comparison with Redpanda, a separate full run sets <code>preallocate=true</code> on Krabka's benchmark topics. Krabka then preallocates its segments and writes them with <code>O_DIRECT</code>. In every Krabka trial, the runner checked that the brokers held their active segments open with <code>O_DIRECT</code>.
            {directSummary && <>Across {directSummary.count} max-rate workload and replication-factor pairs, Krabka's median throughput (the lower of each workload's publish and consume rates) was {percent(directSummary.throughput)} of Redpanda's, with a range of {percent(directSummary.min)} to {percent(directSummary.max)}. </>}
          </p>
          <p>
            The run used the upstream OMB workloads and Kafka {direct.provenance.openmessaging?.kafka_client_version ?? '3.6.1'} client against {directBrokers.map(image => image.label).join(' and ')}.
            {directSameHost
              ? <>All trials ran on one {direct.provenance.host.cpu_model} host with {direct.provenance.host.logical_cpus} logical CPUs, the brokers one at a time,</>
              : <>Each workload and replication factor ran as its own shard on a {direct.provenance.host.logical_cpus}-vCPU machine ({directShards.length} shards), the brokers one at a time on that machine,</>}
            with fresh storage per trial, four CPUs and 10 GiB per broker, and a separate client.
            {direct.omitted.filter(o => o.vendor !== 'kafka').map(o => <>{direct.images.find(image => image.id === o.vendor).name} was not measured on {o.workload} at RF{o.rf}: {o.reason} </>)}
            Run {direct.provenance.run_id}, completed <time datetime={directCompleted}>{directCompleted.slice(0, 10)}</time>; {direct.provenance.repetitions === 1 ? 'one round' : direct.provenance.repetitions + ' rounds (medians shown)'} per workload.
            Apache Kafka also ran in this run with its usual page-cache writes; its results are in the run summary.
          </p>
          <p>
            Krabka acknowledges in-sync replication with <code>acks=all</code>; Redpanda acknowledges a Raft majority with <code>write.caching=true</code>. This does not establish equal crash durability.
            Results apply only to this runner, these images and these workloads.
          </p>
        </div>
        {direct.rows.map(group => (
          <div class="mt-8">
            <h3 class="text-lg font-semibold text-white">Direct I/O, replication factor {group.rf}</h3>
            <div class="relative mt-3 overflow-x-auto rounded-xl border border-white/10">
              <table class="w-full min-w-[40rem] text-left text-xs" aria-label={`Mean publish rate and end-to-end p99 latency for Krabka with direct I/O and Redpanda, RF${group.rf}`}>
                <thead class="bg-slate-950/60 text-gray-400">
                  <tr>
                    <th scope="col" rowspan="2" class="px-3 py-2 font-semibold">Workload</th>
                    <th scope="col" rowspan="2" class="px-3 py-2 font-semibold text-right">Offered</th>
                    {directBrokers.map(image => <th scope="colgroup" colspan="2" class="px-3 pt-2 font-semibold text-center text-white">{image.name}</th>)}
                  </tr>
                  <tr>
                    {directBrokers.map(() => <><th scope="col" class="px-3 pb-2 font-normal text-right">msg/s</th><th scope="col" class="px-3 pb-2 font-normal text-right">E2E p99</th></>)}
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5 text-gray-300">
                  {group.cases.map(workload => (
                    <tr>
                      <th scope="row" class="px-3 py-2 font-mono font-normal text-gray-200 whitespace-nowrap"><BenchmarkHint workload={workload} rf={group.rf} label={workload.id} /></th>
                      <td class="px-3 py-2 text-right whitespace-nowrap">{offered(workload.config.producerRate)}</td>
                      {workload.vendors.filter(v => v.id !== 'kafka').map(v => <><td class="px-3 py-2 text-right tabular-nums">{v.omitted ? <span title={v.omitted}>not measured</span> : format(v.publish_rate)}</td><td class="px-3 py-2 text-right tabular-nums whitespace-nowrap">{latency(v.end_to_end_p99_ms)}</td></>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
        <p class="mt-5 text-sm text-gray-300">The <a href={direct.summaryURL} class="text-krab-400 underline underline-offset-4 hover:text-krab-300">direct I/O run summary</a> lists every trial, and its <a href={direct.provenanceURL} class="text-krab-400 underline underline-offset-4 hover:text-krab-300">provenance</a> records the host, image digests, OMB commit and Krabka's storage setting.</p>
      </section>
    )}

    <section id="methodology" aria-labelledby="methodology-heading" class="mt-16 scroll-mt-24 max-w-4xl">
      <h2 id="methodology-heading" class="text-2xl font-bold text-white sm:text-3xl">Methodology and resource settings</h2>
      <p class="mt-4 text-sm text-gray-300 leading-relaxed">Full runs preserve the upstream workload payloads, partition counts, offered rates, backlog sizes, and durations. The pinned OMB commit, driver patch, immutable broker images, host resources, and effective configurations are recorded in each run’s provenance. Smoke runs are wiring checks and cannot supply website figures.</p>
      <p class="mt-4 text-sm text-gray-300 leading-relaxed">Publish rates are means of OMB’s measurement intervals; p99 latency comes from OMB’s aggregate latency results. When a run has multiple rounds, the tables show medians across those rounds.</p>
    </section>

    <section id="direct-io-qualification" aria-labelledby="qualification-heading" class="mt-14 scroll-mt-24 max-w-4xl border-t border-white/10 pt-8">
      <p class="text-sm font-semibold text-krab-400">Proposed release gate · not yet automated</p>
      <h2 id="qualification-heading" class="mt-3 text-2xl font-bold text-white">Qualify direct I/O before a release</h2>
      <p class="mt-4 text-gray-300">The two reported rounds do not qualify a release. This plan tests each candidate against the previous release and the comparison brokers.</p>
      <ol class="mt-5 list-decimal space-y-4 pl-5 text-sm leading-relaxed text-gray-300">
        <li><strong class="text-white">Pin the comparison.</strong> Use immutable images for the candidate, previous release, Kafka and Redpanda. Record the OMB commit, hardware, kernel, filesystem and driver settings.</li>
        <li><strong class="text-white">Run both write modes.</strong> Run the full OMB catalog at RF1 and RF3, with krabka’s default settings and with <code>preallocate=true</code>. Verify <code>O_DIRECT</code> on open segment descriptors. Record fallback as a failed direct-mode qualification.</li>
        <li><strong class="text-white">Control disk state and repeat.</strong> Trim before every trial, confirm free space and use fresh clusters. Run at least five measured rounds per configuration. Rotate broker order across rounds. Keep ext4 and XFS results separate.</li>
        <li><strong class="text-white">Review the distributions.</strong> Publish every round, median and range for throughput, publish and end-to-end p99 and p99.9. Align CPU and device telemetry with measurement intervals. Keep full-capture totals separate.</li>
        <li><strong class="text-white">Check correctness and recovery.</strong> Check acknowledged records after process termination, leader failover, restart and disk-full errors. Include retention, segment roll, compaction and catch-up reads. Test host power loss separately before a power-loss durability claim.</li>
        <li><strong class="text-white">Make a recorded release decision.</strong> Set workload budgets before the run. Proposed review triggers are a throughput drop above 5% or a p99 or CPU-cost increase above 10% against the previous release in the same mode. Repeat flagged pairs; do not claim statistical significance from these thresholds. Block qualification for correctness failures, missing required trials or unresolved regressions.</li>
      </ol>
      <p class="mt-5 text-sm text-gray-400">Publish direct-mode results separately from the default-mode suite. Archive raw OMB files, measurement timestamps, resource samples and all failed trials. A release note must state any qualification gap.</p>
      <a href={methodologyURL + '#direct-io-release-qualification-plan'} class="mt-5 inline-block text-sm font-semibold text-krab-400 underline underline-offset-4">Read the qualification protocol</a>
    </section>

    <section aria-labelledby="repeat-heading" class="mt-14 max-w-4xl">
      <h2 id="repeat-heading" class="text-2xl font-bold text-white">Repeat the comparison</h2>
      <p class="mt-3 mb-5 text-sm text-gray-300 leading-relaxed">From this website repository, use Node 22.12 or later, JDK 17 or later, and native Linux/amd64 with local Docker. Check the benchmark instructions for resource requirements and deadlines.</p>
      <CodeBlock code={repeat} lang="bash" />
      <p class="mt-5 text-sm text-gray-300">See the <a href={methodologyURL} class="text-krab-400 underline underline-offset-4 hover:text-krab-300">benchmark instructions</a> for the upstream catalog, resource requirements, and publication checks.</p>
    </section>
  </div>
</BaseLayout>
