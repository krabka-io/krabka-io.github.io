---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPath } from '../utils/paths';
---

<BaseLayout
  title="404 — Page Not Found | Krabka"
  description="The requested page could not be found on the Krabka documentation hub."
>
  <div class="min-h-[60vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-md w-full text-center space-y-6">
      <div class="font-mono text-5xl font-extrabold text-krab-500">404</div>
      <h1 class="text-2xl font-bold text-white sm:text-3xl">Page Not Found</h1>
      <p class="text-sm text-gray-400 leading-relaxed">
        The page you are looking for may have been moved, renamed, or is currently being authored.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={getPath('/docs')}
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg bg-krab-500 px-4 py-2.5 text-xs font-semibold text-white shadow hover:bg-krab-600 transition-colors"
        >
          Documentation Hub
        </a>
        <a
          href={getPath('/api')}
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-xs font-semibold text-gray-300 hover:text-white hover:bg-white/10 transition-colors"
        >
          API Directory
        </a>
        <a
          href={getPath('/')}
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-xs font-semibold text-gray-300 hover:text-white hover:bg-white/10 transition-colors"
        >
          Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
