---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPath } from '../utils/paths';
---

<BaseLayout
  title="Page not found | krabka"
  description="This page does not exist on krabka.io."
  noindex
>
  <div class="min-h-[60vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-md w-full text-center space-y-6">
      <div class="font-mono text-5xl font-extrabold text-krab-500">404</div>
      <h1 class="text-2xl font-bold text-white sm:text-3xl">Page not found</h1>
      <p class="text-sm text-gray-400 leading-relaxed">
        Nothing lives at this address. The page may have moved; try searching for it, or start from the docs.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={getPath('/search')} class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-xs font-semibold text-gray-300 hover:text-white hover:bg-white/10 transition-colors">Search the site</a>
        <a
          href={getPath('/docs')}
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg bg-krab-600 px-4 py-2.5 text-xs font-semibold text-white shadow hover:bg-krab-700 transition-colors"
        >
          Documentation
        </a>
        <a
          href={getPath('/api')}
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-xs font-semibold text-gray-300 hover:text-white hover:bg-white/10 transition-colors"
        >
          API reference
        </a>
        <a
          href={getPath('/')}
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-xs font-semibold text-gray-300 hover:text-white hover:bg-white/10 transition-colors"
        >
          Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
