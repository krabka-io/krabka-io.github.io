---
import DocsLayout from '../../layouts/DocsLayout.astro';

const brokerCrates = [
  { name: 'crabka-broker', desc: 'Request handlers, coordinators, partition replication, quotas, server binary' },
  { name: 'crabka-raft', desc: 'KRaft consensus engine implementing KIP-595 wire RPC protocol' },
  { name: 'crabka-kraft-core', desc: 'Shared KRaft record types and quorum state machine' },
  { name: 'crabka-log', desc: 'On-disk write-ahead log: segments, index files, compaction, retention' },
  { name: 'crabka-remote-storage', desc: 'Tiered-storage reader and cloud object storage offloader' },
  { name: 'crabka-remote-storage-topic', desc: 'The __remote_log_metadata topic-backed RLMM' },
  { name: 'crabka-authz', desc: 'Authorizer traits, ACL evaluations, and OPA client' },
  { name: 'crabka-audit', desc: 'Security audit events, OCSF serialization, and verify CLI' },
  { name: 'crabka-format', desc: 'Formats fresh log directory: meta.properties.json and VotersRecord' },
  { name: 'crabka-telemetry', desc: 'OTLP pipeline, Prometheus metrics, and pprof debug endpoints' },
];
---

<DocsLayout
  title="Broker Engine"
  description="Deep dive into the Krabka broker subsystems, request handling pipeline, and log engine."
  currentSlug="/docs/broker"
>
  <div class="space-y-6">
    <div class="border-b border-white/10 pb-4">
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Broker Engine</h1>
      <p class="text-gray-400 mt-2 text-base">
        The core streaming broker: request pipelines, write-ahead logs, coordinators, and consensus via <code class="text-krab-300 font-mono text-xs">krabka-broker</code> and <code class="text-krab-300 font-mono text-xs">crabka-log</code>.
      </p>
    </div>

    <div class="space-y-6 text-sm text-gray-300">
      <p>
        The <code class="font-mono text-krab-300">krabka-broker</code> repository contains the primary broker binary and supporting crate subsystems:
      </p>

      <div class="frosted-card rounded-xl overflow-hidden border border-white/10">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/80 border-b border-white/10 uppercase text-gray-400 font-sans">
            <tr>
              <th class="py-3 px-4">Crate</th>
              <th class="py-3 px-4">Purpose & Subsystem</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 font-sans">
            {brokerCrates.map((c) => (
              <tr class="hover:bg-white/5 transition-colors">
                <td class="py-3 px-4 font-mono font-bold text-krab-300">{c.name}</td>
                <td class="py-3 px-4 text-gray-300">{c.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</DocsLayout>
