---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPath } from '../../utils/paths';
import sessions from '../../data/proof-sessions.json';
import '../../styles/proofs.css';

const { source, totals } = sessions;
const formatCount = (n: number) => n.toLocaleString('en-US');
const formatSeconds = (s: number) => `${s.toFixed(1)} s`;

// The explorer reads the sessions from the page. Derived Clone impls, which carry no obligations of
// their own, ship without an obligations list; the Coma text itself is fetched
// on demand from /proofs/coma/<id>.coma.
const embedded = sessions.sessions.map((s) => {
  const { obligations, ...rest } = s;
  if (s.kind === 'derived') return rest;
  return {
    ...rest,
    obligations,
  };
});
// `<` is escaped so no field can end the JSON script block early.
const sessionsJson = JSON.stringify({ source, sessions: embedded }).replace(/</g, '\\u003c');

const proverList = Object.entries(totals.provers)
  .sort((a, b) => b[1] - a[1])
  .map(([p, n]) => `${p} ${formatCount(n)}`)
  .join(', ');
const nonDerived = totals.sessions - (totals.kinds.derived ?? 0);

const facts: { value: string; label: string }[] = [
  { value: formatCount(totals.sessions), label: `proof sessions (${formatCount(nonDerived)} beyond derived Clone impls)` },
  { value: formatCount(totals.leaves), label: 'prover leaves' },
  { value: String(Object.keys(totals.provers).length), label: `provers: ${proverList}` },
  { value: formatSeconds(totals.time), label: 'recorded prover time' },
  { value: formatCount(totals.obligations), label: 'obligations' },
];

const why3find = source.why3find;
const commitShort = source.commit.slice(0, 12);
const commitUrl = `https://github.com/${source.repo}/tree/${source.commit}/verif/krabka_verified_rlib`;
---

<BaseLayout
  title="Proof Explorer | krabka Documentation"
  description="Browse the Why3 proof sessions of krabka's Creusot-verified kernels, tactic by tactic and prover by prover, and re-check one in the browser with Alt-Ergo, Z3, cvc5, and CVC4."
>
  <!-- The explorer is an app, so it takes the window: a compact header above it, the guide below. -->
  <header class="mx-auto max-w-[120rem] px-4 pb-3 pt-5 font-sans sm:px-6 lg:px-8">
    <!-- A flex row, like the docs layout's: the links pad out to a 28px hit area without growing the row. -->
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-xs text-gray-400">
      <a href={getPath('/')} class="-my-1.5 py-1.5 hover:text-white">Home</a>
      <span aria-hidden="true">/</span>
      <a href={getPath('/docs')} class="-my-1.5 py-1.5 hover:text-white">Docs</a>
      <span aria-hidden="true">/</span>
      <span class="text-gray-200" aria-current="page">Proof Explorer</span>
    </nav>
    <div class="mt-1 flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <h1 class="text-2xl font-extrabold text-white">Proof Explorer</h1>
      <p class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-xs text-gray-400 [overflow-wrap:anywhere]" role="group" aria-label="Proof figures">
        {facts.map((fact) => (
          <span><span class="font-semibold text-white tabular-nums">{fact.value}</span> {fact.label}</span>
        ))}
      </p>
    </div>
  </header>

    <script type="application/json" id="proof-sessions" is:inline set:html={sessionsJson}></script>
  <div id="krabka-proofs" class="not-prose" data-base={getPath('/').replace(/\/$/, '')}>
      <p class="px-fallback" role="status">
        Loading the proof explorer. This panel needs JavaScript. If it does not appear, your browser may have
        it disabled.
      </p>
    </div>


  <div class="mx-auto max-w-4xl space-y-6 px-4 py-10 font-sans sm:px-6">
    <p class="text-gray-400 text-sm leading-relaxed">
      The recorded proofs of <code class="font-mono text-krab-300">krabka-verified</code> at broker
      commit <a href={commitUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-krab-400 hover:text-krab-300">{commitShort}</a>,
      one session per function, with the browser re-check when the build carries Why3 and the browser provers.
    </p>

    <div class="grid gap-4 xl:grid-cols-2 xl:gap-8 text-sm text-gray-300 leading-relaxed [overflow-wrap:anywhere]">
      <p>
        A <strong class="text-white">session</strong> is what why3find records when it proves one function.
        <a href="https://creusot.rs/" target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Creusot</a> translates the Rust into a Coma program, <a href="https://why3.org/" target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Why3</a> derives one verification condition per <code class="font-mono text-krab-300">vc_</code> goal, and why3find tries the configured provers on each
        goal, splitting it with <code class="font-mono text-krab-300">split_vc</code> or normalising it
        with <code class="font-mono text-krab-300">compute_specified</code> when no prover discharges it whole. The
        session stores that tree: per goal, which tactic split it, and for each leaf which prover proved it and
        in how many seconds. The explorer shows the trees as recorded in the repository.
      </p>
      <p>
        An <strong class="text-white">obligation</strong> is one condition inside a goal, named by
        the <code class="font-mono text-krab-300">[@expl]</code> label Creusot attaches when it generates it: a
        precondition at a call site, a postcondition at a return, a loop invariant on entry and after each
        iteration, an integer overflow, a division by zero, an index in bounds. Each label carries the Rust
        source span it came from, so every row below links to the line the condition is about.
      </p>
    </div>


    <h2 id="sessions" class="text-xl font-bold text-white pt-2">Proof sessions</h2>
    <p class="text-sm text-gray-400 -mt-2 [overflow-wrap:anywhere]">
      Kernels are the decision functions the broker calls, helpers and lemmas support their proofs, and derived
      impls are the {formatCount(totals.kinds.derived ?? 0)} <code class="font-mono text-krab-300">Clone</code> implementations Creusot
      proves alongside; those are hidden until you turn the chip on. Pick a session for its proof tree, its
      obligations, the generated Coma, and the browser re-check. A link of the
      form <code class="font-mono text-krab-300">#session=module/name</code> opens a session directly.
    </p>


    <div class="rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3 text-xs leading-relaxed text-gray-400 space-y-2 [overflow-wrap:anywhere] not-prose">
      <p>
        <span class="font-semibold text-gray-200">Toolchain.</span> Creusot {source.creusot};
        why3find with provers <code class="font-mono text-gray-300">{why3find.provers.join(', ')}</code>,
        tactics <code class="font-mono text-gray-300">{why3find.tactics.join(', ')}</code>, time
        limit {why3find.time} s per prover call (fast path {why3find.fast} s), split depth {why3find.depth}.
        Sessions synced from <a href={commitUrl} target="_blank" rel="noopener noreferrer" class="text-krab-400 hover:text-krab-300">{source.repo}@{commitShort}</a> on {source.synced_at.slice(0, 10)}.
      </p>
      <p>
        <span class="font-semibold text-gray-200">What this page can and cannot do.</span> The sessions are the
        repository's recorded proofs, shown as why3find stored them; nothing here re-derives them. The browser
        re-check, when the build includes it, replays the recorded tactics through Why3 and sends each
        supported leaf to its recorded prover: Alt-Ergo in JavaScript, or Z3, cvc5 and CVC4 in WebAssembly.
        These use the solver versions pinned by Creusot and Why3's prover-specific SMT-LIB drivers.
        Z3 enables shared memory with a one-time page reload and resumes the check. A browser timeout
        does not invalidate the recorded proof: browser performance and budgets differ from native CI.
      </p>
    </div>

    <div class="space-y-4 text-sm text-gray-300 leading-relaxed">
      <h2 class="text-xl font-bold text-white pt-2">Related Resources</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose pt-1">
        <a href={getPath('/docs/verification-playground')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Verification Playground →</div>
          <p class="text-xs text-gray-400 mt-1">Run the proved kernels in WebAssembly and read each kernel's ledger row.</p>
        </a>
        <a href={getPath('/verification')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Correctness & Verification →</div>
          <p class="text-xs text-gray-400 mt-1">Safe Rust, Creusot proofs, Stateright models, and where the formal boundary ends.</p>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script src={getPath('/proofs/explorer.js')} type="module" is:inline></script>
