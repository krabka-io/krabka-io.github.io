      ['Ecosystem compatibility', 'https://github.com/krabka-io/krabka-broker/releases/download/v0.5.4/milestone-20-m19-final.tar.gz'],
      ['Go Apache/Krabka reference matrix', 'https://github.com/krabka-io/krabka-streams-go/actions/runs/34361055012'],
      ['Java Apache/Krabka reference matrix', 'https://github.com/krabka-io/krabka-streams-java/actions/runs/34361081564'],
    ],
  },
  {
