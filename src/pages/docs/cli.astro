---
import DocsLayout from '../../layouts/DocsLayout.astro';

const cliCode = `# Format a fresh cluster directory
krabka-broker format --log-dir /var/lib/krabka --cluster-id krabka-local-01 --node-id 1

# Start the broker daemon
krabka-broker run --config ./krabka.toml`;
---

<DocsLayout
  title="CLI Tooling"
  description="Command-line interface and administration tools for Krabka clusters (krabka-cli)."
  currentSlug="/docs/cli"
>
  <div class="space-y-6">
    <div class="border-b border-white/10 pb-4">
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">CLI Tooling</h1>
      <p class="text-gray-400 mt-2 text-base">
        Operator utilities for formatting, cluster health checks, and plugin management via <code class="text-krab-300 font-mono text-xs">krabka-cli</code>.
      </p>
    </div>

    <div class="space-y-6 text-sm text-gray-300">
      <div class="bg-black/50 p-4 rounded-xl border border-white/5 relative font-mono text-xs">
        <div class="flex justify-between items-center text-gray-400 mb-2 font-sans">
          <span>Common CLI Workflows:</span>
          <button type="button" class="copy-btn flex items-center gap-1 rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-all font-sans" data-copy={cliCode}>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            <span>Copy</span>
          </button>
        </div>
        <pre class="text-krab-300 overflow-x-auto"><code>{cliCode}</code></pre>
      </div>
    </div>
  </div>
</DocsLayout>
