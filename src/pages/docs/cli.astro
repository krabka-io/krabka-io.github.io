---
import CodeBlock from '../../components/CodeBlock.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getPath } from '../../utils/paths';

const formatCode = `# Format a fresh broker log directory as a standalone KRaft controller
krabka format --log-dir /var/lib/krabka --standalone --node-id 1 --controller-listener localhost:9093

# Format with pre-seeded SCRAM credentials and finalized feature levels (KIP-1022)
krabka format --log-dir /var/lib/krabka \\
  --standalone \\
  --node-id 1 \\
  --controller-listener localhost:9093 \\
  --add-scram 'SCRAM-SHA-256=[name=admin,password=secret]' \\
  --feature 'transaction.version=2'`;

const adminCode = `# Built-in admin commands use the JVM tools' flag names
krabka topics --bootstrap-server localhost:9092 --create --topic orders \\
  --partitions 3 --replication-factor 1
krabka topics --bootstrap-server localhost:9092 --list
krabka topics --bootstrap-server localhost:9092 --create --topic orders --dry-run

# Machine-readable output and a deadline for the whole command
krabka --output json topics --bootstrap-server localhost:9092 --list --timeout 10s`;

const pluginCode = `# Plugin subcommands are resolved from PATH as krabka-<name>

# Point-in-time restore from tiered-storage archive (resolved to the krabka-restore binary on PATH)
krabka restore \\
  --archive-local /mnt/backups/s3-archive \\
  --log-dir /var/lib/krabka-restored \\
  --standalone --node-id 1 --controller-listener localhost:9093

# Validate an archive without writing the target
krabka restore --archive-local /mnt/backups/s3-archive --log-dir /tmp/check \\
  --standalone --node-id 1 --controller-listener localhost:9093 --dry-run

# Any krabka-<name> binary on PATH, including tools from the broader Krabka ecosystem
krabka <name> --help`;
---

<DocsLayout
  title="Cluster Administration & Operator CLI (krabka-cli)"
  description="Command-line interface, cluster log formatting (krabka format), and plugin architecture for Krabka clusters."
  currentSlug="/docs/cli"
>
  <div class="space-y-6 font-sans">
    <div class="border-b border-white/10 pb-4">
      <div class="text-xs text-gray-400 mb-1">
        Admin Tooling · Developer Preview
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Cluster Administration & CLI</h1>
      <p class="text-gray-400 mt-2 text-sm max-w-2xl leading-relaxed">
        The operator command-line interface (<code class="text-krab-300 font-mono text-xs">krabka</code>): log directory formatting, bootstrap record generation, and decoupled plugin delegation.
      </p>
    </div>

    <div class="space-y-6 text-sm text-gray-300 leading-relaxed">
      <div class="p-3.5 rounded-lg bg-amber-500/10 border border-amber-500/20 text-xs text-amber-300 leading-relaxed">
        <strong class="font-semibold text-amber-200">Developer Preview Notice:</strong>
        <code class="font-mono text-amber-200">krabka-cli</code> is under active development. The built-in commands cover log formatting, topic, config, ACL, consumer-group, feature and partition-reassignment administration, and the Gres tenant registry. Backup, barrier, guard, restore and the admin web UI run as separate plugin binaries.
      </div>

      <p>
        The Krabka operator CLI is published as the <code class="font-mono text-krab-300">krabka</code> binary. Rather than bundling every management tool into a monolithic executable, <code class="font-mono text-krab-300">krabka</code> compiles in log formatting and the everyday admin commands, and delegates specialized subcommands to decoupled plugins found on your <code class="font-mono text-xs text-gray-200">PATH</code>.
      </p>

      <h2 class="text-xl font-bold text-white pt-2">Built-in: Cluster Formatting</h2>
      <p>
        The built-in <code class="font-mono text-krab-300 text-xs">krabka format</code> command prepares a clean log directory before broker startup. It writes cluster UUID metadata to <code class="font-mono text-xs text-gray-200">meta.properties.json</code>, seeds the bootstrap <code class="font-mono text-xs text-gray-200">VotersRecord</code> for KRaft consensus, and optionally provisions bootstrap SCRAM credentials and feature levels.
      </p>

      <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3 not-prose">
        <div class="flex items-center justify-between text-xs text-gray-400">
          <span>Format Cluster Directory:</span>
          <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={formatCode}>
            Copy
          </button>
        </div>
        <CodeBlock code={formatCode} lang="bash" />
      </div>

      <h2 class="text-xl font-bold text-white pt-2">Built-in: Admin Commands</h2>
      <p>
        The other compiled-in subcommands are <code class="font-mono text-krab-300 text-xs">topics</code>, <code class="font-mono text-krab-300 text-xs">configs</code>, <code class="font-mono text-krab-300 text-xs">acls</code>, <code class="font-mono text-krab-300 text-xs">consumer-groups</code>, <code class="font-mono text-krab-300 text-xs">features</code>, <code class="font-mono text-krab-300 text-xs">reassign-partitions</code> and <code class="font-mono text-krab-300 text-xs">gres</code> (the Gres tenant registry and range layout). They connect with <code class="font-mono text-xs text-gray-200">--bootstrap-server</code> or <code class="font-mono text-xs text-gray-200">--bootstrap-controller</code> (or <code class="font-mono text-xs text-gray-200">KRABKA_BOOTSTRAP_SERVER</code>), and accept <code class="font-mono text-xs text-gray-200">--command-config</code> as the JVM tools do. Run <code class="font-mono text-xs text-gray-200">krabka &lt;subcommand&gt; --help</code> for the flags of each.
      </p>

      <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3 not-prose">
        <div class="flex items-center justify-between text-xs text-gray-400">
          <span>Topic administration:</span>
          <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={adminCode}>
            Copy
          </button>
        </div>
        <CodeBlock code={adminCode} lang="bash" />
      </div>

      <h2 class="text-xl font-bold text-white pt-2">Plugin Architecture</h2>
      <p>
        Subcommands outside the core bootstrap flow are dispatched dynamically to standalone plugin executables following the convention established by <code class="font-mono text-xs text-gray-200">git</code> and <code class="font-mono text-xs text-gray-200">cargo</code>. When an unrecognised subcommand <code class="font-mono text-xs text-gray-200">krabka &lt;subcommand&gt;</code> is invoked, the CLI searches <code class="font-mono text-xs text-gray-200">PATH</code> for <code class="font-mono text-krab-300 text-xs">krabka-&lt;subcommand&gt;</code>:
      </p>

      <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3 not-prose">
        <div class="flex items-center justify-between text-xs text-gray-400">
          <span>Plugin Subcommand Invocation:</span>
          <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={pluginCode}>
            Copy
          </button>
        </div>
        <CodeBlock code={pluginCode} lang="bash" />
      </div>

      <div class="frosted-card rounded-xl overflow-hidden border border-white/10 not-prose">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/80 border-b border-white/10 uppercase text-gray-400 font-sans">
            <tr>
              <th class="py-3 px-4">Subcommand</th>
              <th class="py-3 px-4">Origin Repository</th>
              <th class="py-3 px-4">Execution Model</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 font-sans">
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300">krabka format</td>
              <td class="py-3 px-4 text-gray-400">krabka-cli (logic in the krabka-format crate of krabka-broker)</td>
              <td class="py-3 px-4 text-gray-300">Compiled-in built-in (always wins over PATH); also ships standalone as krabka-format</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300">krabka admin-ui</td>
              <td class="py-3 px-4 text-gray-400">krabka-cli</td>
              <td class="py-3 px-4 text-gray-300">Dispatched to the <code class="font-mono text-xs">krabka-admin-ui</code> web UI, built as a separate binary in the same repository</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300">krabka restore</td>
              <td class="py-3 px-4 text-gray-400">krabka-broker</td>
              <td class="py-3 px-4 text-gray-300">Dispatched to <code class="font-mono text-xs">krabka-restore</code> plugin</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300">krabka backup, barrier, guard</td>
              <td class="py-3 px-4 text-gray-400">krabka-broker</td>
              <td class="py-3 px-4 text-gray-300">Dispatched to the <code class="font-mono text-xs">krabka-backup</code>, <code class="font-mono text-xs">krabka-barrier</code> and <code class="font-mono text-xs">krabka-guard</code> plugins</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p>
        This decoupled architecture keeps domain-specific tools, including those from the broader Krabka ecosystem, out of the core CLI binary's dependency tree. A plugin that is not found on <code class="font-mono text-xs text-gray-200">PATH</code> exits with code 127; an unexecutable binary exits with 126.
      </p>

      <h2 class="text-xl font-bold text-white pt-2">Architectural Layering</h2>
      <p>
        <code class="font-mono text-krab-300">krabka-cli</code> sits atop four sibling repositories:
      </p>
      <ul class="space-y-2 text-sm text-gray-300 list-disc pl-5">
        <li><a href={getPath('/docs/architecture')} class="text-krab-400 hover:underline"><code class="font-mono text-krab-300">krabka-protocol</code></a>: Provides wire types, record codecs, security credentials, and unit types.</li>
        <li><a href="https://github.com/krabka-io/krabka-client-rs" target="_blank" rel="noopener noreferrer" class="text-krab-400 hover:underline"><code class="font-mono text-krab-300">krabka-client-rs</code></a>: Supplies the admin and core clients.</li>
        <li><a href={getPath('/docs/broker')} class="text-krab-400 hover:underline"><code class="font-mono text-krab-300">krabka-broker</code></a>: Supplies Raft and the bootstrap records that <code class="font-mono text-xs">format</code> writes.</li>
        <li><a href="https://github.com/krabka-io/gres" target="_blank" rel="noopener noreferrer" class="text-krab-400 hover:underline"><code class="font-mono text-krab-300">gres</code></a>: Supplies the Gres registry, range planning, and tenant provisioning behind <code class="font-mono text-xs">krabka gres</code>.</li>
      </ul>

      <h2 class="text-xl font-bold text-white pt-2">Related Resources</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose pt-1">
        <a href={getPath('/docs/quickstart')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Quickstart Guide →</div>
          <p class="text-xs text-gray-400 mt-1">Deploy a local broker using Docker Compose or Helm.</p>
        </a>
        <a href={getPath('/docs/runtime-architecture')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Runtime Architecture →</div>
          <p class="text-xs text-gray-400 mt-1">Operational topology, internal broker components, and control plane reconcile loops.</p>
        </a>
      </div>
    </div>
  </div>
</DocsLayout>
