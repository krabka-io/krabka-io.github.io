const sourceTree = `https://github.com/krabka-io/krabka-gateway/tree/${revision}`;
const install = `git clone https://github.com/krabka-io/krabka-gateway.git
cd krabka-gateway
git checkout ${revision}
cargo build --release -p krabka-gateway --bin krabka-gateway`;
const start = `KRABKA_BOOTSTRAP_SERVERS=127.0.0.1:9092 \\
KRABKA_GATEWAY_LISTEN_ADDR=127.0.0.1:9500 \\
KRABKA_GATEWAY_ADVERTISED_ADDR=127.0.0.1:9500 \\
./target/release/krabka-gateway

# In another terminal
curl --fail http://127.0.0.1:9500/healthz
curl --fail http://127.0.0.1:9500/readyz`;
const produce = `# Create the events topic before sending records.
curl --fail-with-body http://127.0.0.1:9500/v1/produce/events \\
  -H 'Content-Type: application/json' \\
  -H 'Idempotency-Key: example-delivery-1' \\
  --data-binary '{"message":"hello krabka"}'`;
const outbound = `[[allowed_targets]]
scheme = "https"
host = "hooks.example.com"

[[subscriptions]]
name = "events-delivery"
source_topics = ["events"]
target_url = "https://hooks.example.com/events"
dead_letter_topic = "events-delivery-dlq"
max_attempts = 5
base_backoff = "500ms"
max_backoff = "30s"
request_timeout = "10s"
content_mode = "cloud_events_structured"`;
