      ['client-dispatch-queue-capacity', 'KRABKA_GATEWAY_CLIENT_DISPATCH_QUEUE_CAPACITY', '64; must be positive'],
      ['client-frame-max', 'KRABKA_GATEWAY_CLIENT_FRAME_MAX', '100MiB; maximum 100MiB'],
    ],
  },
  {
