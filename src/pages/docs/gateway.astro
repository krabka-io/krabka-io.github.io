      ['produce-max-body', 'KRABKA_GATEWAY_PRODUCE_MAX_BODY', '2MiB; generic HTTP produce limit'],
      ['forward-max-body', 'KRABKA_GATEWAY_FORWARD_MAX_BODY', '2MiB; peer forwarding limit'],
      ['schema-registry-url', 'KRABKA_GATEWAY_SCHEMA_REGISTRY_URL', 'Unset; raw bytes pass through'],
      ['schema-registry-latest-cache-ttl', 'KRABKA_GATEWAY_SCHEMA_REGISTRY_LATEST_CACHE_TTL', '5s'],
