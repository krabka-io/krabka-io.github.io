      ['internal-topic-segment', 'KRABKA_GATEWAY_INTERNAL_TOPIC_SEGMENT', '1m'],
      ['internal-topic-min-cleanable-dirty-ratio', 'KRABKA_GATEWAY_INTERNAL_TOPIC_MIN_CLEANABLE_DIRTY_RATIO', '1%'],
      ['consumer-poll-timeout', 'KRABKA_GATEWAY_CONSUMER_POLL_TIMEOUT', '500ms'],
      ['ownership-warmup-empty-polls', 'KRABKA_GATEWAY_OWNERSHIP_WARMUP_EMPTY_POLLS', '2; must be positive'],
      ['readiness-poll-interval', 'KRABKA_GATEWAY_READINESS_POLL_INTERVAL', '250ms'],
