const guides = [
  ['reference', 'Repository guide', 'Builds, SDK toolchains, the protobuf contract, and conformance checks.'],
  ['cloudevents', 'CloudEvents', 'Binary and structured HTTP ingress, record headers, and outbound delivery.'],
  ['github-firehose', 'GitHub webhook firehose', 'Signed ingress and a Rust Streams application that preserves event payloads.'],
