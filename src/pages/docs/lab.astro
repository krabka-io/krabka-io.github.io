---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LabLink from '../../components/LabLink.astro'; // J3
import { getPath } from '../../utils/paths';
import '../../styles/lab.css';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import path from 'node:path';

// A module's content hash, for its URL: the lab's service worker keeps each
// version of a module once, so a deploy with a new build misses its cache.
// Empty when the module is not staged (the page then loads it uncached).
function wasmAsset(file: string) {
  try {
    const bytes = readFileSync(path.join(process.cwd(), 'public', 'playground', file));
    return { version: createHash('sha256').update(bytes).digest('hex').slice(0, 16), size: bytes.length };
  } catch {
    return {};
  }
}
const labWasm = wasmAsset('krabka_playground_bg.wasm');
const brokerWasm = wasmAsset('broker/krabka-broker.wasm');

const real = [
  { piece: 'The broker: request handlers, partition logs and replication, group coordinators, the KRaft quorum and metadata', crate: 'krabka-broker, krabka-raft, krabka-metadata', runs: 'a Web Worker', use: 'every broker node' },
  { piece: 'Kafka wire codec, every request and response, byte-exact', crate: 'krabka-protocol', runs: 'the brokers and the lab module', use: 'every frame a broker or client handles' },
  { piece: 'RecordBatch v2 codec with CRC-32C', crate: 'krabka-protocol::records', runs: 'the brokers and the lab module', use: 'every partition log and every produced batch' },
  { piece: 'Streams topology, processors, state stores, changelogs', crate: 'krabka-client-streams', runs: 'the lab module', use: 'every streams application node' },
  { piece: 'Avro, JSON Schema and Protobuf engines', crate: 'apache-avro, jsonschema, prost-reflect', runs: 'the lab module', use: 'the schema registry' },
];

const controls = [
  { control: 'Play / Pause, Step, Settle, Speed', effect: 'The page owns the clock. Nothing moves until it advances simulated time; Settle runs until nothing is due. The speed control runs slow events, like a broker session timeout, faster.' },
  { control: 'Drag a card', effect: 'Moves the node. Positions are saved with the scenario and shared with the link.' },
  { control: 'Click, Shift+click', effect: 'Selects a node; a second node selected with Shift enables the link controls, and Network bytes opens the Network tab on that link.' },
  { control: 'Break things bar', effect: 'Always above the canvas. With one node selected: Kill halts it with its state kept, Restart boots it from that state, Wipe boots it from nothing, Isolate and Reconnect cut and restore every link of the node. With two selected: Partition and Heal cut and restore one link, and Latency and Loss set its delay and drop rate.' },
  { control: 'Right-click or long-press a card', effect: 'The context menu: edit, send a control command as JSON, faults, remove.' },
  { control: 'Inspector', effect: 'With nothing selected it lists every node and its health. For a selected node it shows State (a real broker’s process, log and network activity; a client’s assignment, positions, commits and lag; or a streams app’s tasks, stores and topology), Config (edits the node and restarts it), and Raw JSON. Its command bar sends a producer’s Send, Set rate, Pause and Resume; a consumer’s Pause, Resume, processing time and Commit now; a streams app’s Pause, Resume and store Query.' },
  { control: 'Events, Logs, Network, Storage', effect: 'The tabs under the canvas: everything the cluster recorded, the brokers’ own log lines, every frame on the virtual network, and what each node keeps in this browser, down to the broker’s files.' },
  { control: 'Field tree and hex', effect: 'A selected frame or file decodes into its fields beside its bytes. Pointing at a byte lights its whole field in hex and ASCII and names it; clicking selects it in the tree; selecting a field lights its bytes. Each kind of field has its colour, and neighbouring fields alternate shade. With the hex focused, ← and → step through the fields and ↑ goes to the enclosing one. Below the hex, the bytes at the pointer read as every integer width, a varint, a float and text.' },
  { control: 'Tour, ?', effect: 'The tour walks through the controls in a minute and can kill and restart a broker for you. The ? button lists the shortcuts: Space plays and pauses, K and R kill and restart the selected node, F fits the canvas.' },
];
---

<BaseLayout
  image="/og/lab.png"
  title="Cluster Lab | krabka Documentation"
  description="Run real krabka brokers in your browser with a schema registry, producers, consumers and streams apps. Break their network and read their logs."
>
  <!-- The lab is an app, so it takes the window: a one-line header above it, the guide below. -->
  <header class="mx-auto flex max-w-[120rem] flex-wrap items-baseline gap-x-4 gap-y-1 px-4 py-2.5 font-sans sm:px-6 lg:px-8">
    <!-- A flex row, like the docs layout's: the links pad out to a 28px hit area without growing the row. -->
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-xs text-gray-400">
      <a href={getPath('/')} class="-my-1.5 py-1.5 hover:text-white">Home</a>
      <span aria-hidden="true">/</span>
      <a href={getPath('/docs')} class="-my-1.5 py-1.5 hover:text-white">Docs</a>
      <span aria-hidden="true">/</span>
      <span class="text-gray-200" aria-current="page">Cluster Lab</span>
    </nav>
    <h1 class="text-xl font-extrabold text-white">Cluster Lab</h1>
    <p class="text-sm text-gray-400">Run krabka brokers, clients, and apps in your browser. Inject network faults and inspect the resulting traffic and node state.</p>
  </header>

  <div id="krabka-lab" class="not-prose lab-app" aria-busy="true" data-lab-wasm={labWasm.version} data-lab-wasm-size={labWasm.size} data-broker-wasm={brokerWasm.version}>
    <div class="lab-loader">
      <div class="lab-loader-card">
        <svg class="lab-loader-mark" viewBox="0 0 80 80" fill="none" aria-hidden="true">
          <path d="M40 18 62 56H18L40 18Z" stroke="currentColor" stroke-opacity=".3" stroke-width="1.5" />
          <circle cx="40" cy="18" r="7" fill="currentColor" />
          <circle cx="18" cy="56" r="7" fill="currentColor" />
          <circle cx="62" cy="56" r="7" fill="currentColor" />
        </svg>
        <h2>Preparing your lab</h2>
        <p class="lab-loader-status" role="status">Getting things ready…</p>
        <progress class="lab-loader-progress" max="100" aria-label="Loading the Cluster Lab"></progress>
        <p class="lab-loader-detail">The first visit takes a little longer. Future visits are usually quicker.</p>
        <p class="lab-loader-hint">A cluster of your own. Right here in your browser.</p>
        <noscript><p>This lab needs JavaScript and WebAssembly. Enable JavaScript and reload to get started.</p></noscript>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-4xl space-y-6 px-4 py-10 font-sans sm:px-6">
    <div class="space-y-4 text-sm text-gray-300 leading-relaxed">
      <p>
        The real brokers run as WebAssembly processes in Workers. Clients and apps run as state machines in the lab module.
        The page owns their clock and virtual network, so you can pause time, change link latency and cut connections.
      </p>
      <p>
        The brokers speak the <a href={getPath('/docs/kip-matrix')} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Kafka wire protocol</a> to the clients. Their partition logs and <a href={getPath('/features/kraft')} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">KRaft metadata</a> are kept in this
        browser's IndexedDB, so a reload reopens the cluster where you left it. The
        schema registry keeps its schemas where Confluent's does, in the <code class="font-mono text-krab-300">_schemas</code> topic on the brokers, and replays it on every start. Several tabs, on one machine or across the internet, can each host a
        share of the clients and apps over WebRTC data channels; the brokers stay in the tab that started them.
      </p>
    </div>

    <div class="space-y-4 text-sm text-gray-300 leading-relaxed">
      <h2 id="guided-experiment" class="text-xl font-bold text-white pt-2">Try an experiment: when must a write stop?</h2>
      <p>Can an <code>acks=all</code> producer write when a topic needs three in-sync replicas but only two remain? Predict the result before opening the experiment below.</p>
      <LabLink preset="min-isr" title="Watch the minimum in-sync replica rule" description="This experiment runs the existing three-broker scenario, kills one replica, raises the required ISR to three, then restarts the replica." />
      <ol class="list-decimal pl-5 space-y-2">
          <li>Open <strong>Build · Scenarios · Connect</strong>, then choose <strong>Scenarios</strong> to see the experiment checks. Set Speed to <strong>5×</strong> to advance the two minutes of lab time faster.</li>
          <li>Watch the checks: the ISR falls to two, and writes still succeed with the original minimum.</li>
        <li>When the minimum rises to three, expect <code>NOT_ENOUGH_REPLICAS</code> and no acknowledged writes.</li>
        <li>After the replica restarts and the ISR returns to three, expect acknowledged writes to resume. The experiment lists each check and its result.</li>
      </ol>
      <p>The minimum protects the requested replication level by refusing writes until enough replicas are in sync. This is an experiment in simulated time; it does not measure throughput or disk durability. Next, <a href={getPath('/docs/quickstart')} class="text-krab-400 underline underline-offset-2">run a broker locally and produce and consume a record</a>, then use <a href={getPath('/docs/operations')} class="text-krab-400 underline underline-offset-2">the operations guides</a> before changing a cluster.</p>

      <h2 class="text-xl font-bold text-white pt-2">What to try</h2>
      <p><strong>Rebalancer: grow a two-broker cluster</strong> starts with six partitions replicated on both brokers. Add a broker from the palette with <strong>KRaft voter</strong> unchecked to keep the controller quorum unchanged. The rebalancer detects the new broker, moves replicas onto it, and elects preferred leaders. Its inspector shows the plan and per-broker counts; use <strong>Pause</strong>, <strong>Plan now</strong>, and <strong>Execute now</strong> to control the moves.</p>
      <p><strong>Share group: three workers, one partition</strong> demonstrates workers sharing records from one partition. The broker acquires records for each worker and persists its acknowledgements. <strong>Share group: release and redelivery</strong> starts a worker that releases records; inspect its delivery counts, then select <strong>Accept</strong> to complete work or <strong>Reject</strong> to archive it. <strong>Pause</strong> keeps heartbeats running, and <strong>Close</strong> releases unfinished work before leaving. Share consumers use record acknowledgements instead of consumer offset commits.</p>
      <p>For authenticated, encrypted virtual links, open <strong>Scenario settings</strong> and choose <strong>Kerberos authentication + encryption</strong> under <strong>SSPI / Kerberos transport</strong>. Pure Rust SSPI runs in the browser with an embedded KDC and lab-only node identities. The <strong>Events</strong> tab records authenticated peers and failures; <strong>Network → Frames</strong> shows Kerberos tokens and encrypted bytes. Changing the mode restarts nodes on their existing disks. These demonstration credentials do not use Windows single sign-on or Active Directory. In an ACL scenario, the adapter binds the verified node identity to the broker’s SASL principal before delivering requests. This transport uses SSPI message protection rather than TLS.</p>
      <p>Open <strong>Broker ACLs: topic and group permissions</strong> to see a producer and billing consumer succeed while a consumer without permission for group audit receives <code>GROUP_AUTHORIZATION_FAILED</code>. <strong>Broker ACLs: prefixed allow, explicit deny</strong> adds a producer whose prefixed grant is overridden by a literal deny; the broker returns <code>TOPIC_AUTHORIZATION_FAILED</code>. Both use the broker’s default-deny authorizer and replicated Kafka ACL records. Edit <strong>Broker ACL policy (JSON)</strong> in Scenario settings or <code>authorization.acls</code> in an exported scenario; clearing the settings field disables ACL enforcement. Brokers and the scenario admin are superusers. Client traffic waits until every broker confirms the policy.</p>
      <p>
        Load <strong class="text-white">Three brokers, a producer and a consumer group</strong> from the presets and set the
        speed to 5×. The three brokers form one KRaft quorum; its leader becomes the active controller, registers the brokers,
        unfences them once they have caught up with the metadata log. The scenario admin creates <code class="font-mono text-krab-300">orders</code>.
        The producer's records flow through replicated partitions to two KIP-848 consumers that share them. Select a broker:
        its inspector shows process logs and runtime activity, and <strong class="text-white">Browse disk</strong> opens its stored files. Select the
        leader of a partition and <strong class="text-white">Kill</strong> it: once its 9 s session runs out, the controller
        fences it and moves the leadership to another replica in the ISR, and the consumers keep reading. <strong class="text-white">Restart</strong> it and it catches up and rejoins the ISR.
      </p>
      <p>
        <strong class="text-white">Schema registry with an Avro producer and a decoding consumer</strong> starts a registry that
        creates its <code class="font-mono text-krab-300">_schemas</code> topic on the brokers; the producer registers a schema
        before the first record, and the consumer decodes every value by its schema id. Add a second registry: the two elect a
        primary through their group, and the secondary forwards the writes it takes to the primary. <strong class="text-white">Kafka Streams word
        count</strong> joins a KIP-1071 streams group, counts words in a state store backed by the changelog topic the group
        creates, and answers a store query from the command bar. Other presets cover independent consumer groups, a broker
        observer, minimum in-sync replicas, slow links and a rack split.
      </p>

      <div class="frosted-card rounded-xl overflow-hidden border border-white/10 not-prose">
        <table class="w-full text-xs">
          <thead class="bg-white/5 text-left">
            <tr>
              <th class="px-4 py-2 font-semibold text-gray-300">Control</th>
              <th class="px-4 py-2 font-semibold text-gray-300">Effect</th>
            </tr>
          </thead>
          <tbody>
            {controls.map((c) => (
              <tr class="border-t border-white/5">
                <td class="px-4 py-2 font-mono text-krab-300 whitespace-nowrap align-top">{c.control}</td>
                <td class="px-4 py-2 text-gray-300">{c.effect}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="text-xl font-bold text-white pt-2">Saving, sharing, hosting</h2>
      <p>
        The scenario autosaves to this browser; the <strong class="text-white">Saved in this browser</strong> list on the Scenarios tab reopens it with its durable
        state. The <strong class="text-white">Storage</strong> tab under the canvas shows what is kept per node and can forget it on request. <strong class="text-white">Browse</strong> opens a real broker's disk, read from its committed IndexedDB bytes. <strong class="text-white">Export</strong> writes the scenario as a JSON file, <strong class="text-white">Copy link</strong> puts the whole document into the URL. Neither carries node state: a shared link starts the cluster fresh.
      </p>
      <p>
        <strong class="text-white">Invite a tab</strong> in the Session section of the Connect tab makes a link that another tab or another machine
        opens to join. That page shows an answer code; paste it back into the host and the two are connected without any server.
        The host then assigns clients and apps to peers from the inspector; frames between tabs travel over the WebRTC data channel, and each
        tab persists the state of the nodes it hosts. A real broker stays on the host, with its disk.
      </p>

      <h2 class="text-xl font-bold text-white pt-2">How the brokers run</h2>
      <p>
        <strong class="text-white">krabka broker</strong> in the Build tab adds the real <code class="font-mono text-krab-300">krabka-broker</code>, compiled for <code class="font-mono text-krab-300">wasm32-wasip1</code>, as a node of the lab. It runs in a Web Worker on a browser
        WASI runtime: its listeners, its dials to other nodes and its clock are the lab's, so links, faults, pause and speed
        apply to it like to any node, and its disk is a volume in this browser's IndexedDB. Every preset has
        brokers, so the first visit downloads the broker module, about 14 MB, and the page shows the progress on each broker node;
        later visits take it, and the lab module, from this browser's cache until the site ships a new build.
        The runtime also needs a cross-origin isolated page. Any page of this site sets that up in the background, so a visit
        that starts elsewhere on the site opens the lab isolated; landing on the lab first, the page reloads once, then reopens the scenario. A real
        broker stays in the tab that runs it: its process cannot move to another tab of a session. If the broker module is
        missing from the site, or the browser cannot isolate the page, the node says so and refuses connections.
      </p>

      <h2 class="text-xl font-bold text-white pt-2">Logs</h2>
      <p>
        The <strong class="text-white">Logs</strong> tab under the canvas shows what the broker processes write to stderr, one JSON
        object per line: the lab time, the level, the node, the <code class="font-mono text-krab-300">target</code> that logged it and its message.
        Click a row, or press Enter, to open the whole record as a JSON tree. Filter by minimum level, by node and by
        target, or search the message and fields; <code class="font-mono text-krab-300">node:2 level:warn</code> style terms match a field's value.
        The list follows the newest line until you scroll up, and a pill says how many new lines are waiting.
        <strong class="text-white">Download</strong> saves the lines on screen as NDJSON. A line that is not JSON, such as a panic message, is shown as
        it is, marked raw. The page keeps up to 5,000 lines per broker and forgets them on reload. Starts, exits, kills and
        restarts show up in the stream as marker rows.
      </p>
      <p>
        <strong class="text-white">Log levels</strong> sets how much a broker logs: Quiet (warn), Normal (the default, info), Verbose (debug), Trace (trace),
        or a directive such as <code class="font-mono text-krab-300">warn,krabka_broker=debug</code>, for all brokers or for one. The level is the broker's
        <code class="font-mono text-krab-300">KRABKA_LOG</code> environment variable, read when its process starts, so applying a new level restarts the broker on
        the disk it has, after asking. It is a setting of this browser, not part of the node's configuration, which is why it
        does not wipe the disk.
      </p>

      <h2 class="text-xl font-bold text-white pt-2">Network</h2>
      <p>
        The <strong class="text-white">Network</strong> tab records every frame the virtual network carries, from the moment the scenario
        starts: opens, closes and up to 64 KiB of each payload. It pairs each Kafka request with its response by connection and
        correlation id. <strong class="text-white">Exchanges</strong> lists the pairs, <strong class="text-white">Frames</strong> lists everything,
        and <strong class="text-white">Statistics</strong> gives per-API counts, failures, bytes and round-trip percentiles with a histogram,
        and per-link bytes and throughput. Times are lab milliseconds. <em>RTT</em> runs from the request leaving the client to the
        response reaching it; <em>server</em> runs from the request reaching the broker to the response leaving it; the rest is the
        link, both ways.
      </p>
      <p>
        A selected exchange decodes field by field from the Kafka message schemas krabka-protocol generates its codecs from:
        the headers, every request and response version, record batches with their CRC-32C recomputed and their records
        (gzip, snappy, lz4 and zstd opened in the page), and
        krabka's own controller RPCs by name. The filter takes words and terms such as <code class="font-mono text-krab-300">api:fetch</code>,
        <code class="font-mono text-krab-300">node:broker-1</code>, <code class="font-mono text-krab-300">port:9093</code>,
        <code class="font-mono text-krab-300">err</code>, <code class="font-mono text-krab-300">slow:50</code> and
        <code class="font-mono text-krab-300">pending</code>. <strong class="text-white">pcapng</strong> exports what the filter shows as raw IPv4 and TCP
        between the nodes' 10.0.x.y addresses, timestamped in lab milliseconds. Wireshark opens it and its Kafka dissector
        decodes port 9092 (Decode As maps 9093 too), up to the API versions that Wireshark release knows;
        <strong class="text-white">JSON</strong> keeps every frame's bytes and <strong class="text-white">CSV</strong> one row per exchange.
        The status line says how many frames the capture lost: dropped before the page read them, evicted to stay within its
        64 MiB, or skipped while capture was paused.
      </p>

      <!-- J2 -->
      <h2 class="text-xl font-bold text-white pt-2">Cluster state, charts and invariants</h2>
      <p>
        The scenario's admin node polls the brokers once a lab second. The <strong class="text-white">Cluster</strong> tab shows what it
        last saw: the KRaft quorum with its leader, epoch and each voter's lag, the brokers with their rack, whether they are
        fenced and how many partitions each leads and hosts, and every partition with its leader, leader epoch, replicas, ISR,
        high watermark, log start and each consumer group's lag. Replicas that fell out of the ISR are struck through.
        Offline and under-replicated partitions sort first; internal topics such as <code class="font-mono text-krab-300">__consumer_offsets</code>
        hide behind a toggle. The canvas marks the quorum leader's card <em>controller</em>, counts the partitions each broker
        leads and hosts, and puts one chip per partition under a topic, coloured by health, with its leader's id.
      </p>
      <p>
        The <strong class="text-white">Charts</strong> tab samples the run once a lab second: records acknowledged and consumed per
        second, total consumer lag, Produce and Fetch round trips (p50 and p99, from the network capture), the smallest ISR
        and the number of under-replicated partitions. Every fault, kills and restarts included, is a labelled line on every
        chart, on the same lab-time axis, and hovering reads all the charts at one instant. <strong class="text-white">Pin as baseline</strong>
        keeps the series in this browser; <strong class="text-white">Rerun</strong> opens the scenario again from nothing with its current
        configuration, so you can change one setting, rerun and see the new run over the old one, dashed.
      </p>
      <p>
        The same tab checks invariants on every snapshot, and the toolbar says whether they hold: no record a producer with
        <code class="font-mono text-krab-300">acks=all</code> saw acknowledged is lost (the partition's high watermark must stay above it;
        a new leader's may stand lower while its ISR catches up or shrinks, so it counts as a loss after 60 s of lab time, or at once when the partition is gone), consumer positions only move forward
        unless an admin reset them, one broker leads a partition per leader epoch, the KRaft quorum has one leader per epoch,
        and a <code class="font-mono text-krab-300">read_committed</code> consumer never receives a record of an aborted transaction. A
        violation is listed with its lab time and drawn as a red line on the charts.
      </p>
      <p>
        <strong class="text-white">Trace</strong>, on a row of a producer's Last records, follows that record through the capture: the
        Produce request that carried it, each follower's Fetch that copied it, the first Fetch response whose high watermark
        passed it, the consumer's Fetch that delivered it and the OffsetCommit past it, each with its lab time, its two nodes
        and a button that selects the exchange in the Network tab. A step that is missing says why: it has not happened yet,
        or it fell outside what the capture kept.
      </p>
      <!-- /J2 -->

      <!-- J3 -->
      <h2 class="text-xl font-bold text-white pt-2">Process faults, experiments and forks</h2>
      <p>
        With one node selected, the <strong class="text-white">Break things</strong> bar adds <strong class="text-white">Pause</strong>: the
        node stops as under SIGSTOP or a long GC pause. A real broker's worker gets no input, socket readiness or timers;
        what is sent to it waits in its socket buffers, and <strong class="text-white">Resume</strong> lets it catch up at the time it
        is. Paused for longer than the clients' 30 s request timeout, its clients drop their connections and reconnect.
        <strong class="text-white">More…</strong> skews a real broker's wall clock (REALTIME; its monotonic clock is untouched, so
        the files it writes carry the skewed time) and sets its disk to slow (each fsync takes that many lab milliseconds),
        full (writes that grow a file fail with ENOSPC) or failing (writes and syncs fail with EIO). The krabka broker does
        not fsync on produce, so a slow disk shows when it starts and recovers its log; a full or failing disk makes it log
        the error and stop. With two nodes selected, <strong class="text-white">Cut →</strong> and <strong class="text-white">Cut ←</strong> drop the
        frames one way only: connections stay open until a peer times out. The canvas menu has the same faults.
      </p>
      <p>
        A scenario can carry an <strong class="text-white">experiment</strong>: timed faults and commands, and checks decided at a lab
        time or required by one, such as an ISR size, a consumer's lag, an event, a Kafka error code in a response, a dotted
        path into a node's state, or that the invariants above hold. The Scenarios tab edits it as JSON and validates it;
        <strong class="text-white">Run experiment</strong> restarts the scenario on fresh disks, runs the script and lists each step and
        check with its time and result. The experiment travels with Copy link and Export. <strong class="text-white">Fork here</strong>
        pauses the clock, copies the brokers' disks into a new saved scenario and opens it: the brokers boot from the
        copies, the clients start fresh. Three presets carry an experiment; each link opens it in the lab and runs it.
      </p>
      <div class="grid sm:grid-cols-3 gap-4 not-prose">
        <LabLink preset="min-isr" description="Kill one replica, raise the topic's min.insync.replicas to 3, and watch acks=all writes fail with NOT_ENOUGH_REPLICAS until the replica is back in the ISR." />
        <LabLink preset="five-brokers-partition" description="Brokers 4 and 5 start cut off: the majority registers, elects a controller and serves; after the heal both brokers register and catch up." />
        <LabLink preset="slow-replica" description="Broker 3's links slow to 15 s: it falls out of the ISR and the group's lag jumps. Back at 200 ms it rejoins and the lag comes down." />
      </div>
      <!-- /J3 -->

      <h2 class="text-xl font-bold text-white pt-2">A broker's disk</h2>
      <p>
        <strong class="text-white">Browse</strong> in the Storage tab, or <strong class="text-white">Browse disk</strong> in a broker's inspector,
        opens its log directory by partition. A partition lists its segments and checks them together: every batch CRC, segment
        names against their first offsets, offsets across segment boundaries, and the leader-epoch checkpoint against the
        batches. A segment shows its batches as a byte map and a table, then the decoded batches and records; the KRaft
        metadata log decodes into its metadata records, and <code class="font-mono text-krab-300">__consumer_offsets</code> into offset commits.
        An offset or time index is checked entry by entry against the batch it points at. Producer-state snapshots, checkpoints
        and the quorum state decode too.
      </p>

      <h2 class="text-xl font-bold text-white pt-2">Connect kafkactl from your computer</h2>
      <p>
        Open the <strong class="text-white">Connect</strong> tab in the left rail and expand <strong class="text-white">Connect with kafkactl</strong>. This is a krabka build of
        <a href="https://github.com/fgrosse/kafkactl">fgrosse/kafkactl v1.4.0</a> with the bridge command added. Download it for
        your computer, extract it, and run <code>kafkactl lab bridge</code>. Enter the token it prints in the lab.
        The browser may ask to allow access to the local network. The bridge listens only on this computer.
        In a second terminal, add the <code>krabka-lab</code> context using the command shown in the panel, then
        copy the broker, topic, produce, and consume commands. The single broker quickstart has an
        <code>orders</code> topic ready to use. Keep the lab clock playing while the commands run.
      </p>

      <h2 class="text-xl font-bold text-white pt-2">What is real</h2>
      <p>
        The brokers run the krabka-broker process compiled for <code class="font-mono text-krab-300">wasm32-wasip1</code>.
        The page supplies their clock, network and disk. Clients and apps run in the lab's <code class="font-mono text-krab-300">wasm32-unknown-unknown</code> module.
      </p>
      <div class="frosted-card rounded-xl overflow-hidden border border-white/10 not-prose">
        <table class="w-full text-xs">
          <thead class="bg-white/5 text-left">
            <tr>
              <th class="px-4 py-2 font-semibold text-gray-300">Piece</th>
              <th class="px-4 py-2 font-semibold text-gray-300">Crate</th>
              <th class="px-4 py-2 font-semibold text-gray-300">Runs in</th>
              <th class="px-4 py-2 font-semibold text-gray-300">Used for</th>
            </tr>
          </thead>
          <tbody>
            {real.map((r) => (
              <tr class="border-t border-white/5">
                <td class="px-4 py-2 text-gray-300 align-top">{r.piece}</td>
                <td class="px-4 py-2 font-mono text-krab-300 align-top break-words">{r.crate}</td>
                <td class="px-4 py-2 text-gray-300 align-top">{r.runs}</td>
                <td class="px-4 py-2 text-gray-300 align-top">{r.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        What is simulated: the network (per-link latency, loss and cuts under the seed), disks (IndexedDB stands in for the log
        directory), and time. The seed fixes the network, the clients and the apps; the broker processes draw real randomness,
        so two runs on one seed need not play out the same way. The lab makes no performance claims; the numbers on screen are counts and simulated milliseconds.
      </p>

      <div class="grid sm:grid-cols-2 gap-4 not-prose pt-2">
        <a href={getPath('/docs/playground')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Consensus Playground →</div>
          <p class="text-xs text-gray-400 mt-1">The KRaft quorum on its own, one message at a time.</p>
        </a>
        <a href={getPath('/verification')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Correctness & Verification →</div>
          <p class="text-xs text-gray-400 mt-1">How the broker running in the lab is proved and model-checked.</p>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script src={getPath('/playground/lab/app.js')} type="module" is:inline></script>
<!-- A module that cannot be fetched never runs its own error handling: say so here instead of loading forever. -->
<script is:inline>
  var labRoot = document.getElementById('krabka-lab');
  if (labRoot) labRoot.style.setProperty('--lab-top', Math.round(labRoot.getBoundingClientRect().top + window.scrollY) + 'px');
  document.currentScript.previousElementSibling.addEventListener('error', function () {
    var root = document.getElementById('krabka-lab');
    if (!root || root.dataset.ready) return;
    root.removeAttribute('aria-busy');
    root.innerHTML = '<p class="lab-error">The Cluster Lab could not load its scripts. Check your connection and reload.</p><button type="button" class="lab-btn" onclick="location.reload()">Reload the lab</button>';
  });
</script>
