---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getPath } from '../../utils/paths';

const composeCode = `curl -fsSL https://krabka.io/quickstart/docker-compose.yml -o docker-compose.yml
docker compose up -d

KAFKA_TOOLS=docker.io/apache/kafka@sha256:01b9a4030e54c6068e66eb3ba4cb82c0d89238629ef1c30d79b86036bf89b1b7
docker run --rm --network host "$KAFKA_TOOLS" /opt/kafka/bin/kafka-topics.sh \\
  --bootstrap-server localhost:9092 --create --topic quickstart --partitions 1 --replication-factor 1
printf 'milestone-20-qualified\\n' | docker run --rm -i --network host "$KAFKA_TOOLS" \\
  /opt/kafka/bin/kafka-console-producer.sh --bootstrap-server localhost:9092 --topic quickstart
docker run --rm --network host "$KAFKA_TOOLS" /opt/kafka/bin/kafka-console-consumer.sh \\
  --bootstrap-server localhost:9092 --topic quickstart --from-beginning --max-messages 1

docker compose down --volumes`;

const helmCode = `kubectl apply -f https://krabka.io/quickstart/crds.yaml
helm repo add krabka https://krabka.io/charts
helm repo update
helm install krabka-operator krabka/krabka-operator --version 0.4.0 \\
  --namespace krabka-system --create-namespace \\
  --set image.repository=ghcr.io/krabka-io/krabka-operator \\
  --set-string image.digest=sha256:861796f11b63798f07cd8cfbcb0fa41376259cb6fce07b1e80e15e93de3a377b
kubectl rollout status deployment/krabka-operator-krabka-operator -n krabka-system --timeout=5m

kubectl apply -f https://krabka.io/quickstart/krabka-cluster.yaml
kubectl wait --for=condition=Ready kafka/m20-quickstart --timeout=10m
kubectl wait --for=condition=Ready kafkatopic/quickstart --timeout=5m

helm install krabka-rebalancer krabka/krabka-rebalancer --version 0.4.0 \\
  --set bootstrapServers=m20-quickstart-broker-headless.default.svc.cluster.local:9092 \\
  --set image.repository=ghcr.io/krabka-io/krabka-rebalancer \\
  --set-string image.digest=sha256:706b3b51a521d97d4166d98a1f39e045b5dfa1508b155bce174161c4bc009b11
kubectl rollout status deployment/krabka-rebalancer-krabka-rebalancer --timeout=5m

KAFKA_TOOLS=docker.io/apache/kafka@sha256:01b9a4030e54c6068e66eb3ba4cb82c0d89238629ef1c30d79b86036bf89b1b7
kubectl run kafka-tools --image="$KAFKA_TOOLS" --restart=Never --rm -i --command -- \\
  /bin/bash -lc "printf 'milestone-20-qualified\\n' | /opt/kafka/bin/kafka-console-producer.sh --bootstrap-server m20-quickstart-broker-headless.default.svc.cluster.local:9092 --topic quickstart && /opt/kafka/bin/kafka-console-consumer.sh --bootstrap-server m20-quickstart-broker-headless.default.svc.cluster.local:9092 --topic quickstart --from-beginning --max-messages 1"

kubectl delete kafkatopic/quickstart
kubectl delete kafka/m20-quickstart
kubectl delete kafkanodepool/brokers --ignore-not-found
helm uninstall krabka-rebalancer
helm uninstall krabka-operator -n krabka-system
kubectl delete -f https://krabka.io/quickstart/crds.yaml`;
---

<DocsLayout
  title="Quickstart Guide"
  description="Step-by-step quickstart guide to running Krabka locally with Docker Compose or deploying to Kubernetes with Helm."
  currentSlug="/docs/quickstart"
>
  <div class="space-y-6 font-sans">
    <div class="border-b border-white/10 pb-4">
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Quickstart Guide</h1>
      <p class="text-gray-400 mt-2 text-sm max-w-2xl leading-relaxed">
        Deploy a running Krabka cluster and verify producer and consumer pipelines.
      </p>
    </div>

    <div class="space-y-6 text-sm text-gray-300 leading-relaxed">
      <h2 class="text-xl font-bold text-white pt-2">Option A: Docker Compose (Local Dev)</h2>
      <p>
        The quickest way to run a single-node KRaft cluster with local Prometheus metrics:
      </p>

      <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3">
        <div class="flex items-center justify-between text-xs text-gray-400">
          <span>Run Compose Stack</span>
          <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={composeCode}>
            Copy
          </button>
        </div>
        <pre class="bg-black/50 p-4 rounded-lg font-mono text-xs text-gray-200 overflow-x-auto border border-white/5"><code>{composeCode}</code></pre>
      </div>

      <h2 class="text-xl font-bold text-white pt-2">Option B: Kubernetes Operator (Helm)</h2>
      <p>
        Install the <code class="font-mono text-krab-300 text-xs">krabka-operator</code> and provision a cluster CRD:
      </p>

      <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3">
        <div class="flex items-center justify-between text-xs text-gray-400">
          <span>Helm Deployment</span>
          <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={helmCode}>
            Copy
          </button>
        </div>
        <pre class="bg-black/50 p-4 rounded-lg font-mono text-xs text-gray-200 overflow-x-auto border border-white/5"><code>{helmCode}</code></pre>
      </div>

      <h2 class="text-xl font-bold text-white pt-2">Related Resources</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose pt-1">
        <a href={getPath('/docs/playground')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Consensus Playground →</div>
          <p class="text-xs text-gray-400 mt-1">Simulate KRaft leader election and network fault injection in your browser via WebAssembly.</p>
        </a>
        <a href={getPath('/docs/benchmarks')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Benchmark Methodology →</div>
          <p class="text-xs text-gray-400 mt-1">Empirical comparisons against Strimzi Kafka across RSS memory, failover, and tail latency.</p>
        </a>
      </div>
    </div>
  </div>
</DocsLayout>
