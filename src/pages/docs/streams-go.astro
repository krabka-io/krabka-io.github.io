---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getPath } from '../../utils/paths';
import versionsData from '../../data/versions.json';

const activeRelease = versionsData['streams-go']?.activeRelease || 'v0.1.0-dev';

const goInstallCode = `go get github.com/krabka-io/krabka-streams-go`;

const goCode = `package main

import (
	"github.com/krabka-io/krabka-streams-go/columnar"
	"github.com/apache/arrow/go/v17/arrow"
	"github.com/apache/arrow/go/v17/arrow/array"
	"github.com/apache/arrow/go/v17/arrow/memory"
)

func main() {
	mem := memory.NewGoAllocator()
	codec := columnar.NewBlobCodec(mem)
	topology := columnar.NewTopology(mem)
	
	source, _ := topology.AddSource("source", []string{"transactions"}, codec)
	large, _ := topology.AddOperator("large",
		columnar.Filter(mem, func(batch arrow.Record, row int) bool {
			return batch.Column(1).(*array.Int64).Value(row) > 4
		}), source)
	topology.AddSink("archive", "large-transactions", codec, large)
	
	built, err := topology.Build()
	if err != nil { panic(err) }
	
	_ = built
}`;
---

<DocsLayout
  title="Go Streams & Arrow"
  description="Go client library for stream processing with Krabka: Apache Arrow batch processing, schema registry, and barrier cuts."
  currentSlug="/docs/streams-go"
>
  <div class="space-y-6 font-sans">
    <!-- Header -->
    <div class="border-b border-white/10 pb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="text-xs text-gray-400 mb-1">
          Go 1.26+ · Track {activeRelease}
        </div>
        <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Go Streams & Arrow</h1>
        <p class="text-gray-400 mt-2 text-sm max-w-2xl leading-relaxed">
          Stream processing in Go featuring Apache Arrow batch acceleration, barrier cuts, and schema decoding via <code>krabka-streams-go</code>.
        </p>
      </div>

      <a
        href={getPath('/api/streams-go/latest/')}
        class="inline-flex items-center rounded-lg bg-krab-500/20 hover:bg-krab-500/30 border border-krab-500/40 px-4 py-2 text-xs font-semibold text-krab-300 hover:text-white transition-colors shrink-0"
      >
        Browse Godoc Reference
      </a>
    </div>

    <div class="space-y-6 text-sm text-gray-300 leading-relaxed">
      <p>
        <code>krabka-streams-go</code> provides native Go stream processing primitives optimized for zero-copy column batching. Instead of per-record serialization overhead, streams operate on Apache Arrow record batches to maximize CPU cache locality.
      </p>

      <!-- Architecture & Engineering Guides -->
      <div class="space-y-3 pt-2">
        <div>
          <h2 class="text-xl font-bold text-white">Architecture & Engineering Guides</h2>
          <p class="text-sm text-gray-300 mt-1">
            In-depth technical guides maintained alongside the Go codebase:
          </p>
        </div>
        <ul class="space-y-2 text-sm text-gray-300 list-disc pl-5 marker:text-krab-400">
          <li>
            <a href={getPath('/docs/streams-go/getting-started')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Getting Started:</a> Installation, topology builder walkthrough, and consumer group setup.
          </li>
          <li>
            <a href={getPath('/docs/streams-go/columnar')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Columnar Processing:</a> Arrow batch filters, memory allocators, and record projection.
          </li>
          <li>
            <a href={getPath('/docs/streams-go/serdes')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Serdes:</a> Avro, Protobuf, and JSON schema caching and binary decoding.
          </li>
          <li>
            <a href={getPath('/docs/streams-go/schema-registry')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Schema Registry:</a> Confluent Schema Registry client integration, schema evolution, and wire protocol.
          </li>
          <li>
            <a href={getPath('/docs/streams-go/barriers')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Barrier Cuts:</a> Snapshot alignment, state checkpoints, and non-blocking barriers.
          </li>
          <li>
            <a href={getPath('/docs/streams-go/coordination')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Coordination Primitives:</a> Work assignment, leader elections, and cooperative rebalance.
          </li>
          <li>
            <a href={getPath('/docs/streams-go/testing')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Testing:</a> In-memory pipeline testing and deterministic record assertions.
          </li>
          <li>
            <a href={getPath('/docs/streams-go/architecture')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Architecture:</a> Topology construction, channel-based execution graph, and memory safety.
          </li>
        </ul>
      </div>

      <!-- Installation -->
      <h2 class="text-xl font-bold text-white pt-2">Installation</h2>
      <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3">
        <div class="flex items-center justify-between text-xs text-gray-400">
          <span>Go Module Command</span>
          <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={goInstallCode}>
            Copy
          </button>
        </div>
        <pre class="bg-black/50 p-4 rounded-lg font-mono text-xs text-gray-200 overflow-x-auto border border-white/5"><code>$ {goInstallCode}</code></pre>
      </div>

      <!-- Packages Table -->
      <h2 class="text-xl font-bold text-white pt-2">Packages</h2>
      <div class="frosted-card rounded-xl overflow-hidden border border-white/10">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-slate-950/80 border-b border-white/10 uppercase tracking-wider text-gray-400 font-semibold">
            <tr>
              <th class="py-3 px-4">Package</th>
              <th class="py-3 px-4">Purpose</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <tr class="hover:bg-white/5"><td class="py-2.5 px-4 font-mono font-medium text-krab-300">columnar</td><td class="py-2.5 px-4 text-gray-400">Apache Arrow batch processing, topologies, and barrier cuts</td></tr>
            <tr class="hover:bg-white/5"><td class="py-2.5 px-4 font-mono font-medium text-krab-300">schema</td><td class="py-2.5 px-4 text-gray-400">Registry client, cache, and Avro/Protobuf/JSON Schema serdes</td></tr>
            <tr class="hover:bg-white/5"><td class="py-2.5 px-4 font-mono font-medium text-krab-300">columnarschema</td><td class="py-2.5 px-4 text-gray-400">Avro and Protobuf Arrow memory bridges</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Code Example -->
      <h2 class="text-xl font-bold text-white pt-2">Columnar Processing Example</h2>
      <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3">
        <div class="flex items-center justify-between text-xs text-gray-400">
          <span>Topology Definition</span>
          <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={goCode}>
            Copy
          </button>
        </div>
        <pre class="bg-black/50 p-4 rounded-lg font-mono text-xs text-gray-200 overflow-x-auto border border-white/5"><code>{goCode}</code></pre>
      </div>

      <!-- Version & Compatibility Reference -->
      <h2 class="text-xl font-bold text-white pt-2">Version & Compatibility</h2>
      <div class="frosted-card rounded-xl overflow-hidden border border-white/10">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-slate-950/80 border-b border-white/10 uppercase tracking-wider text-gray-400 font-semibold">
            <tr>
              <th class="py-2.5 px-4">Component</th>
              <th class="py-2.5 px-4">Supported Version</th>
              <th class="py-2.5 px-4">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-gray-300">
            <tr>
              <td class="py-2 px-4 font-medium text-white">Go Runtime</td>
              <td class="py-2 px-4">Go 1.26+</td>
              <td class="py-2 px-4 text-gray-400">Targeting Go 1.26 toolchain</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-medium text-white">Apache Arrow Go</td>
              <td class="py-2 px-4">v17.0.0</td>
              <td class="py-2 px-4 text-gray-400">Native Go allocator and Record batches</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-medium text-white">Krabka Broker</td>
              <td class="py-2 px-4">0.5.4 or Apache Kafka 4.3.1</td>
              <td class="py-2 px-4 text-gray-400">Wire-protocol compatibility</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm text-gray-300">
        Full version matrices and SLSA Level 3 build provenance records are tracked on the <a href={getPath('/versions')} class="text-krab-400 hover:underline">Versions page</a>.
      </p>
    </div>
  </div>
</DocsLayout>
