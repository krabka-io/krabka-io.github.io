---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getPath } from '../../utils/paths';

const producerCode = `use std::time::Duration;
use bytes::Bytes;
use crabka_client_producer::{Acks, Compression, Producer, ProducerRecord};

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    // Build an idempotent producer with LZ4 compression and acks=all
    let producer = Producer::builder()
        .bootstrap("localhost:9092")
        .compression(Compression::Lz4)
        .acks(Acks::All)
        .linger(Duration::from_millis(5))
        .build()
        .await?;

    // Send record asynchronously with broker sequence deduplication
    let metadata = producer
        .send(ProducerRecord {
            topic: "events".into(),
            value: Some(Bytes::from("hello krabka")),
            ..Default::default()
        })
        .await
        .await??;

    producer.flush().await?;
    producer.close().await?;
    Ok(())
}`;

const consumerCode = `use crabka_client_consumer::{AutoOffsetReset, Consumer};
use crabka_units::millis;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    // Build a subscribe-style group consumer
    let mut consumer = Consumer::builder()
        .bootstrap("localhost:9092")
        .group_id("order-processors")
        .client_id("processor-node-1")
        .auto_offset_reset(AutoOffsetReset::Earliest)
        .subscribe(["orders".to_string()])
        .build()
        .await?;

    loop {
        let records = consumer.poll(millis(500)).await?;
        for record in records {
            // Process record batch
        }
        consumer.commit_sync().await?;
    }
}`;

const shareConsumerCode = `use crabka_client_consumer::{ShareAckMode, ShareConsumer};

// KIP-932 Share-group consumption without partition assignment locks
let mut consumer = ShareConsumer::builder()
    .bootstrap("localhost:9092")
    .group_id("share-workers")
    .subscribe(["jobs".to_string()])
    .ack_mode(ShareAckMode::Explicit)
    .build()
    .await?;`;
---

<DocsLayout
  title="Native Rust Kafka Client & Streams (krabka-client-rs)"
  description="Native async Rust Kafka client (Producer, Consumer, Share Groups) and Kafka Streams DSL runtime built on Tokio."
  currentSlug="/docs/streams-rs"
>
  <div class="space-y-6 font-sans">
    <div class="border-b border-white/10 pb-4">
      <div class="text-xs text-gray-400 mb-1">
        Rust Client · Developer Preview
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Rust Client & Streams</h1>
      <p class="text-gray-400 mt-2 text-sm max-w-2xl leading-relaxed">
        High-throughput asynchronous Kafka client and stream processing libraries built natively on Tokio and <code class="text-krab-300 font-mono text-xs">krabka-protocol</code>.
      </p>
    </div>

    <div class="space-y-6 text-sm text-gray-300 leading-relaxed">
      <div class="p-3.5 rounded-lg bg-amber-500/10 border border-amber-500/20 text-xs text-amber-300 leading-relaxed">
        <strong class="font-semibold text-amber-200">Developer Preview Notice:</strong>
        <code class="font-mono text-amber-200">krabka-client-rs</code> and <code class="font-mono text-amber-200">krabka-streams-rs</code> are under active development. Core producer, consumer, and admin APIs are functional and tested in CI; streams DSL topology drivers are in developer preview.
      </div>

      <p>
        The Rust client ecosystem is decoupled from the broker binary, depending exclusively on <code class="font-mono text-krab-300 text-xs">krabka-protocol</code> for wire serialization. It provides clean-room, memory-safe implementations of Kafka producers, consumers, admin tools, and streaming topologies without relying on librdkafka C-bindings.
      </p>

      <h2 class="text-xl font-bold text-white pt-2">Crate Architecture</h2>
      <div class="frosted-card rounded-xl overflow-hidden border border-white/10 not-prose">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/80 border-b border-white/10 uppercase text-gray-400 font-sans">
            <tr>
              <th class="py-3 px-4">Crate</th>
              <th class="py-3 px-4">Subsystem & Features</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 font-sans">
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300">crabka-client-core</td>
              <td class="py-3 px-4 text-gray-300">Connection pools, async TCP dispatch, retry backoff, SASL/TLS authentication handshake.</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300">crabka-client-producer</td>
              <td class="py-3 px-4 text-gray-300">Idempotent producer (<code class="font-mono text-xs">InitProducerId</code>, sequence tracking), batch accumulation, and transactional APIs (KIP-447).</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300">crabka-client-consumer</td>
              <td class="py-3 px-4 text-gray-300">Consumer group protocol (rebalance, heartbeats, cooperative sticky assignor) and KIP-932 Share Groups.</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300">crabka-client-admin</td>
              <td class="py-3 px-4 text-gray-300">Administrative client for topic creation, partition reassignments, ACLs, and dynamic cluster configs.</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300">crabka-client-streams</td>
              <td class="py-3 px-4 text-gray-300">Stateful streaming topology DSL, windowing operators, RocksDB state stores, and interactive queries.</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300">crabka-schema-serde</td>
              <td class="py-3 px-4 text-gray-300">Schema Registry serialization (Avro, JSON Schema, Protobuf) and Apache Arrow IPC formats.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-xl font-bold text-white pt-2">Async Producer Example</h2>
      <p>
        The idempotent producer automatically initializes producer epochs and base sequences to guarantee deduplication on the broker:
      </p>

      <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3 not-prose">
