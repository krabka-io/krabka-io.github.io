---
import CodeBlock from '../../components/CodeBlock.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getPath } from '../../utils/paths';
import apiReference from '../../data/api-reference.json';

const apiHref = (id: string) => new URL(apiReference.find((entry) => entry.id === id)!.apiPath, 'https://krabka.io').href;

const producerCode = `// Cargo.toml:
//   krabka-client-producer = { git = "https://github.com/krabka-io/krabka-client-rs", rev = "c4ce581587772b3750d88c61f3389d9626a20235" }
//   plus the [patch.crates-io] block from that revision's Cargo.toml
//   bytes = "1"
//   tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
use std::time::Duration;
use bytes::Bytes;
use krabka_client_producer::{Acks, Compression, Producer, ProducerRecord};

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    // Build an idempotent producer with LZ4 compression and acks=all
    let producer = Producer::builder()
        .bootstrap("localhost:9092")
        .compression(Compression::Lz4)
        .acks(Acks::All)
        .linger(Duration::from_millis(5))
        .build()
        .await?;

    // Send record asynchronously with broker sequence deduplication
    producer
        .send(ProducerRecord {
            topic: "events".into(),
            value: Some(Bytes::from("hello krabka")),
            ..Default::default()
        })
        .await?;

    producer.flush().await?;
    producer.close().await?;
    Ok(())
}`;

const consumerCode = `use krabka_client_consumer::{AutoOffsetReset, Consumer};
use krabka_units::millis;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    // Build a subscribe-style group consumer
    let mut consumer = Consumer::builder()
        .bootstrap("localhost:9092")
        .group_id("order-processors")
        .client_id("processor-node-1")
        .auto_offset_reset(AutoOffsetReset::Earliest)
        .subscribe(["orders".to_string()])
        .build()
        .await?;

    loop {
        let records = consumer.poll(millis(500)).await?;
        for _record in records {
            // Process each record
        }
        consumer.commit_sync().await?;
    }
}`;

const shareConsumerCode = `use krabka_client_consumer::{ShareAckMode, ShareAckType, ShareConsumer};
use krabka_units::secs;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    // KIP-932 share group: records are acquired per consumer, with no partition assignment
    let mut consumer = ShareConsumer::builder()
        .bootstrap("localhost:9092")
        .group_id("share-workers")
        .subscribe(["jobs".to_string()])
        .ack_mode(ShareAckMode::Explicit)
        .build()
        .await?;

    loop {
        let records = consumer.poll(secs(1)).await?;
        for record in &records {
            consumer.acknowledge(record, ShareAckType::Accept)?;
        }
        consumer.commit().await?;
    }
}`;

const streamsCode = `use krabka_client_streams::{
    NodeHandle, Record, StringSerde, Topology, TopologyTestDriver, impl_processor,
};

struct Upper;
impl_processor! {
    impl Upper: (String, String) -> (String, String) {
        async fn process(&mut self, ctx, r) {
            ctx.forward(Record::new(r.key, r.value.to_uppercase(), r.timestamp));
        }
    }
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut topo = Topology::new();
    let src: NodeHandle<String, String> = topo.add_source("src", ["in"]);
    let up = topo.add_processor("up", || Upper, [&src]);
    topo.add_sink("out", "out", [&up]);
    let built = topo.build("my-app")?;

    // Broker-free test driver: runs the same topology in process
    let mut driver = TopologyTestDriver::new(&built)?;
    driver.pipe_input("in", (StringSerde, StringSerde), Some("k".to_string()), "hello".to_string(), 0);
    let out = driver.read_output("out", (StringSerde, StringSerde));
    assert_eq!(out, Some((Some("k".to_string()), "HELLO".to_string())));
    Ok(())
}`;
---

<DocsLayout
  title="Rust Client & Streams"
  description="Native async Rust Kafka client (Producer, Consumer, Share Groups) and Kafka Streams DSL runtime built on Tokio."
  currentSlug="/docs/streams-rs"
>
  <div class="space-y-6 font-sans">
    <div class="border-b border-white/10 pb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="text-xs text-gray-400 mb-1">
          Rust Client · Developer Preview
        </div>
        <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Rust Client & Streams</h1>
        <p class="text-gray-400 mt-2 text-sm max-w-2xl leading-relaxed">
          Asynchronous Kafka client and stream processing libraries built natively on Tokio and <code class="text-krab-300 font-mono text-xs">krabka-protocol</code>.
        </p>
      </div>

      <div class="flex flex-col gap-2 shrink-0">
        {[['client-rs', 'Browse Rustdoc: Client'], ['streams-rs', 'Browse Rustdoc: Streams']].map(([id, label]) => (
          <a
            href={apiHref(id)}
            class="inline-flex items-center justify-center rounded-lg bg-krab-500/20 hover:bg-krab-500/30 border border-krab-500/40 px-4 py-2 text-xs font-semibold text-krab-300 hover:text-white transition-colors"
          >
            {label}
          </a>
        ))}
      </div>
    </div>

    <div class="space-y-6 text-sm text-gray-300 leading-relaxed">
      <div class="p-3.5 rounded-lg bg-amber-500/10 border border-amber-500/20 text-xs text-amber-300 leading-relaxed">
        <strong class="font-semibold text-amber-200">Developer Preview Notice:</strong>
        <code class="font-mono text-amber-200">krabka-client-rs</code> and <code class="font-mono text-amber-200">krabka-streams-rs</code> are under active development. Core producer, consumer, and admin APIs are functional and tested in CI; streams DSL topology drivers are in developer preview.
      </div>

      <p>
        The Rust client ecosystem is decoupled from the broker binary, depending on <code class="font-mono text-krab-300 text-xs">krabka-protocol</code> for wire serialization. It provides memory-safe implementations of Kafka producers, consumers, admin tools, and streaming topologies without relying on librdkafka C-bindings. The client crates live in <a class="text-krab-300 hover:underline" href="https://github.com/krabka-io/krabka-client-rs">krabka-client-rs</a>; the streams crate lives in <a class="text-krab-300 hover:underline" href="https://github.com/krabka-io/krabka-streams-rs">krabka-streams-rs</a>.
      </p>

      <h2 class="text-xl font-bold text-white pt-2">Crate Architecture</h2>
      <div class="frosted-card rounded-xl overflow-hidden border border-white/10 not-prose">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/80 border-b border-white/10 uppercase text-gray-400 font-sans">
            <tr>
              <th class="py-3 px-4">Crate</th>
              <th class="py-3 px-4">Subsystem & Features</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 font-sans">
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300 whitespace-nowrap">krabka-client-core</td>
              <td class="py-3 px-4 text-gray-300">Broker connection pool, API version negotiation, typed request dispatch, retry backoff, SASL/TLS authentication.</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300 whitespace-nowrap">krabka-client-producer</td>
              <td class="py-3 px-4 text-gray-300">Idempotent producer (<code class="font-mono text-xs">InitProducerId</code>, sequence tracking), batch accumulation, and transactional APIs (KIP-447).</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300 whitespace-nowrap">krabka-client-consumer</td>
              <td class="py-3 px-4 text-gray-300">Consumer group protocol (rebalance, heartbeats, cooperative sticky assignor) and KIP-932 Share Groups.</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300 whitespace-nowrap">krabka-client-admin</td>
              <td class="py-3 px-4 text-gray-300">Administrative client for topic CRUD, partition reassignments, ACLs, configs, quotas, SCRAM credentials, and group management.</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300 whitespace-nowrap">krabka-client-coordination</td>
              <td class="py-3 px-4 text-gray-300">Leader election, leases, and fencing tokens as a Kafka client API.</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300 whitespace-nowrap">krabka-client-streams</td>
              <td class="py-3 px-4 text-gray-300">KIP-1071 streams-group membership, typed Processor API, KStream/KTable DSL with windowing, Turso-backed state stores, and interactive queries. Lives in <code class="font-mono text-xs">krabka-streams-rs</code>.</td>
            </tr>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-krab-300 whitespace-nowrap">krabka-schema-serde</td>
              <td class="py-3 px-4 text-gray-300">Schema Registry serialization (Avro, JSON Schema, Protobuf). Lives in <code class="font-mono text-xs">krabka-schema-registry</code>.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-xl font-bold text-white pt-2">Adding the Crates</h2>
      <p>
        These repositories do not publish to crates.io, and the <code class="font-mono text-xs">krabka-*</code> names there still belong to an older repository. Depend on them by git revision, and copy the <code class="font-mono text-xs">[patch.crates-io]</code> block from the <code class="font-mono text-xs">Cargo.toml</code> at the pinned revision of the repository you depend on, so that <code class="font-mono text-xs">krabka-protocol</code> and <code class="font-mono text-xs">krabka-units</code> resolve to one copy. The examples below need Rust 1.98.1 or newer, <code class="font-mono text-xs">tokio</code> with the <code class="font-mono text-xs">macros</code> and <code class="font-mono text-xs">rt-multi-thread</code> features, <code class="font-mono text-xs">bytes</code> for the producer, and <code class="font-mono text-xs">krabka-units</code> for the consumers.
      </p>

      <h2 class="text-xl font-bold text-white pt-2">Async Producer Example</h2>
      <p>
        The idempotent producer automatically initializes producer epochs and base sequences to guarantee deduplication on the broker.
        <code class="font-mono text-xs">send(record).await?</code> waits for delivery and returns metadata.
        For pipelining, <code class="font-mono text-xs">enqueue(record).await?</code> queues a record and returns a delivery handle;
        await each handle with <code class="font-mono text-xs">delivery.await?</code> to check its result.
      </p>

      <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3 not-prose">
        <div class="flex items-center justify-between text-xs text-gray-400">
          <span>Idempotent Producer (Tokio):</span>
          <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={producerCode}>
            Copy
          </button>
        </div>
        <CodeBlock code={producerCode} lang="rust" />
      </div>

      <h2 class="text-xl font-bold text-white pt-2">Consumer Groups & Share Groups</h2>
      <p>
        The consumer client supports standard consumer group rebalancing as well as next-generation KIP-932 share-group queues for cooperative record delivery:
      </p>

      <div class="grid grid-cols-1 gap-4 not-prose">
        <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3">
          <div class="flex items-center justify-between text-xs text-gray-400">
            <span>Standard Consumer Group:</span>
            <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={consumerCode}>
              Copy
            </button>
          </div>
          <CodeBlock code={consumerCode} lang="rust" />
        </div>

        <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3">
          <div class="flex items-center justify-between text-xs text-gray-400">
            <span>KIP-932 Share-Group Queue Consumer:</span>
            <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={shareConsumerCode}>
              Copy
            </button>
          </div>
          <CodeBlock code={shareConsumerCode} lang="rust" />
        </div>
      </div>

      <h2 class="text-xl font-bold text-white pt-2">Streams Topology</h2>
      <p>
        The Processor API wires nodes by typed handle, so a mismatched edge fails at compile time. <code class="font-mono text-xs">TopologyTestDriver</code> runs the built topology in process, with no broker:
      </p>

      <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3 not-prose">
        <div class="flex items-center justify-between text-xs text-gray-400">
          <span>Processor API with the test driver:</span>
          <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={streamsCode}>
            Copy
          </button>
        </div>
        <CodeBlock code={streamsCode} lang="rust" />
      </div>

      <h2 class="text-xl font-bold text-white pt-2">Related Resources</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose pt-1">
        <a href={getPath('/docs/data-formats')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Serdes & Data Formats →</div>
          <p class="text-xs text-gray-400 mt-1">Confluent Avro, Protobuf, JSON Schema, and vectorized Arrow IPC serdes.</p>
        </a>
        <a href={getPath('/docs/architecture')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Ecosystem Architecture →</div>
          <p class="text-xs text-gray-400 mt-1">Dependency graph and repository layering across the Krabka organization.</p>
        </a>
      </div>
    </div>
  </div>
</DocsLayout>
