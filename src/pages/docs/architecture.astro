---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getPath } from '../../utils/paths';

const repoHierarchy = [
  { repo: 'krabka-protocol', role: 'Wire codecs, KRaft metadata records, SASL/TLS, compression (snappy/lz4/zstd)', tier: 'Tier 0: Core Wire Layer', link: '/docs/architecture' },
  { repo: 'krabka-client-rs', role: 'Tokio async Kafka client (Producer, Consumer, Admin)', tier: 'Tier 1: Foundation Clients & Broker', link: '/docs/streams-rs' },
  { repo: 'krabka-broker', role: 'Broker engine, KRaft consensus (krabka-raft), on-disk log (krabka-log), tiered storage', tier: 'Tier 1: Foundation Clients & Broker', link: '/docs/broker' },
  { repo: 'krabka-schema-registry', role: 'Confluent-compatible schema registry backed by the compacted _schemas topic', tier: 'Tier 1: Foundation Clients & Broker', link: '/docs/runtime-architecture' },
  { repo: 'krabka-streams-rs', role: 'Rust stream runtime with schema registry serdes and disk-backed state stores', tier: 'Tier 2: Stream Processing Engines', link: '/docs/streams-rs' },
  { repo: 'krabka-streams-go', role: 'Go stream processing with Apache Arrow batch memory & barrier cuts', tier: 'Tier 2: Stream Processing Engines', link: '/docs/streams-go' },
  { repo: 'krabka-streams-java', role: 'Java stream processing with Kafka Streams 4.x and columnar operators', tier: 'Tier 2: Stream Processing Engines', link: '/docs/streams-java' },
  { repo: 'krabka-connect', role: 'Connector framework, PostgreSQL CDC over pgoutput, worker runtime & replicator', tier: 'Tier 3: Data Integration & Control Plane', link: '/docs/connect-postgres' },
  { repo: 'krabka-operator', role: 'Kubernetes operator reconciling krabka.io/v1alpha1 custom resources', tier: 'Tier 3: Data Integration & Control Plane', link: '/docs/operator' },
  { repo: 'krabka-rebalancer', role: 'Cruise-Control-style partition assignment and cluster balancing daemon', tier: 'Tier 3: Data Integration & Control Plane', link: '/docs/runtime-architecture' },
  { repo: 'krabka-cli', role: 'Admin and cluster log directory formatting CLI tool', tier: 'Tier 4: Tooling', link: '/docs/cli' },
];

// The layering diagram: one band per tier, the highest at the top, each repository a box.
const tiers = [...new Set(repoHierarchy.map((r) => r.tier))].reverse();
const W = 760, BAND = 74, GAP = 26, BOX_H = 40;
const diagramH = tiers.length * BAND + (tiers.length - 1) * GAP;
const bands = tiers.map((tier, i) => {
  const repos = repoHierarchy.filter((r) => r.tier === tier);
  const y = i * (BAND + GAP);
  const inner = W - 40;
  const boxW = Math.min(220, (inner - (repos.length - 1) * 12) / repos.length);
  const startX = 20 + (inner - (repos.length * boxW + (repos.length - 1) * 12)) / 2;
  return { tier, y, boxes: repos.map((r, j) => ({ ...r, x: startX + j * (boxW + 12), w: boxW })) };
});
---

<DocsLayout
  title="Ecosystem Architecture & Dependency Layering"
  description="Architectural layering and dependency hierarchy across the broker and Kafka ecosystem repositories in the krabka-io organization."
  currentSlug="/docs/architecture"
>
  <div class="space-y-6 font-sans">
    <div class="border-b border-white/10 pb-4">
      <div class="text-xs text-gray-400 mb-1">
        System Design · Architectural Model
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Ecosystem Architecture & Layering</h1>
      <p class="text-gray-400 mt-2 text-sm max-w-2xl leading-relaxed">
        Repository boundaries and dependencies across the <code class="font-mono text-krab-300">krabka-io</code> organization.
      </p>
    </div>

    <div class="space-y-6 text-sm text-gray-300 leading-relaxed">
      <p>
        The broker, clients, operators, and connectors live in separate repositories. Runtime services communicate through public APIs and the Kafka wire protocol. Some build-time dependencies cross these boundaries; for example, the CLI uses the broker's log-formatting crate.
      </p>

      <figure class="not-prose space-y-2">
        <svg viewBox={`0 0 ${W} ${diagramH}`} class="h-auto w-full" role="img" aria-labelledby="layers-title layers-desc">
          <title id="layers-title">Repository layering</title>
          <desc id="layers-desc">{bands.map((b) => `${b.tier}: ${b.boxes.map((x) => x.repo).join(', ')}`).join('. ')}. Each tier depends only on the tiers below it.</desc>
          <defs>
            <marker id="layer-arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto">
              <path d="M0 0 L10 5 L0 10 z" class="fill-gray-500" />
            </marker>
          </defs>
          {bands.map((b, i) => (
            <g>
              <rect x="0" y={b.y} width={W} height={BAND} rx="12" class="fill-white/[0.03] stroke-white/10" />
              <text x="14" y={b.y + 15} class="fill-gray-400 text-[10px] font-semibold uppercase tracking-wider">{b.tier}</text>
              {b.boxes.map((r) => (
                <a href={getPath(r.link)}>
                  <rect x={r.x} y={b.y + 24} width={r.w} height={BOX_H} rx="8" class="fill-ocean-900 stroke-krab-500/50 hover:stroke-krab-400" />
                  <text x={r.x + r.w / 2} y={b.y + 24 + BOX_H / 2 + 4} text-anchor="middle" class="fill-krab-300 font-mono text-[12px] font-bold">{r.repo}</text>
                </a>
              ))}
              {i < bands.length - 1 && (
                <line x1={W / 2} y1={b.y + BAND + 2} x2={W / 2} y2={b.y + BAND + GAP - 3} class="stroke-gray-500" stroke-width="1.5" marker-end="url(#layer-arrow)" />
              )}
            </g>
          ))}
        </svg>
        <figcaption class="text-xs text-gray-400">Each tier builds on the tiers below it; arrows point from a layer to what it depends on.</figcaption>
      </figure>

      <h2 class="text-xl font-bold text-white pt-2">Layering Principles</h2>
      <ul class="space-y-2 text-sm text-gray-300 list-disc pl-5 leading-relaxed">
        <li><strong class="text-white">Client and protocol dependencies:</strong> The <code class="text-krab-300 font-mono">krabka-operator</code> uses client and protocol crates to send requests to the broker.</li>
        <li><strong class="text-white">Independent Wire Layer:</strong> <code class="text-krab-300 font-mono">krabka-protocol</code> defines exact byte-level request/response codecs generated from upstream JSON specifications with zero broker or client dependencies.</li>
        <li><strong class="text-white">CLI subcommands:</strong> <code class="text-krab-300 font-mono">krabka-cli</code> compiles in administration commands and the Gres tenant registry. Other subcommands run as standalone executables found on <code class="font-mono text-xs">PATH</code>.</li>
      </ul>

      <h2 class="text-xl font-bold text-white pt-2">Repository Hierarchy & Subsystems</h2>
      <div class="frosted-card rounded-xl overflow-hidden border border-white/10 not-prose">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/80 border-b border-white/10 uppercase text-gray-400 font-sans">
            <tr>
              <th class="py-3 px-4">Repository</th>
              <th class="py-3 px-4">Architectural Tier</th>
              <th class="py-3 px-4">Subsystems & Purpose</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 font-sans">
            {repoHierarchy.map((r) => (
              <tr class="hover:bg-white/5 transition-colors">
                <td class="py-3 px-4 font-mono font-bold text-krab-300 whitespace-nowrap">
                  <a href={getPath(r.link)} class="hover:underline">{r.repo}</a>
                </td>
                <td class="py-3 px-4 text-gray-400 whitespace-nowrap">{r.tier}</td>
                <td class="py-3 px-4 text-gray-300">{r.role}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="text-xl font-bold text-white pt-2">Explore Architectural Deep Dives</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose pt-1">
        <a href={getPath('/docs/runtime-architecture')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Runtime Architecture →</div>
          <p class="text-xs text-gray-400 mt-1">Operational topology, internal broker components, and control plane reconcile loops.</p>
        </a>
        <a href={getPath('/verification')} class="p-4 rounded-xl frosted-card border border-white/10 hover:border-krab-500/50 transition-colors block">
          <div class="text-sm font-bold text-white">Correctness & Verification →</div>
          <p class="text-xs text-gray-400 mt-1">Safe Rust, Creusot-proved kernels, and Stateright models across the layered repositories.</p>
        </a>
      </div>
    </div>
  </div>
</DocsLayout>
