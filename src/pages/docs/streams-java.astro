---
import CodeBlock from '../../components/CodeBlock.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getPath } from '../../utils/paths';
import apiReference from '../../data/api-reference.json';

const apiHref = (id: string) => new URL(apiReference.find((entry) => entry.id === id)!.apiPath, 'https://krabka.io').href;
import versionsData from '../../data/versions.json';

const activeRelease = versionsData['streams-java']?.activeRelease || 'v1.4.1';
const releaseNumber = activeRelease.replace(/^v/, '');

const javaGradle = `// Gradle Kotlin DSL
dependencies {
    implementation(platform("io.krabka:krabka-streams-bom:${releaseNumber}"))
    implementation("io.krabka:krabka-streams")
    implementation("io.krabka:krabka-streams-schema-serde")
    implementation("io.krabka:krabka-streams-columnar")
    testImplementation("io.krabka:krabka-streams-test-utils")
}`;

const jvmFlag = `--add-opens=java.base/java.nio=ALL-UNNAMED`;
---

<DocsLayout
  title="Java Streams & Arrow"
  description="Java client library for stream processing with Krabka: Apache Kafka Streams API, Confluent Schema Registry serdes, and Apache Arrow columnar batch processing."
  currentSlug="/docs/streams-java"
>
  <div class="space-y-6 font-sans">
    <!-- Header -->
    <div class="border-b border-white/10 pb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="text-xs text-gray-400 mb-1">
          Java 17+ · Release {activeRelease}
        </div>
        <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Java Streams & Arrow</h1>
        <p class="text-gray-400 mt-2 text-sm max-w-2xl leading-relaxed">
          Kafka Streams 4.x compatible engine with columnar Apache Arrow operators and schema serdes via <code>krabka-streams-java</code>.
        </p>
      </div>

      <a
        href={apiHref('streams-java')}
        class="inline-flex items-center rounded-lg bg-krab-500/20 hover:bg-krab-500/30 border border-krab-500/40 px-4 py-2 text-xs font-semibold text-krab-300 hover:text-white transition-colors shrink-0"
      >
        Browse Javadoc Reference
      </a>
    </div>

    <div class="space-y-6 text-sm text-gray-300 leading-relaxed">
      <p>
        <code>krabka-streams-java</code> is the Java client library for stream processing with Krabka. It exports the standard Kafka Streams API and adds native support for Confluent Schema Registry and Apache Arrow direct-memory processing. The library targets Java 17 bytecode, and continuous integration compiles and tests it on JDK 17 and JDK 21.
      </p>

      <!-- Architecture & Engineering Guides -->
      <div class="space-y-3 pt-2">
        <div>
          <h2 class="text-xl font-bold text-white">Architecture & Engineering Guides</h2>
          <p class="text-sm text-gray-300 mt-1">
            In-depth technical guides maintained alongside the Java codebase:
          </p>
        </div>
        <ul class="space-y-2 text-sm text-gray-300 list-disc pl-5 marker:text-krab-400">
          <li>
            <a href={getPath('/docs/streams-java/getting-started')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Getting Started:</a> Prerequisites, dependency coordinates, and your first streaming pipeline.
          </li>
          <li>
            <a href={getPath('/docs/streams-java/columnar')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Columnar Processing:</a> VectorSchemaRoot batch execution, codecs, and topology lifecycle.
          </li>
          <li>
            <a href={getPath('/docs/streams-java/columnar-operators')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Columnar Operators:</a> Direct off-heap buffer allocation, try-with-resources, and zero-copy filters.
          </li>
          <li>
            <a href={getPath('/docs/streams-java/serdes')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Serdes:</a> Avro, Protobuf, and JSON Schema serdes with non-blocking schema caching.
          </li>
          <li>
            <a href={getPath('/docs/streams-java/schema-registry')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Schema Registry:</a> Confluent Schema Registry client integration, schema evolution, and wire protocol.
          </li>
          <li>
            <a href={getPath('/docs/streams-java/barriers')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Barrier Alignment:</a> Synchronous checkpoint cuts across multi-partition consumer topologies.
          </li>
          <li>
            <a href={getPath('/docs/streams-java/coordination')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Coordination:</a> Distributed leader election, fencing tokens, and lease succession semantics.
          </li>
          <li>
            <a href={getPath('/docs/streams-java/testing')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Testing:</a> Mock topologies in-memory with ColumnarTestDriver and SchemaRegistryStub.
          </li>
          <li>
            <a href={getPath('/docs/streams-java/troubleshooting')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Troubleshooting:</a> Common JVM flags, buffer allocator diagnostics, and error resolutions.
          </li>
          <li>
            <a href={getPath('/docs/streams-java/build-and-release')} class="font-semibold text-krab-400 hover:text-krab-300 hover:underline transition-colors">Build and Release:</a> Hermetic Bazel build targets, Maven Central publishing, and Javadoc generation.
          </li>
        </ul>
      </div>

      <!-- Dependency Coordinates -->
      <h2 class="text-xl font-bold text-white pt-2">Dependency Coordinates</h2>
      <div class="frosted-card rounded-xl p-5 border border-white/10 space-y-3">
        <div class="flex items-center justify-between text-xs text-gray-400">
          <span>Gradle Kotlin DSL</span>
          <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors text-xs" data-copy={javaGradle}>
            Copy
          </button>
        </div>
        <CodeBlock code={javaGradle} lang="kotlin" />
      </div>

      <p class="text-sm text-gray-300">
        Maven Central holds release <code>{releaseNumber}</code> of all seven modules below, and earlier releases 1.0.0 and 1.1.0 of <code>krabka-streams</code>, <code>krabka-streams-schema-serde</code>, <code>krabka-streams-columnar</code>, and <code>krabka-streams-test-utils</code>. The bill of materials keeps the module versions aligned, so declare it once and leave the individual dependencies without a version.
      </p>

      <!-- Published Modules -->
      <h2 class="text-xl font-bold text-white pt-2">Published Modules</h2>
      <div class="frosted-card rounded-xl overflow-hidden border border-white/10">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-slate-950/80 border-b border-white/10 uppercase tracking-wider text-gray-400 font-semibold">
            <tr>
              <th class="py-3 px-4">Artifact</th>
              <th class="py-3 px-4">Purpose</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <tr class="hover:bg-white/5"><td class="py-2.5 px-4 font-mono font-medium text-krab-300">io.krabka:krabka-streams</td><td class="py-2.5 px-4 text-gray-400">Apache Kafka Streams API and krabka defaults</td></tr>
            <tr class="hover:bg-white/5"><td class="py-2.5 px-4 font-mono font-medium text-krab-300">io.krabka:krabka-streams-schema-serde</td><td class="py-2.5 px-4 text-gray-400">Avro, Protobuf, and JSON Schema serdes</td></tr>
            <tr class="hover:bg-white/5"><td class="py-2.5 px-4 font-mono font-medium text-krab-300">io.krabka:krabka-streams-columnar</td><td class="py-2.5 px-4 text-gray-400">Apache Arrow batch processing and zero-copy operators</td></tr>
            <tr class="hover:bg-white/5"><td class="py-2.5 px-4 font-mono font-medium text-krab-300">io.krabka:krabka-streams-columnar-schema</td><td class="py-2.5 px-4 text-gray-400">Avro and Protobuf Arrow memory bridges</td></tr>
            <tr class="hover:bg-white/5"><td class="py-2.5 px-4 font-mono font-medium text-krab-300">io.krabka:krabka-streams-coordination</td><td class="py-2.5 px-4 text-gray-400">Leader election, leases, and fencing tokens</td></tr>
            <tr class="hover:bg-white/5"><td class="py-2.5 px-4 font-mono font-medium text-krab-300">io.krabka:krabka-streams-test-utils</td><td class="py-2.5 px-4 text-gray-400">ColumnarTestDriver and SchemaRegistryStub helpers</td></tr>
            <tr class="hover:bg-white/5"><td class="py-2.5 px-4 font-mono font-medium text-krab-300">io.krabka:krabka-streams-bom</td><td class="py-2.5 px-4 text-gray-400">Bill of Materials dependency constraints</td></tr>
          </tbody>
        </table>
      </div>

      <!-- JVM Requirements -->
      <h2 class="text-xl font-bold text-white pt-2">Direct Buffer JVM Requirement</h2>
      <p class="text-sm text-gray-300">
        Arrow 19 needs this JVM option when it uses direct buffers:
      </p>
      <div class="bg-black/50 p-3 rounded-lg border border-white/5 font-mono text-xs text-gray-300 flex items-center justify-between">
        <span>{jvmFlag}</span>
        <button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-colors" data-copy={jvmFlag}>
          Copy Flag
        </button>
      </div>

      <!-- Version & Compatibility Reference -->
      <h2 class="text-xl font-bold text-white pt-2">Version & Compatibility</h2>
      <div class="frosted-card rounded-xl overflow-hidden border border-white/10">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-slate-950/80 border-b border-white/10 uppercase tracking-wider text-gray-400 font-semibold">
            <tr>
              <th class="py-2.5 px-4">Component</th>
              <th class="py-2.5 px-4">Supported Version</th>
              <th class="py-2.5 px-4">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-gray-300">
            <tr>
              <td class="py-2 px-4 font-medium text-white">Java Bytecode</td>
              <td class="py-2 px-4">Java 17 or later (CI: JDK 17, JDK 21)</td>
              <td class="py-2 px-4 text-gray-400">Compiled with a Java 17 toolchain; JDK 25 runs only the Javadoc tool</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-medium text-white">Kafka Wire Protocol</td>
              <td class="py-2 px-4">Kafka 4.3.1</td>
              <td class="py-2 px-4 text-gray-400">Transitive api dependency</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-medium text-white">Apache Arrow</td>
              <td class="py-2 px-4">19.0.0</td>
              <td class="py-2 px-4 text-gray-400">Direct off-heap memory allocators</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-medium text-white">Krabka Broker</td>
              <td class="py-2 px-4">Apache Kafka 4.3.1 or a Krabka broker</td>
              <td class="py-2 px-4 text-gray-400">The streams group protocol must be enabled and streams.version=1 finalized</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm text-gray-300">
        Full version matrices and SLSA Level 3 build provenance records are tracked on the <a href={getPath('/versions')} class="text-krab-400 hover:underline">Versions page</a>.
      </p>
    </div>
  </div>
</DocsLayout>
