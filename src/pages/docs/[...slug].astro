---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Compute GitHub source provenance and component label
const [component, ...rest] = entry.id.split('/');
const subPath = rest.join('/');

const componentLabelMap: Record<string, string> = {
  'streams-java': 'Java Streams',
  'streams-go': 'Go Streams',
  'streams-rs': 'Rust Streams',
  'broker': 'Broker',
  'connect': 'Connect',
  'operator': 'Operator',
  'cli': 'CLI',
};

const baseTitle = entry.data?.title || headings[0]?.text || 'Documentation Guide';
const label = componentLabelMap[component];
const title = label ? `${baseTitle} (${label})` : baseTitle;
const description = entry.data?.description || `Krabka ${label || component} technical guide and architectural documentation.`;

const repoMap: Record<string, string> = {
  'streams-java': 'krabka-streams-java',
  'streams-go': 'krabka-streams-go',
  'broker': 'krabka-broker',
  'streams-rs': 'krabka-streams-rs',
  'connect': 'krabka-connect',
  'operator': 'krabka-operator',
  'cli': 'krabka-cli',
};

const repoName = repoMap[component] || `krabka-${component}`;
const sourceFilePath = `docs/${subPath}.md`;
const githubFileUrl = `https://github.com/krabka-io/${repoName}/blob/main/${sourceFilePath}`;
---

<DocsLayout
  title={title}
  description={description}
  currentSlug={`/docs/${entry.id}`}
  headings={headings}
>
  <article class="markdown-body">
    <Content />

    <!-- Source Document & Build Provenance Footer -->
    <footer class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-gray-400">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span>Source document:</span>
        <a
          href={githubFileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-300 hover:text-white underline font-mono text-[11px]"
        >
          {repoName}/{sourceFilePath}
        </a>
      </div>
      <div class="text-gray-400">
        Generated during build · Krabka Documentation Hub
      </div>
    </footer>
  </article>
</DocsLayout>
