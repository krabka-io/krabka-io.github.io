---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getPath } from '../../utils/paths';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Compute GitHub source provenance and component label
const [component, ...rest] = entry.id.split('/');
const subPath = rest.join('/');

const componentLabelMap: Record<string, string> = {
  'streams-java': 'Java Streams',
  'streams-go': 'Go Streams',
  'streams-rs': 'Rust Streams',
  'broker': 'Broker',
  'connect': 'Connect',
  'operator': 'Operator',
  'cli': 'CLI',
};

const baseTitle = entry.data?.title || headings[0]?.text || 'Documentation Guide';
const label = componentLabelMap[component];
const title = label ? `${baseTitle} (${label})` : baseTitle;
const description = entry.data?.description || `krabka ${label || component} technical guide and architectural documentation.`;

const repoMap: Record<string, string> = {
  'streams-java': 'krabka-streams-java',
  'streams-go': 'krabka-streams-go',
  'broker': 'krabka-broker',
  'streams-rs': 'krabka-streams-rs',
  'connect': 'krabka-connect',
  'operator': 'krabka-operator',
  'cli': 'krabka-cli',
};

const repoName = repoMap[component] || `krabka-${component}`;
const sourceFilePath = `docs/${subPath}.md`;
const githubFileUrl = `https://github.com/krabka-io/${repoName}/blob/main/${sourceFilePath}`;

// A synced guide that the site also renders in a purpose-built form gets a
// pointer to that form above the verbatim document.
const companions: Record<string, { text: string; label: string; href: string }> = {
  'broker/verification': {
    text: 'This is the broker\'s catalog as written, with its proof ledger as one wide table. The same rows, one per kernel and per model, are also available as an expandable, filterable ledger.',
    label: 'Open the evidence ledger',
    href: getPath('/verification#creusot'),
  },
};
const companion = companions[entry.id];
---

<DocsLayout
  title={title}
  description={description}
  currentSlug={`/docs/${entry.id}`}
  headings={headings}
>
  <article class="markdown-body">
    {companion && (
      <aside aria-label="Companion page" class="mb-6 flex flex-col gap-3 rounded-xl border border-krab-500/30 bg-krab-500/5 px-4 py-3 text-sm text-gray-300 sm:flex-row sm:items-center sm:justify-between">
        <p class="m-0 leading-relaxed">{companion.text}</p>
        <a href={companion.href} class="inline-flex shrink-0 items-center justify-center rounded-lg bg-krab-600 px-3 py-1.5 text-xs font-semibold text-white! no-underline! transition-colors hover:bg-krab-700">
          {companion.label}
        </a>
      </aside>
    )}
    <Content />

    <!-- Source Document & Build Provenance Footer -->
    <footer class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-gray-400">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span>Source document:</span>
        <a
          href={githubFileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-300 hover:text-white underline font-mono text-[11px]"
        >
          {repoName}/{sourceFilePath}
        </a>
      </div>
      <div class="text-gray-400">
        Generated during build · krabka Documentation Hub
      </div>
    </footer>
  </article>
</DocsLayout>
