---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceLedger from '../components/EvidenceLedger.astro';
import type { EvidenceItem } from '../components/EvidenceLedger.astro';
import { codeToHtml } from 'shiki';
import { getPath } from '../utils/paths';
import krabTheme from '../utils/krabka-shiki-theme.mjs';
import { loadVerificationData } from '../utils/verification-loader';

// Every count and every ledger row below comes from the broker's verification
// catalog, which `scripts/sync-docs.mjs` copies in before a build, joined with
// the site's own data files. A checkout that never synced still builds, and the
// copy says which counts are missing.
const { stats, catalog, kernels, models } = loadVerificationData();
const hasCatalog = stats.catalogAvailable;
const n = (value: number) => value.toLocaleString('en-US');
const section = (slug: string) => catalog.sections.find((s) => s.slug === slug);

const brokerRepo = 'https://github.com/krabka-io/krabka-broker';
const verifiedCrateUrl = `${brokerRepo}/tree/main/crates/verified`;
const protocolRepo = 'https://github.com/krabka-io/krabka-protocol';
const creusotUrl = 'https://creusot.rs/';
const staterightUrl = 'https://www.stateright.rs/';
const catalogPath = getPath('/docs/broker/verification');
const playgroundPath = getPath('/docs/verification-playground');
const modelGalleryPath = getPath('/docs/verification-playground#models');
const consensusPlaygroundPath = getPath('/docs/playground');
const mutantsBaselinePath = getPath('/docs/broker/mutants-baseline');

interface Tile {
  value: string;
  label: string;
  sub: string;
  href: string;
}

const tiles: Tile[] = [
  { value: '0', label: 'lines of unsafe Rust', sub: 'forbid-level lint under Cargo and Bazel', href: '#memory-safety' },
  hasCatalog
    ? { value: n(stats.functions), label: 'proved kernel functions', sub: `${n(stats.rows)} ledger rows across ${n(stats.modules)} modules`, href: '#creusot' }
    : { value: 'Proved', label: 'kernel functions', sub: 'ledger counts unavailable in this build', href: '#creusot' },
  hasCatalog
    ? { value: n(stats.proofSessions), label: 'Why3 proof sessions', sub: 're-discharged on every pull request', href: '#creusot' }
    : { value: 'Why3', label: 'proof sessions', sub: 're-discharged on every pull request', href: '#creusot' },
  { value: n(stats.models), label: 'Stateright models', sub: `${n(stats.pinnedTotal)} pinned unique states`, href: '#stateright' },
  { value: n(stats.explorerKernels), label: 'kernels runnable in your browser', sub: 'compiled to WebAssembly, contract beside the result', href: playgroundPath },
  { value: 'Every PR', label: 'proofs, models and compatibility gates', sub: 'mutation sweeps run weekly per crate', href: '#evidence' },
];

const stripCaption = hasCatalog
  ? "Counts are derived from the broker's verification catalog at build time. One ledger row can hold several related kernels, so rows and functions differ."
  : "The verification catalog was not synced into this build, so the ledger rows and the counts derived from them are unavailable here. Model, state and playground counts come from the site's own data files.";

// Rows for the "other evidence" tab. The first three are the independent
// failure signals; the rest carry the catalog's own sections verbatim.
const localEvidence: EvidenceItem[] = [
  {
    id: 'mutation-testing',
    title: 'Mutation testing with cargo-mutants',
    kind: 'Mutation testing',
    area: 'Independent failure signals',
    claim: 'cargo-mutants inserts faults into production code and the suite must detect each one; sweeps run weekly per crate, and a skip is accepted only with a stated reason that a lint enforces.',
    body_html: [
      `<p>Mutation testing inserts faults into production code and checks whether the test suite detects them. A surviving mutant is a change the suite did not detect.</p>`,
      `<p>The <a href="${mutantsBaselinePath}">mutation sweep baseline</a> records the last run in which each swept crate had no surviving mutants.</p>`,
    ].join(''),
    links: [
      { label: 'Mutation sweep baseline', url: mutantsBaselinePath },
      { label: 'README: mutation testing', url: `${brokerRepo}/blob/main/README.md#mutation-testing` },
      { label: 'README: skipping a mutant', url: `${brokerRepo}/blob/main/README.md#skipping-a-mutant` },
    ],
  },
  {
    id: 'differential-suites',
    title: 'Differential and JVM acceptance suites',
    kind: 'Differential testing',
    area: 'Independent failure signals',
    claim: 'Digest-pinned Apache Kafka and Confluent Platform brokers run beside krabka, real kafka-clients drive both, and responses are compared byte for byte.',
    body_html: [
      `<p>Digest-pinned Apache Kafka and Confluent Platform brokers run beside krabka. Real <code>kafka-clients</code> and the standard admin tools drive both, and responses are compared byte for byte.</p>`,
      `<p>The wire layer in <a href="${protocolRepo}" target="_blank" rel="noopener noreferrer">krabka-protocol</a> generates its codecs from the upstream Apache Kafka JSON schemas, so a malformed request is a decode error, not undefined behavior. Protocol encoding and decoding sit largely outside both formal tiers, so these suites are the evidence that the generated codecs are byte exact against a live Kafka.</p>`,
    ].join(''),
    links: [
      { label: 'README: container suites', url: `${brokerRepo}/blob/main/README.md#container-suites` },
      { label: 'krabka-protocol', url: protocolRepo },
    ],
  },
  {
    id: 'crash-recovery-tests',
    title: 'Crash-recovery and property tests',
    kind: 'Property and crash testing',
    area: 'Independent failure signals',
    claim: 'Unit, property-based, integration and crash-recovery tests cover the boundaries that neither formal tier reaches.',
    body_html: [
      `<p>Unit, property-based, integration, and crash-recovery tests cover the boundaries that neither formal tier reaches, including protocol codecs, I/O, and async orchestration.</p>`,
      `<p>Those tests are evidence, but they are not a Creusot proof or a Stateright model check. The catalog's <a href="${catalogPath}#outside-both-tiers">Outside both tiers</a> section names what they cover on their own.</p>`,
    ].join(''),
    links: [{ label: 'Outside both tiers, in the catalog', url: `${catalogPath}#outside-both-tiers` }],
  },
];

interface CatalogEvidenceSpec {
  slug: string;
  title: string;
  kind: string;
  claim: string;
  links?: { label: string; url: string }[];
}

const catalogEvidenceSpecs: CatalogEvidenceSpec[] = [
  {
    slug: 'development-evidence',
    title: 'Development evidence',
    kind: 'Process',
    claim: 'Human and AI changes pass the same build, test, proof, model-check and compatibility gates, and the checks have independent failure signals.',
    links: [{ label: 'Mutation sweep baseline', url: mutantsBaselinePath }],
  },
  {
    slug: 'catalog-boundary',
    title: 'Catalog boundary',
    kind: 'Scope',
    claim: 'What belongs in the Creusot ledger, what belongs in the Stateright inventory, and what the closure audit found.',
  },
  {
    slug: 'run-the-creusot-proofs',
    title: 'Run the proofs yourself',
    kind: 'Reproduce',
    claim: 'A pinned Creusot release, the commands that re-run every proof, and an unproved goal that fails CI.',
    links: [{ label: 'krabka-verified on GitHub', url: verifiedCrateUrl }],
  },
  {
    slug: 'outside-both-tiers',
    title: 'Outside both tiers',
    kind: 'Boundary',
    claim: 'Protocol codecs, network and async orchestration, I/O and operational configuration are covered by tests, not by proofs or models.',
  },
];

// The catalog renders its fenced code as plain <pre><code>; colour it with the
// site theme so it reads like every other snippet.
const unescapeHtml = (t: string) =>
  t.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, '&');
async function highlightFences(html: string): Promise<string> {
  let out = html;
  for (const m of html.matchAll(/<pre><code(?: class="language-([\w-]+)")?>([\s\S]*?)<\/code><\/pre>/g)) {
    out = out.replace(m[0], await codeToHtml(unescapeHtml(m[2]), { lang: m[1] ?? 'text', theme: krabTheme }));
  }
  return out;
}

const catalogEvidence: EvidenceItem[] = (
  await Promise.all(
    catalogEvidenceSpecs.map(async (spec): Promise<EvidenceItem[]> => {
      const found = section(spec.slug);
      if (!found) return [];
      return [
        {
          id: spec.slug,
          title: spec.title,
          kind: spec.kind,
          area: 'From the catalog',
          claim: spec.claim,
          body_html: await highlightFences(found.html.join('')),
          links: [{ label: 'Read in the catalog', url: `${catalogPath}#${spec.slug}` }, ...(spec.links ?? [])],
        },
      ];
    }),
  )
).flat();

const evidence: EvidenceItem[] = [...localEvidence, ...catalogEvidence];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'How krabka Is Verified: Safe Rust, Creusot Proofs, and Stateright Model Checking',
  description:
    'How the krabka Kafka-compatible broker establishes correctness: forbidden unsafe Rust, Creusot-proved decision kernels, exhaustive Stateright model checking, mutation testing, and differential suites against live Apache Kafka.',
  author: {
    '@type': 'Organization',
    name: 'krabka Authors',
    url: 'https://krabka.io',
  },
  keywords:
    'krabka verification, Creusot, Stateright, formal verification Kafka, model checking Kafka, memory safe Kafka broker, Rust Kafka correctness',
};
---

<BaseLayout
  image="/og/verification.png"
  title="Correctness & Verification: Safe Rust, Creusot, Stateright | krabka"
  description="How krabka establishes correctness: forbidden unsafe Rust, Creusot-proved decision kernels, exhaustive Stateright model checking, mutation testing, and differential suites against live Apache Kafka."
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 font-sans">
    <header class="mb-8 border-b border-white/10 pb-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Correctness &amp; Verification
      </h1>
      <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-gray-300 sm:text-base">
        The broker forbids unsafe Rust, uses <a href={creusotUrl} target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Creusot</a>-proved decision kernels, and has <a href={staterightUrl} target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Stateright</a> models for event sequences within stated bounds. Pull request CI reruns the proofs and models. The ledger below lists what each check covers and the assumptions it requires.
      </p>
    </header>

    <!-- Stat strip -->
    <section class="mb-10" aria-label="Verification at a glance">
      <div class="grid grid-cols-2 gap-2 sm:gap-3 md:grid-cols-3 xl:grid-cols-6">
        {tiles.map((tile) => (
          <a href={tile.href} class="frosted-card block min-w-0 rounded-xl p-3 transition-colors hover:border-krab-500/40 sm:p-4">
            <div class="text-xl font-extrabold tracking-tight text-white [overflow-wrap:anywhere] sm:text-2xl">{tile.value}</div>
            <div class="mt-1 text-xs font-semibold leading-snug text-gray-200 [overflow-wrap:anywhere]">{tile.label}</div>
            <div class="mt-0.5 text-xs leading-snug text-gray-400 [overflow-wrap:anywhere]">{tile.sub}</div>
          </a>
        ))}
      </div>
      <p class="mt-2 text-xs leading-snug text-gray-400">{stripCaption}</p>
    </section>

    <!-- Pillars -->
    <section class="mb-10" aria-label="The three tiers">
      <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
        <article id="memory-safety" data-pillar class="frosted-card min-w-0 scroll-mt-24 rounded-2xl p-5">
          <div class="text-xs font-semibold uppercase tracking-wider text-krab-400">Memory safety</div>
          <h2 class="mt-1 text-base font-bold text-white">Zero <code class="font-mono">unsafe</code></h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-300 [overflow-wrap:anywhere]">
            krabka workspace code forbids <code class="pill-code">unsafe_code</code> as a compiler-enforced lint under Cargo and Bazel. Safe Rust checks memory access and data races at compile time; dependencies remain outside this workspace lint.
          </p>
          <details class="drill mt-3">
            <summary>
              <svg aria-hidden="true" class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
              How it works
            </summary>
            <div class="drill-body">
              <p>
                krabka is written in safe Rust. The workspace lint <code>unsafe_code = "forbid"</code> cannot be overridden by an inner attribute, and the Bazel build passes the same <code>-Funsafe_code</code> flag. Clippy runs at the <code>pedantic</code> level with warnings promoted to errors, and no suppression attributes are accepted.
              </p>
              <p>
                The wire layer in <a href={protocolRepo} target="_blank" rel="noopener noreferrer">krabka-protocol</a> generates its codecs from the upstream Apache Kafka JSON schemas, so a malformed request is a decode error, not undefined behavior. Byte exactness against Kafka is checked by differential suites that run digest-pinned Apache Kafka and Confluent Platform brokers beside krabka and compare live responses.
              </p>
            </div>
          </details>
        </article>

        <article id="proof-contracts" data-pillar class="frosted-card min-w-0 scroll-mt-24 rounded-2xl p-5">
          <div class="text-xs font-semibold uppercase tracking-wider text-krab-400">Formal verification</div>
          <h2 class="mt-1 text-base font-bold text-white">Creusot proof kernels</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-300 [overflow-wrap:anywhere]">
            Safety-critical decisions live in <a href={verifiedCrateUrl} target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300"><code class="pill-code">krabka-verified</code></a> as pure kernels with pre- and postconditions; <a href={creusotUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-krab-400 underline underline-offset-2 hover:text-krab-300">Creusot</a>, a deductive verifier for Rust, translates them to <a href="https://why3.org/" target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Why3</a> and automated provers discharge the contracts.
          </p>
          <details class="drill mt-3">
            <summary>
              <svg aria-hidden="true" class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
              How it works
            </summary>
            <div class="drill-body">
              <p>
                A function carries <code>#[requires]</code> and <code>#[ensures]</code> contracts beside its body, and the proof obligations go to SMT solvers through Why3. A discharged proof establishes the postconditions for inputs that satisfy the preconditions.
              </p>
              <p>
                krabka extracts each safety-critical decision into a small, total, synchronous kernel in the <code>krabka-verified</code> crate. A host crate maps its state into the kernel's inputs, calls it, and applies the result. There is no second copy of any decision, so the proved body is the body that runs in production.
              </p>
              <ul>
                <li><strong>Proof sessions are source.</strong> Why3 sessions live under <code>verif/</code> in the repository. A contract change without a matching proof update fails the build.</li>
                <li><strong>Re-discharged on every pull request.</strong> CI runs a pinned Creusot image against every package in Creusot's scope. A package-discovery check fails if a crate that writes contracts is missing from the proof run.</li>
                <li><strong>Preconditions are the caller's job.</strong> The verification catalog lists what each host must establish before a proof applies. A proved kernel does not prove its caller, and the catalog says so.</li>
              </ul>
              <p>
                The kernels do no I/O, so they also compile to WebAssembly. The <a href={playgroundPath}>verification playground</a> evaluates {n(stats.explorerKernels)} of them in your browser, with each function's contract beside the result.
              </p>
            </div>
          </details>
        </article>

        <article id="model-bounds" data-pillar class="frosted-card min-w-0 scroll-mt-24 rounded-2xl p-5">
          <div class="text-xs font-semibold uppercase tracking-wider text-krab-400">Model checking</div>
          <h2 class="mt-1 text-base font-bold text-white">Stateright models</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-300 [overflow-wrap:anywhere]">
            Where correctness depends on a sequence of crashes, retries and interleavings, a <a href={staterightUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-krab-400 underline underline-offset-2 hover:text-krab-300">Stateright</a> model explores every reachable state within stated bounds and reports a counterexample trace if a property fails.
          </p>
          <details class="drill mt-3">
            <summary>
              <svg aria-hidden="true" class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
              How it works
            </summary>
            <div class="drill-body">
              <p>
                Stateright is a model checker for Rust. A model declares its actors, the actions each may take, and the properties that must hold. The checker performs a breadth-first search over every reachable state within the model's bounds, and when a property fails it prints the exact sequence of actions that broke it.
              </p>
              <p>
                Some krabka models drive a production decision function directly. Others compose real decision functions with a small environment of crashes, retries, and message reordering. Each model's module comment states its bounds, its properties, and its <code>DRIVEN</code> and <code>MODELED</code> notes, so a reader can tell what the property says about production before relying on it.
              </p>
              <ul>
                <li><strong>Pinned state counts.</strong> An exhaustive search over a fixed model visits a deterministic set of states. Each runner asserts its unique-state count against a pinned constant, so an action generator that silently drops a branch fails the build instead of passing a smaller search.</li>
                <li><strong>Never skipped by impact analysis.</strong> Pull request CI explicitly runs every Bazel target that contains a model entry point, separately from change-based test selection, so an unrelated edit cannot skip a model check.</li>
              </ul>
              <p>
                The <a href={modelGalleryPath}>model gallery</a> lists every entry point with what it drives, its bounds, its properties, and its pinned state counts. The model rows below carry the same facts, with the catalog's own paragraphs where it has them.
              </p>
            </div>
          </details>
        </article>
      </div>
    </section>

    <!-- Ledger -->
    <section class="mb-10" aria-labelledby="ledger-heading">
      <h2 id="ledger-heading" class="text-xl font-bold text-white">The evidence, row by row</h2>
      <p class="mt-1 max-w-[70ch] text-sm leading-relaxed text-gray-400">
        Every row expands to what is proved or checked, who calls it, and what it assumes.
      </p>
      {!hasCatalog && (
        <p class="mt-3 max-w-[70ch] rounded-lg border border-amber-500/30 bg-amber-500/5 px-3 py-2 text-xs leading-snug text-amber-200/90">
          Catalog rows are unavailable in this build: the synced verification catalog is missing, so the kernel tab and the catalog-backed evidence rows are empty. The published site includes them.
        </p>
      )}
      <div class="mt-4 min-w-0">
        <EvidenceLedger
          kernels={kernels}
          models={models}
          evidence={evidence}
          kernelNotes={catalog.ledgerNotes}
          modelNotes={catalog.modelNotes}
          initialTab="kernels"
          playgroundPath={playgroundPath}
          catalogPath={catalogPath}
          explorerPath={getPath('/docs/proof-explorer')}
        />
      </div>
    </section>

    <!-- Boundary -->
    <section class="mb-6">
      <div class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-5 sm:p-6">
        <h2 id="boundary" class="scroll-mt-24 text-base font-bold text-white">Where the formal boundary ends</h2>
        <p class="mt-2 max-w-[80ch] text-sm leading-relaxed text-gray-300">
          This is not a whole-system formal proof: Creusot proves kernels, and a proof applies only when the caller establishes the listed preconditions, while Stateright checks a model within its bounds and says nothing beyond them. Protocol encoding and decoding, network and async orchestration, file and object-store I/O, and operational configuration are covered by tests, not by proofs. The verification catalog in the broker repository states the boundary in detail and lists every proof and every model.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a
            href={catalogPath}
            class="inline-flex max-w-full items-center rounded-lg bg-krab-600 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-krab-700"
          >
            Read the verification catalog
          </a>
          <a
            href={verifiedCrateUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex max-w-full items-center rounded-lg border border-white/20 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-white/10"
          >
            Browse krabka-verified on GitHub
          </a>
          <a
            href={playgroundPath}
            class="inline-flex max-w-full items-center rounded-lg border border-white/20 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-white/10"
          >
            Evaluate the verified kernels in your browser
          </a>
          <a
            href={consensusPlaygroundPath}
            class="inline-flex max-w-full items-center rounded-lg border border-white/20 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-white/10"
          >
            Try the KRaft consensus playground
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .pill-code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.85em;
    color: #ffb39e;
    overflow-wrap: anywhere;
  }

  .drill summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    color: #ff8466;
    user-select: none;
  }

  .drill summary:hover {
    color: #ffb39e;
  }

  .drill summary svg {
    transition: transform 0.15s ease;
  }

  .drill[open] summary svg {
    transform: rotate(90deg);
  }

  .drill-body {
    display: grid;
    gap: 0.625rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #9ca3af;
    overflow-wrap: anywhere;
  }

  .drill-body strong {
    font-weight: 600;
    color: #f3f4f6;
  }

  .drill-body code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.85em;
    color: #ffb39e;
    overflow-wrap: anywhere;
  }

  .drill-body a {
    font-weight: 600;
    color: #ff8466;
    /* A link in a sentence is told apart from the text by more than its colour. */
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .drill-body a:hover {
    color: #ffb39e;
  }

  .drill-body ul {
    display: grid;
    gap: 0.5rem;
    padding-left: 1rem;
    list-style: disc;
  }
</style>

<script>
  // A link that targets a pillar card also opens its drilldown, so the text the
  // link points at is visible on arrival rather than folded away.
  const openTargetedPillar = () => {
    const id = decodeURIComponent(window.location.hash.slice(1));
    if (id === '') return;
    const pillar = document.getElementById(id);
    if (!pillar || !pillar.hasAttribute('data-pillar')) return;
    const details = pillar.querySelector('details');
    if (details) details.open = true;
  };
  openTargetedPillar();
  window.addEventListener('hashchange', openTargetedPillar);
</script>
