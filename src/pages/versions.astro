---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEcosystemVersions } from '../utils/versions';
import wireMatrix from '../data/kafka-wire-matrix.json';

const ecosystemRepos = await getEcosystemVersions();

const provenanceSnippet = `# Verify broker container image signature with Sigstore
cosign verify ghcr.io/krabka-io/krabka-broker:latest \\
  --certificate-identity-regexp '^https://github.com/krabka-io/' \\
  --certificate-oidc-issuer https://token.actions.githubusercontent.com

# Verify broker release binary SLSA Level 3 build provenance
gh attestation verify krabka-broker-linux-amd64.tar.gz --repo krabka-io/krabka-broker

# Verify Java client artifact signature
gpg --verify krabka-streams-1.1.0.jar.asc krabka-streams-1.1.0.jar`;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Krabka Release Status & Kafka Wire Parity",
  "description": "Live repository branch statuses, Apache Kafka wire-protocol compatibility targets (Kafka 2.8 to 4.x), and release tracks across krabka-io packages.",
  "url": "https://krabka-io.github.io/versions/",
  "mainEntity": {
    "@type": "ItemList",
    "name": "Krabka Ecosystem Repositories",
    "numberOfItems": ecosystemRepos.length,
    "itemListElement": ecosystemRepos.map((item, idx) => ({
      "@type": "SoftwareApplication",
      "position": idx + 1,
      "name": item.repo,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": item.target,
      "softwareVersion": item.releaseVersion || `${item.manifestVersion}-dev`,
      "url": `https://github.com/krabka-io/${item.repo}`
    }))
  }
};
---

<BaseLayout
  title="Release Status & Kafka Wire Parity | Krabka"
  description="Live repository branch statuses, Apache Kafka wire-protocol compatibility targets (Kafka 2.8 to 4.x), and release tracks across krabka-io packages."
>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 font-sans">
    <div class="text-left border-b border-white/10 pb-8 mb-16 max-w-3xl">
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Release Status & Compatibility
      </h1>
      <p class="mt-4 text-lg text-gray-300">
        Krabka is in active greenfield development. This page tracks repository branch statuses, release milestones, and Apache Kafka wire-protocol compatibility targets across the ecosystem.
      </p>
    </div>

    <!-- Section 1: Repository & Packages Status -->
    <div id="packages" class="mb-20">
      <h2 class="text-2xl font-bold text-white mb-2">Repository & Packages Status</h2>
      <p class="text-gray-400 text-sm mb-6">
        Current branches, releases, and target runtimes across krabka-io.
      </p>

      <div class="frosted-card rounded-2xl overflow-hidden border border-white/10">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm" aria-label="Repository and packages status">
            <thead class="border-b border-white/10 bg-slate-950/80 text-xs font-semibold uppercase text-gray-400">
              <tr>
                <th scope="col" class="py-4 px-6">Repository</th>
                <th scope="col" class="py-4 px-6">Current Track</th>
                <th scope="col" class="py-4 px-6">Readiness</th>
                <th scope="col" class="py-4 px-6">Target Runtime</th>
                <th scope="col" class="py-4 px-6">Provenance</th>
                <th scope="col" class="py-4 px-6 text-right">History</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {ecosystemRepos.map((item) => (
                <tr class="hover:bg-white/5 transition-colors">
                  <th scope="row" class="py-3.5 px-6 font-semibold text-white">
                    <a
                      href={`https://github.com/krabka-io/${item.repo}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-krab-400 transition-colors"
                    >
                      {item.repo}
                    </a>
                  </th>
                  <td class="py-3.5 px-6">
                    {item.releaseVersion ? (
                      <div class="flex flex-col gap-0.5">
                        <span class="font-semibold text-white">{item.releaseVersion}</span>
                        <div class="text-xs text-gray-400 flex items-center gap-1">
                          <span class="text-gray-500">main @</span>
                          <a
                            href={`https://github.com/krabka-io/${item.repo}/commit/${item.mainCommit}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gray-300 hover:text-white transition-colors"
                            aria-label={`Latest commit ${item.mainCommit} on main for ${item.repo}`}
                          >
                            {item.mainCommit}
                          </a>
                          {item.aheadBy && item.aheadBy > 0 ? (
                            <span class="text-krab-400 font-medium">(+{item.aheadBy})</span>
                          ) : null}
                        </div>
                      </div>
                    ) : (
                      <div class="flex flex-col gap-0.5">
                        <span class="font-semibold text-gray-200">v{item.manifestVersion}-dev</span>
                        <div class="text-xs text-gray-400 flex items-center gap-1">
                          <span class="text-gray-500">main @</span>
                          <a
                            href={`https://github.com/krabka-io/${item.repo}/commit/${item.mainCommit}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gray-300 hover:text-white transition-colors"
                            aria-label={`Latest commit ${item.mainCommit} on main for ${item.repo}`}
                          >
                            {item.mainCommit}
                          </a>
                        </div>
                      </div>
                    )}
                  </td>
                  <td class="py-3.5 px-6">
                    <span
                      class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold ${
                        item.status === 'Stable'
                          ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                          : item.status === 'Beta / Pre-1.0'
                          ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
                          : 'bg-slate-500/10 text-slate-300 border border-slate-500/20'
                      }`}
                    >
                      <span
                        class={`h-1.5 w-1.5 rounded-full ${
                          item.status === 'Stable'
                            ? 'bg-emerald-400'
                            : item.status === 'Beta / Pre-1.0'
                            ? 'bg-amber-400'
                            : 'bg-slate-400'
                        }`}
                      ></span>
                      {item.status}
                    </span>
                  </td>
                  <td class="py-3.5 px-6 text-gray-400 text-xs">{item.target}</td>
                  <td class="py-3.5 px-6">
                    {item.provenance === 'SLSA L3 / Sigstore' || item.provenance === 'SLSA L3' ? (
                      <span class="inline-flex items-center gap-1 rounded bg-white/5 border border-white/10 px-2 py-0.5 text-[11px] text-gray-300">
                        <svg class="h-3 w-3 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        SLSA L3 / Sigstore
                      </span>
                    ) : item.provenance === 'Maven Central (PGP)' ? (
                      <span class="inline-flex items-center gap-1 rounded bg-white/5 border border-white/10 px-2 py-0.5 text-[11px] text-gray-300">
                        <svg class="h-3 w-3 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        Maven Central (PGP)
                      </span>
                    ) : (
                      <span class="inline-flex items-center rounded bg-white/5 border border-white/10 px-2 py-0.5 text-[11px] text-gray-400">
                        Planned (L3)
                      </span>
                    )}
                  </td>
                  <td class="py-3.5 px-6 text-right">
                    {item.releaseVersion ? (
                      <div class="flex flex-col items-end gap-1">
                        <a
                          href={item.changelogUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-xs font-semibold text-krab-400 hover:text-krab-300"
                          aria-label={`Release notes for ${item.repo} ${item.releaseVersion}`}
                        >
                          Release notes
                        </a>
                        {item.compareUrl && (
                          <a
                            href={item.compareUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-[11px] text-gray-400 hover:text-gray-300"
                            aria-label={`Compare ${item.repo} ${item.releaseVersion} with main branch`}
                          >
                            Compare with main
                          </a>
                        )}
                      </div>
                    ) : (
                      <a
                        href={item.changelogUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs font-semibold text-gray-400 hover:text-gray-300"
                        aria-label={`Commit history on main for ${item.repo}`}
                      >
                        Commit log
                      </a>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Section 2: Wire Compatibility Targets (Architectural Milestones) -->
    <div id="wire-compatibility" class="mb-20">
      <h2 class="text-2xl font-bold text-white mb-2">Apache Kafka Wire Compatibility Targets</h2>
      <p class="text-gray-400 text-sm mb-6">
        Krabka targets byte-level wire compatibility across Kafka release streams, tested against Apache Kafka's protocol specifications and JVM client suites.
      </p>

      <div class="frosted-card rounded-2xl overflow-hidden border border-white/10">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm" aria-label="Apache Kafka wire compatibility targets">
            <thead class="border-b border-white/10 bg-slate-950/80 text-xs font-semibold uppercase text-gray-400">
              <tr>
                <th scope="col" class="py-4 px-6">Kafka Release Stream</th>
                <th scope="col" class="py-4 px-6">Wire Protocol Level</th>
                <th scope="col" class="py-4 px-6">KRaft Metadata Layer</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {wireMatrix.map((row) => (
                <tr class="hover:bg-white/5 transition-colors">
                  <th scope="row" class="py-3.5 px-6 font-semibold text-white">{row.kafka}</th>
                  <td class="py-3.5 px-6 text-gray-300 text-xs">{row.wire}</td>
                  <td class="py-3.5 px-6 text-gray-400 text-xs">{row.kraft}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Section 3: Release Artifact Provenance & Cryptographic Verification -->
    <div id="provenance" class="frosted-card rounded-2xl p-8 border border-white/10">
      <div id="slsa" class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="text-xl font-bold text-white mb-1">Release Artifact Provenance & Cryptographic Verification</h2>
          <p class="text-gray-400 text-sm">
            Published release artifacts are signed and attested during CI: broker container images are signed keylessly with Sigstore (Cosign), release binaries carry SLSA Level 3 build provenance, and Java packages are signed for Maven Central.
          </p>
        </div>
        <button
          type="button"
          class="copy-btn self-start sm:self-auto flex items-center gap-1.5 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-gray-200 hover:bg-white/20 hover:text-white transition-all"
          data-copy={provenanceSnippet}
          aria-label="Copy verification snippet to clipboard"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          <span>Copy Snippet</span>
        </button>
      </div>

      <pre class="bg-black/50 p-4 rounded-xl font-mono text-xs text-krab-300 overflow-x-auto border border-white/5"><code>{provenanceSnippet}</code></pre>
    </div>

  </div>
</BaseLayout>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const textToCopy = btn.getAttribute('data-copy');
      if (textToCopy) {
        navigator.clipboard.writeText(textToCopy);
        const span = btn.querySelector('span');
        if (span) {
          span.textContent = 'Copied!';
          setTimeout(() => {
            span.textContent = 'Copy Snippet';
          }, 2000);
        }
      }
    });
  });
</script>
