---
import CodeBlock from '../components/CodeBlock.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPath } from '../utils/paths';

const clientSnippets = {
  rust: `// Cargo.toml:
//   krabka-client-producer = { git = "https://github.com/krabka-io/krabka-client-rs", rev = "c4ce581587772b3750d88c61f3389d9626a20235" }
//   plus the [patch.crates-io] block from that revision's Cargo.toml (see /docs/streams-rs)
//   bytes = "1"
//   tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
use bytes::Bytes;
use krabka_client_producer::{Acks, Producer, ProducerRecord};

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let producer = Producer::builder()
        .bootstrap("localhost:9092")
        .acks(Acks::All)
        .build()
        .await?;

    let metadata = producer
        .send(ProducerRecord {
            topic: "quickstart-events".into(),
            key: Some(Bytes::from("user-1")),
            value: Some(Bytes::from("Hello Krabka from Rust!")),
            ..Default::default()
        })
        .await?;

    producer.flush().await?;
    producer.close().await?;
    println!("Delivered to partition {} at offset {}.", metadata.partition, metadata.offset);
    Ok(())
}`,
  go: `// go get github.com/twmb/franz-go/pkg/kgo
// Produce a record with the franz-go Kafka client.
package main

import (
    "context"
    "fmt"

    "github.com/twmb/franz-go/pkg/kgo"
)

func main() {
    cl, err := kgo.NewClient(kgo.SeedBrokers("localhost:9092"))
    if err != nil { panic(err) }
    defer cl.Close()

    rec := &kgo.Record{Topic: "quickstart-events", Key: []byte("user-1"), Value: []byte("Hello Krabka from Go!")}
    if err := cl.ProduceSync(context.Background(), rec).FirstErr(); err != nil { panic(err) }
    fmt.Println("Produced message to Krabka!")
}`,
  java: `// Maven dependency: org.apache.kafka:kafka-clients:4.3.1
// Produce a record with the standard Apache Kafka Java client.
import org.apache.kafka.clients.producer.*;
import java.util.Properties;

public class App {
    public static void main(String[] args) throws InterruptedException, java.util.concurrent.ExecutionException {
        Properties props = new Properties();
        props.put("bootstrap.servers", "localhost:9092");
        props.put("key.serializer", "org.apache.kafka.common.serialization.StringSerializer");
        props.put("value.serializer", "org.apache.kafka.common.serialization.StringSerializer");

        Producer<String, String> producer = new KafkaProducer<>(props);
        producer.send(new ProducerRecord<>("quickstart-events", "user-1", "Hello Krabka from Java!")).get();
        System.out.println("Record delivered to quickstart-events.");
        producer.close();
    }
}`,
  python: `# python -m pip install confluent-kafka==2.15.1
# Save as app.py and run: python app.py
from confluent_kafka import Producer

producer = Producer({"bootstrap.servers": "localhost:9092"})

def delivered(error, message):
    if error is not None:
        raise RuntimeError(str(error))
    print(f"Delivered to partition {message.partition()} at offset {message.offset()}.")

producer.produce(
    "quickstart-events",
    key="user-1",
    value="Hello Krabka from Python!",
    on_delivery=delivered,
)
if producer.flush(30) != 0:
    raise TimeoutError("Message delivery timed out")`,
  javascript: `// npm install kafkajs@2.2.4
// Save as app.cjs and run: node app.cjs
const { Kafka } = require('kafkajs');

async function main() {
    const kafka = new Kafka({ clientId: 'quickstart', brokers: ['localhost:9092'] });
    const producer = kafka.producer();
    await producer.connect();
    try {
        await producer.send({
            topic: 'quickstart-events',
            messages: [{ key: 'user-1', value: 'Hello Krabka from KafkaJS!' }],
        });
        console.log('Record delivered to quickstart-events.');
    } finally {
        await producer.disconnect();
    }
}

main().catch(error => {
    console.error(error);
    process.exitCode = 1;
});`,
  cli: `KAFKA_TOOLS=docker.io/apache/kafka@sha256:01b9a4030e54c6068e66eb3ba4cb82c0d89238629ef1c30d79b86036bf89b1b7
KAFKA_NETWORK="container:$(docker compose ps -q broker)"
docker run --rm --network "$KAFKA_NETWORK" "$KAFKA_TOOLS" /opt/kafka/bin/kafka-topics.sh \\
  --bootstrap-server localhost:9092 --create --if-not-exists --topic quickstart-events --partitions 1 --replication-factor 1
printf 'hello krabka\\n' | docker run --rm -i --network "$KAFKA_NETWORK" "$KAFKA_TOOLS" \\
  /opt/kafka/bin/kafka-console-producer.sh --bootstrap-server localhost:9092 --topic quickstart-events
docker run --rm --network "$KAFKA_NETWORK" "$KAFKA_TOOLS" /opt/kafka/bin/kafka-console-consumer.sh \\
  --bootstrap-server localhost:9092 --topic quickstart-events --from-beginning --max-messages 1 --timeout-ms 30000`
};

const javascriptRunCode = `mkdir krabka-javascript
cd krabka-javascript
curl -fsSL https://krabka.io/quickstart/javascript/package.json -o package.json
curl -fsSL https://krabka.io/quickstart/javascript/app.cjs -o app.cjs
npm install
npm start`;
---

<BaseLayout
  title="Get started | Krabka"
  description="Evaluate Krabka with browser experiments, local Kafka clients, compatibility checks, and an isolated staging cluster."
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-left border-b border-white/10 pb-8 mb-12">
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Get started
      </h1>
      <p class="mt-4 text-lg text-gray-300">
        Evaluate Krabka against the Kafka clients, tools, and workloads you already use. Start with a browser experiment or a local broker, then check compatibility before a staging trial.
      </p>
    </div>

    <nav aria-label="Evaluation pathways" class="space-y-6 mb-12">
      <section class="frosted-card rounded-xl p-5 border border-white/10" aria-labelledby="browser-trial">
        <h2 id="browser-trial" class="text-xl font-bold text-white">Zero-install browser trial</h2>
        <p class="mt-2 text-sm text-gray-300">Use Cluster Lab to inspect KRaft consensus and partition failover. Try minimum ISR behavior, rack splits, and fault injection, then inspect the records and network traffic.</p>
        <p class="mt-2 text-sm text-gray-400">Cluster Lab is view-only on phones. Use a wider screen for editing and fault controls. Its virtual clock and network do not measure production throughput or disk durability.</p>
        <a href={getPath('/docs/lab/')} class="mt-3 inline-block text-krab-400 underline underline-offset-2">Open Cluster Lab</a>
      </section>
      <section class="frosted-card rounded-xl p-5 border border-white/10" aria-labelledby="local-validation">
        <h2 id="local-validation" class="text-xl font-bold text-white">Local and CI validation</h2>
        <p class="mt-2 text-sm text-gray-300">Run your integration test suite, local microservices, or kcat and Kafka CLI tools against a local Krabka broker at <code>localhost:9092</code>. Change the bootstrap address in a test configuration and verify delivery, consumption, and the APIs your application uses.</p>
        <p class="mt-2 text-sm text-gray-400">The quickstart owns the pinned Docker Compose and Helm runbooks, readiness checks, and first-record validation. Helm clients use the documented in-cluster bootstrap address instead of localhost.</p>
        <a href={getPath('/docs/quickstart')} class="mt-3 inline-block text-krab-400 underline underline-offset-2">Run the local quickstart</a>
      </section>
      <section id="compatibility" class="frosted-card rounded-xl p-5 border border-white/10" aria-labelledby="preflight-check">
        <h2 id="preflight-check" class="text-xl font-bold text-white">Pre-flight compatibility and parity check</h2>
        <p class="mt-2 text-sm text-gray-300">Check your client version, protocol features, schema registry, and operational tools before switching a workload. A producer round trip is not evidence of full application parity.</p>
        <ul class="mt-3 list-disc pl-5 space-y-3 text-sm text-gray-300">
          <li><strong>Client evidence:</strong> the release support matrix records Java kafka-clients tests for Kafka 3.4, 3.5, 3.8, 4.0.0, 4.1.0, and 4.3.1; librdkafka 1.8.2 and 2.15.0; sarama through kaf 0.2.14; and krabka-client-rs. The website snippet harness also covers confluent-kafka (librdkafka), franz-go, KafkaJS, and krabka-client-rs. These are specific tested paths, not a guarantee for every version or configuration.</li>
          <li><strong>Wire protocol:</strong> Kafka 3.x and 4.x API compatibility depends on the API key and request version negotiated with <code>ApiVersions</code>. Check the release-stream targets and KIP matrix for the Produce, Fetch, group, transaction, and admin features your application needs.</li>
          <li><strong>Schema registries:</strong> verify serializers, subject compatibility, and registry recovery with your registry version. MirrorMaker 2 does not migrate registry subjects as a separate service; the migration guide describes registry export or a controlled <code>_schemas</code> transfer.</li>
          <li><strong>Unsupported interfaces:</strong> no broker-side JVM plugins or JMX endpoint. JMX-only dashboards and Cruise Control cannot use those interfaces; scrape Prometheus metrics instead.</li>
          <li><strong>Partial and planned features:</strong> streams topology description updates and <code>streams.rack.aware.assignment.tags</code> are unsupported. Schema-aware geo-replication transforms and secured standalone replicator clients remain future work. Check the matrices for other gaps and behavior differences.</li>
        </ul>
        <p class="mt-3 text-sm text-gray-400">Release evidence is tied to the broker revision named in each row; historical results do not qualify a later build. Rerun the relevant checks on the image you intend to evaluate.</p>
        <p class="mt-3 text-sm"><a href={getPath('/docs/broker/operations/support-matrix')} class="text-krab-400 underline underline-offset-2">Check tested versions and release evidence</a> · <a href={getPath('/versions#wire-compatibility')} class="text-krab-400 underline underline-offset-2">Check wire compatibility targets</a> · <a href={getPath('/docs/kip-matrix')} class="text-krab-400 underline underline-offset-2">Review KIP support and gaps</a> · <a href={getPath('/docs/broker/operations/ecosystem-support')} class="text-krab-400 underline underline-offset-2">Check ecosystem tool interfaces</a></p>
      </section>
      <section class="frosted-card rounded-xl p-5 border border-white/10" aria-labelledby="staging-evaluation">
        <h2 id="staging-evaluation" class="text-xl font-bold text-white">Non-disruptive staging evaluation</h2>
        <p class="mt-2 text-sm text-gray-300">Use a separate Krabka cluster and test identities. Keep production producers and consumer groups on Kafka while you compare results; do not change their bootstrap addresses for the trial.</p>
        <ul class="mt-3 list-disc pl-5 space-y-3 text-sm text-gray-300">
          <li><strong>Dual-writing:</strong> send an approved test workload to both clusters and compare keys, values, ordering, and delivery failures. Writes to two clusters are not one atomic transaction; handle partial failures and duplicates.</li>
          <li><strong>MirrorMaker 2 active-passive replication:</strong> copy an explicitly approved topic set one way into the isolated target. Use least-privilege source access and keep cutover separate from evaluation; replication adds source load and copies data.</li>
          <li><strong>Shadow consumer verification:</strong> use separate consumer groups and disable external side effects. Compare records and application results without committing offsets for production groups.</li>
        </ul>
        <p class="mt-3 text-sm text-gray-400">MirrorMaker 2 changes target offsets and does not preserve producer IDs or transactional state. Registry data and credentials need separate handling; apply the guide's transaction-isolation and offset-translation checks before any cutover.</p>
        <p class="mt-3 text-sm"><a href={getPath('/docs/migration')} class="text-krab-400 underline underline-offset-2">Plan migration and cutover</a> · <a href={getPath('/docs/broker/operations/migrate-from-kafka')} class="text-krab-400 underline underline-offset-2">Follow the MirrorMaker 2 replication procedure</a></p>
      </section>
    </nav>

    <!-- Application client examples -->
    <div id="clients" class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <h2 class="text-2xl font-bold text-white">Wire-protocol verification</h2>
      </div>

      <p class="mb-4 max-w-3xl text-sm text-gray-300 leading-relaxed font-sans">
        First complete the <a href={getPath('/docs/quickstart')} class="text-krab-400 underline underline-offset-2">local quickstart</a> so a broker is running at <code>localhost:9092</code> and the <code>quickstart-events</code> topic exists. These examples verify that standard Kafka client libraries can connect and publish to Krabka with the bootstrap address changed, without a Krabka-specific adapter. They test record delivery, not every client feature; validate your own workload and security configuration separately. For Kubernetes, use the in-cluster bootstrap address and commands in the quickstart.
      </p>

      <div class="frosted-card rounded-2xl overflow-hidden border border-white/10">
        <div class="flex flex-wrap border-b border-white/10 bg-slate-950/80 px-4 py-2.5 gap-2" role="tablist" id="client-tabs" aria-label="Client language">
          <button type="button" role="tab" id="client-tab-c-java" aria-controls="client-c-java" aria-selected="true" tabindex="0" class="rounded-lg px-3.5 py-1.5 text-sm font-semibold text-gray-400 hover:text-white hover:bg-white/5 aria-selected:bg-krab-600 aria-selected:text-white">
            Java
          </button>
          <button type="button" role="tab" id="client-tab-c-python" aria-controls="client-c-python" aria-selected="false" tabindex="-1" class="rounded-lg px-3.5 py-1.5 text-sm font-semibold text-gray-400 hover:text-white hover:bg-white/5 aria-selected:bg-krab-600 aria-selected:text-white">
            Python
          </button>
          <button type="button" role="tab" id="client-tab-c-go" aria-controls="client-c-go" aria-selected="false" tabindex="-1" class="rounded-lg px-3.5 py-1.5 text-sm font-semibold text-gray-400 hover:text-white hover:bg-white/5 aria-selected:bg-krab-600 aria-selected:text-white">
            Go
          </button>
          <button type="button" role="tab" id="client-tab-c-javascript" aria-controls="client-c-javascript" aria-selected="false" tabindex="-1" class="rounded-lg px-3.5 py-1.5 text-sm font-semibold text-gray-400 hover:text-white hover:bg-white/5 aria-selected:bg-krab-600 aria-selected:text-white">
            Node.js
          </button>
          <button type="button" role="tab" id="client-tab-c-rust" aria-controls="client-c-rust" aria-selected="false" tabindex="-1" class="rounded-lg px-3.5 py-1.5 text-sm font-semibold text-gray-400 hover:text-white hover:bg-white/5 aria-selected:bg-krab-600 aria-selected:text-white">
            Rust
          </button>
          <button type="button" role="tab" id="client-tab-c-cli" aria-controls="client-c-cli" aria-selected="false" tabindex="-1" class="rounded-lg px-3.5 py-1.5 text-sm font-semibold text-gray-400 hover:text-white hover:bg-white/5 aria-selected:bg-krab-600 aria-selected:text-white">Kafka CLI</button>
        </div>

        <div class="p-6 bg-slate-950/90 font-mono text-sm leading-relaxed text-gray-200">
          <div id="client-c-java" role="tabpanel" aria-labelledby="client-tab-c-java">
            <div class="flex justify-between items-center gap-3 text-xs text-gray-400 mb-2 font-sans">
              <span>Standard Kafka Java client</span>
              <button type="button" class="copy-btn flex items-center gap-1 rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-all font-sans" data-copy={clientSnippets.java}>
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                <span>Copy</span>
              </button>
            </div>
            <CodeBlock size="sm" code={clientSnippets.java} lang="java" />
          </div>

          <div id="client-c-python" role="tabpanel" aria-labelledby="client-tab-c-python" hidden>
            <div class="flex justify-between items-center gap-3 text-xs text-gray-400 mb-2 font-sans">
              <span>confluent-kafka Python producer</span>
              <button type="button" class="copy-btn flex items-center gap-1 rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-all font-sans" data-copy={clientSnippets.python}>
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                <span>Copy</span>
              </button>
            </div>
            <CodeBlock size="sm" code={clientSnippets.python} lang="python" />
          </div>

          <div id="client-c-go" role="tabpanel" aria-labelledby="client-tab-c-go" hidden>
            <div class="flex justify-between items-center gap-3 text-xs text-gray-400 mb-2 font-sans">
              <span>Go client produce snippet</span>
              <button type="button" class="copy-btn flex items-center gap-1 rounded bg-white/5 px-2 py-1 text-gray-300 hover:bg-white/10 hover:text-white transition-all font-sans" data-copy={clientSnippets.go}>
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                <span>Copy</span>
