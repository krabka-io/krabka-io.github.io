---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPath } from '../utils/paths';
---

<BaseLayout
  title="Search | krabka"
  description="Search the krabka documentation, guides, feature pages, verification catalog and release notes."
>
  <div data-pagefind-ignore="all" class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Search</h1>
    <!-- Pagefind writes its index and UI into dist/pagefind after `astro build` (see package.json). -->
    <div id="search" class="mt-6" data-bundle={getPath('/pagefind/')}></div>
    <noscript><p class="mt-6 text-sm text-gray-400">Search needs JavaScript. The <a href={getPath('/docs')} class="text-krab-400 underline">documentation index</a> lists every guide.</p></noscript>
  </div>
</BaseLayout>

<style is:global>
  #search {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--color-krab-400);
    --pagefind-ui-text: var(--color-gray-200);
    --pagefind-ui-background: var(--color-ocean-900);
    --pagefind-ui-border: color-mix(in srgb, var(--color-white) 15%, transparent);
    --pagefind-ui-tag: color-mix(in srgb, var(--color-white) 8%, transparent);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-font: inherit;
  }

  #search .pagefind-ui__result-link {
    color: var(--color-white);
  }

  #search mark {
    background: color-mix(in srgb, var(--color-krab-500) 25%, transparent);
    color: inherit;
  }
</style>

<script>
  const root = document.getElementById('search')!;
  const bundle = root.dataset.bundle!;
  const query = new URLSearchParams(location.search).get('q') ?? '';

  const fail = () => {
    root.innerHTML = '<p class="text-sm text-gray-400">The search index is built with the production site (<code>npm run build</code>) and is not available here.</p>';
  };

  const css = document.createElement('link');
  css.rel = 'stylesheet';
  css.href = `${bundle}pagefind-ui.css`;
  document.head.append(css);

  const script = document.createElement('script');
  script.src = `${bundle}pagefind-ui.js`;
  script.onerror = fail;
  script.onload = () => {
    // @ts-expect-error: PagefindUI is the global the bundle defines.
    const ui = new window.PagefindUI({ element: '#search', bundlePath: bundle, showSubResults: true, showImages: false, autofocus: !query });
    if (query) ui.triggerSearch(query);
    // Keep the query in the address bar, so a search can be shared or reloaded.
    root.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      if (!input.matches('input')) return;
      const url = new URL(location.href);
      if (input.value) url.searchParams.set('q', input.value);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    });
  };
  document.head.append(script);
</script>
