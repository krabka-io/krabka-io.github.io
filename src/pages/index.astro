---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CodeSwitcher from '../components/CodeSwitcher.astro';
import VerificationBar from '../components/VerificationBar.astro';
import EcosystemGrid from '../components/EcosystemGrid.astro';
import { getPath } from '../utils/paths';
---

<BaseLayout
  title="krabka | Kafka-compatible broker in safe Rust"
  description="Kafka-compatible broker in safe Rust with a native KRaft quorum, Creusot-proved decision kernels, Stateright model checking, and native clients for Rust, Go, and Java. Apache 2.0."
>
  <Hero />
  <VerificationBar />
  <CodeSwitcher />
  <EcosystemGrid />

  <!-- CTA Banner -->
  <section class="py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="frosted-card rounded-3xl p-6 sm:p-14 border border-krab-500/30 bg-gradient-to-b from-slate-900/90 to-ocean-950/90 relative overflow-hidden">
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Run a single-node broker
        </h2>
        <p class="mt-4 text-lg text-gray-300 max-w-2xl mx-auto">
          Start a single-node KRaft cluster, point your existing Kafka clients and admin tools at it, or embed the native client libraries in your Rust, Go, and Java services.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href={getPath('/get-started')}
            class="inline-flex items-center justify-center rounded-xl bg-krab-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg transition-all hover:bg-krab-700 hover:shadow-krab-500/25"
          >
            Get Started
          </a>
          <a
            href={getPath('/verification')}
            class="inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 text-base font-semibold text-white transition-all hover:bg-white/10"
          >
            How krabka Is Verified
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
