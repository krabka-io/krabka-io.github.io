---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MetricStrip from '../components/MetricStrip.astro';
import CodeSwitcher from '../components/CodeSwitcher.astro';
import BenchmarkBar from '../components/BenchmarkBar.astro';
import EcosystemGrid from '../components/EcosystemGrid.astro';
import { getPath } from '../utils/paths';
---

<BaseLayout
  title="Krabka | Kafka wire protocol. Zero JVM. 1/10th the memory."
  description="Native-Rust Kafka-compatible broker, KRaft consensus quorum, and polyglot streaming engine for Rust, Go, and Java. Apache 2.0."
>
  <Hero />
  <MetricStrip />
  <BenchmarkBar />
  <CodeSwitcher />
  <EcosystemGrid />

  <!-- CTA Banner -->
  <section class="py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="frosted-card rounded-3xl p-10 sm:p-14 border border-krab-500/30 bg-gradient-to-b from-slate-900/90 to-ocean-950/90 relative overflow-hidden">
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Ready to run Kafka without the JVM overhead?
        </h2>
        <p class="mt-4 text-lg text-gray-300 max-w-2xl mx-auto">
          Start a single-node KRaft cluster in seconds or embed the native client libraries into your Rust, Go, and Java services.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href={getPath('/get-started')}
            class="inline-flex items-center justify-center rounded-xl bg-krab-500 px-6 py-3.5 text-base font-semibold text-white shadow-lg transition-all hover:bg-krab-600 hover:shadow-krab-500/25"
          >
            Get Started in 2 Minutes
          </a>
          <a
            href={getPath('/docs')}
            class="inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 text-base font-semibold text-white transition-all hover:bg-white/10"
          >
            Explore Documentation
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
