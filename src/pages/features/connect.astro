---
import BaseLayout from '../../layouts/BaseLayout.astro';

const cdcConfig = `# krabka-connect.toml - PostgreSQL CDC Source Connector
[[connectors]]
name = "postgres-orders-cdc"
type = "io.krabka.connect.postgres.PostgresSourceConnector"
tasks_max = 4

[connectors.config]
database_hostname = "db-prod.internal"
database_port = 5432
database_user = "krabka_cdc"
database_dbname = "ecommerce"
plugin_name = "pgoutput"
publication_name = "krabka_orders_pub"
slot_name = "krabka_orders_slot"
topic_prefix = "cdc.postgres"
tombstones_on_delete = true`;
---

<BaseLayout
  title="Krabka Connect & Postgres CDC | Krabka"
  description="Native database change data capture (CDC), PostgreSQL logical decoding replication, and distributed connector runtime in Krabka."
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <a href="/features" class="inline-flex items-center text-sm font-semibold text-krab-400 hover:text-krab-300 transition-colors font-sans mb-4">
        &larr; Back to Features Overview
      </a>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Krabka Connect & Postgres CDC
      </h1>
      <p class="mt-4 text-lg text-gray-300 leading-relaxed font-sans max-w-3xl">
        Stream real-time PostgreSQL database mutations directly into Krabka topics with guaranteed ordering, snapshotting, and transaction boundary preservation without running a heavy external JVM Kafka Connect cluster.
      </p>
    </div>

    <div class="space-y-8">
      
      <!-- Section A: Connector Framework SPI -->
      <div class="frosted-card rounded-2xl p-8 border border-white/10 space-y-4">
        <h2 class="text-2xl font-bold text-white font-sans">Connector SPI Contract (<code class="text-krab-400 font-mono text-xl">crabka-connect</code>)</h2>
        <p class="text-gray-300 leading-relaxed font-sans text-sm">
          The connector engine defines the core <code class="font-mono text-xs text-krab-300">Source</code>, <code class="font-mono text-xs text-krab-300">Sink</code>, and <code class="font-mono text-xs text-krab-300">Converter</code> traits, with derive macros in <code class="font-mono text-xs text-krab-300">crabka-connect-derive</code> for strongly-typed configuration validation.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs font-sans">
          <div class="bg-black/30 p-4 rounded-xl border border-white/5 space-y-1.5">
            <strong class="text-white font-bold">Source Trait</strong>
            <p class="text-gray-400 leading-relaxed">Polls external systems, producing typed change envelopes with precise transaction metadata and LSN offsets.</p>
          </div>
          <div class="bg-black/30 p-4 rounded-xl border border-white/5 space-y-1.5">
            <strong class="text-white font-bold">Sink Trait</strong>
            <p class="text-gray-400 leading-relaxed">Consumes batches from Kafka topics, mapping them to downstream databases or data lakes with idempotent writes.</p>
          </div>
          <div class="bg-black/30 p-4 rounded-xl border border-white/5 space-y-1.5">
            <strong class="text-white font-bold">Worker Runtime</strong>
            <p class="text-gray-400 leading-relaxed">Drives tasks via <code class="font-mono text-krab-300">crabka-connect-worker</code>, checkpointing progress and resuming without event loss.</p>
          </div>
        </div>
      </div>

      <!-- Section B: Postgres CDC Source -->
      <div class="frosted-card rounded-2xl p-8 border border-white/10 space-y-4">
        <h2 class="text-2xl font-bold text-white font-sans">PostgreSQL Logical Decoding Engine (<code class="text-krab-400 font-mono text-xl">crabka-connect-postgres</code>)</h2>
        <p class="text-gray-300 leading-relaxed font-sans text-sm">
          The PostgreSQL connector interfaces directly with PostgreSQL logical replication streams using the standard <code class="font-mono text-xs text-gray-200">pgoutput</code> decoding plugin:
        </p>
        <ul class="list-disc list-inside text-sm text-gray-400 space-y-2 font-sans pl-2">
          <li><strong>Lock-Free Consistent Snapshot:</strong> Performs initial table export without taking table locks that disrupt production queries.</li>
          <li><strong>Transaction Boundary Preservation:</strong> Propagates transaction commit timestamps, commit LSNs, and transaction IDs in Kafka record headers.</li>
          <li><strong>Automatic Schema Evolution:</strong> Maps PostgreSQL table DDL changes directly to Confluent Schema Registry schemas.</li>
        </ul>
      </div>

      <!-- Section C: Configuration -->
      <div class="frosted-card rounded-2xl p-8 border border-white/10 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-white font-sans">PostgreSQL CDC Connector Config</h2>
          <button type="button" class="copy-btn flex items-center gap-1.5 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-gray-200 hover:bg-white/20 hover:text-white transition-all font-sans" data-copy={cdcConfig}>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            <span>Copy Config</span>
          </button>
        </div>
        <pre class="bg-black/50 p-4 rounded-xl font-mono text-xs text-krab-300 overflow-x-auto border border-white/5"><code>{cdcConfig}</code></pre>
      </div>

      <!-- Section D: Cluster Replicator -->
      <div class="frosted-card rounded-2xl p-8 border border-white/10 space-y-4">
        <h2 class="text-2xl font-bold text-white font-sans">Active-Active Replicator (<code class="text-krab-400 font-mono text-xl">crabka-replicator</code>)</h2>
        <p class="text-gray-300 leading-relaxed font-sans text-sm">
          A native, high-throughput replication service wire-compatible with MirrorMaker 2. It synchronizes topic partitions across distinct geographic clusters, handles consumer offset translation, and prevents circular record replication for seamless multi-region disaster recovery.
        </p>
      </div>

    </div>

    <div class="mt-12 pt-8 border-t border-white/10 flex justify-between items-center font-sans text-sm">
      <a href="/features/tiered-storage" class="text-gray-400 hover:text-white">&larr; Tiered Storage</a>
      <a href="/features/streams" class="text-krab-400 hover:text-krab-300 font-semibold">Polyglot Streams &rarr;</a>
    </div>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const textToCopy = btn.getAttribute('data-copy');
      if (textToCopy) {
        navigator.clipboard.writeText(textToCopy);
        const span = btn.querySelector('span');
        if (span) {
          span.textContent = 'Copied!';
          setTimeout(() => {
            span.textContent = 'Copy Config';
          }, 2000);
        }
      }
    });
  });
</script>
