---
import CodeBlock from '../../components/CodeBlock.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPath } from '../../utils/paths';

const kraftConfig = `# broker.toml - KRaft quorum configuration for node 1
# Start with: krabka-broker --config-file broker.toml
broker_id = 1
log_dir = "/var/lib/krabka/data"

# <node_id>@<host>:<port> of each voter's controller listener
controller_quorum_voters = [
  "1@broker-1.prod.internal:9093",
  "2@broker-2.prod.internal:9093",
  "3@broker-3.prod.internal:9093",
]

heartbeat_interval = "2s"
controller_election_timeout = "1s"
controller_heartbeat_interval = "500ms"

[process]
roles = ["controller", "broker"]

[[listeners]]
name = "PLAINTEXT"
bind_addr = "0.0.0.0:9092"
advertised = "broker-1.prod.internal:9092"
protocol = "Plaintext"`;

const formatCmd = `krabka-format --log-dir /var/lib/krabka/data --cluster-id 3d70a78c-bb3a-4af5-a767-51e31f403c62 --node-id 1 --initial-controllers 1@broker-1.prod.internal:9093:<dir-id-1>,2@broker-2.prod.internal:9093:<dir-id-2>,3@broker-3.prod.internal:9093:<dir-id-3>`;
---

<BaseLayout
  title="Native KRaft Consensus Quorum | Krabka"
  description="Architecture and specifications for Krabka's native Rust KRaft metadata quorum engine (krabka-raft & krabka-kraft-core), KIP-595 wire compatibility, and dynamic quorum reconfiguration."
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <a href={getPath('/features')} class="inline-flex items-center text-sm font-semibold text-krab-400 hover:text-krab-300 transition-colors font-sans mb-4">
        Back to Features Overview
      </a>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Native KRaft Consensus Quorum
      </h1>
      <p class="mt-4 text-lg text-gray-300 leading-relaxed font-sans max-w-3xl">
        Krabka implements the Apache Kafka KRaft consensus protocol directly in memory-safe Rust (<code class="text-krab-300 font-mono text-sm">krabka-raft</code> and <code class="text-krab-300 font-mono text-sm">krabka-kraft-core</code>), with leader elections, metadata compaction, and no ZooKeeper dependency. The election and quorum decisions are Creusot-proved kernels, and the consensus engine has a Stateright model.
      </p>
    </div>

    <!-- Architectural Deep Dive Sections -->
    <div class="space-y-8 [&>div>p]:max-w-3xl">
      
      <!-- Section A: KIP-595 Protocol & Serialization -->
      <div class="frosted-card rounded-2xl p-5 sm:p-8 border border-white/10 space-y-4">
        <h2 class="text-2xl font-bold text-white font-sans">KIP-595 Wire RPC Interoperability</h2>
        <p class="text-gray-300 leading-relaxed font-sans text-sm">
          Krabka speaks the exact KIP-595 Raft RPC protocol on the wire. Controller voters communicate via native Rust serialization of metadata records (<code class="font-mono text-xs text-krab-300">PartitionRecord</code>, <code class="font-mono text-xs text-krab-300">TopicRecord</code>, <code class="font-mono text-xs text-krab-300">UserScramCredentialRecord</code>) matching JVM Kafka byte-for-byte.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs font-sans">
          <div class="bg-black/30 p-4 rounded-xl border border-white/5 space-y-1.5">
            <strong class="text-white font-bold">Split Roles</strong>
            <p class="text-gray-400 leading-relaxed">Nodes operate as dedicated controllers, dedicated brokers, or combined broker+controller nodes in flexible node pools.</p>
          </div>
          <div class="bg-black/30 p-4 rounded-xl border border-white/5 space-y-1.5">
            <strong class="text-white font-bold">Dynamic Reconfiguration</strong>
            <p class="text-gray-400 leading-relaxed">Add or decommission controller voters on live clusters through <code class="font-mono text-krab-300">krabka-voters</code> without restarting the metadata quorum.</p>
          </div>
          <div class="bg-black/30 p-4 rounded-xl border border-white/5 space-y-1.5">
            <strong class="text-white font-bold">Verified Elections</strong>
            <p class="text-gray-400 leading-relaxed">Randomized election timers and async heartbeats trigger a new election on partition. Quorum size and vote admission are Creusot-proved kernels, and the consensus engine has a Stateright model.</p>
          </div>
        </div>
      </div>

      <!-- Section B: Configuration & Format Code -->
      <div class="frosted-card rounded-2xl p-5 sm:p-8 border border-white/10 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-white font-sans">Quorum Configuration</h2>
          <button type="button" class="copy-btn flex items-center gap-1.5 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-gray-200 hover:bg-white/20 hover:text-white transition-all font-sans" data-copy={kraftConfig}>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            <span>Copy Config</span>
          </button>
        </div>
        <CodeBlock code={kraftConfig} lang="toml" />
      </div>

      <!-- Section C: In-Memory Metadata Image & Snapshots -->
      <div class="frosted-card rounded-2xl p-5 sm:p-8 border border-white/10 space-y-4">
        <h2 class="text-2xl font-bold text-white font-sans">In-Memory Metadata Image & Snapshots</h2>
        <p class="text-gray-300 leading-relaxed font-sans text-sm">
          Metadata logs are periodically compacted into zero-copy in-memory snapshot states (<code class="font-mono text-xs text-krab-300">krabka-metadata</code>). When a new node joins or an existing broker reconnects after a network partition, snapshot catch-up avoids replaying the full historical log.
        </p>
      </div>

      <!-- Section D: Formally Verified Kernels & Storage Seeding -->
      <div class="frosted-card rounded-2xl p-5 sm:p-8 border border-white/10 space-y-4">
        <h2 class="text-2xl font-bold text-white font-sans">Formally Verified Kernels & Deterministic Seeding</h2>
        <p class="text-gray-300 leading-relaxed font-sans text-sm">
          Core consensus invariants and quota token buckets are mathematically verified using the <strong class="text-white">Creusot</strong> deductive verification tool (<code class="font-mono text-xs text-krab-300">krabka-verified</code>, <code class="font-mono text-xs text-krab-300">krabka-throttle</code>). Log directories are seeded deterministically with <code class="font-mono text-xs text-krab-300">krabka-format</code>.
        </p>
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-semibold text-gray-300 font-sans">Seed a log directory</h3>
          <button type="button" class="copy-btn flex items-center gap-1.5 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-gray-200 hover:bg-white/20 hover:text-white transition-all font-sans" data-copy={formatCmd}>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            <span>Copy Command</span>
          </button>
        </div>
        <CodeBlock code={formatCmd} lang="bash" />
      </div>

    </div>

    <div class="mt-12 pt-8 border-t border-white/10 flex justify-between items-center font-sans text-sm">
      <a href={getPath('/features')} class="text-gray-400 hover:text-white">Features Overview</a>
      <a href={getPath('/features/tiered-storage')} class="text-krab-400 hover:text-krab-300 font-semibold">Tiered Storage</a>
    </div>
  </div>
</BaseLayout>
