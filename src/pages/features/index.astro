---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPath } from '../../utils/paths';

const characteristics = [
  { feature: 'Runtime', detail: 'Rust binary with Tokio async I/O', href: getPath('/docs/runtime-architecture') },
  { feature: 'Memory safety', detail: 'unsafe_code forbidden by lint under Cargo and Bazel', href: getPath('/verification#memory-safety') },
  { feature: 'Formal verification', detail: 'Creusot-proved decision-kernel contracts in krabka-verified', href: getPath('/verification#proof-contracts') },
  { feature: 'Model checking', detail: 'Stateright models checked within stated bounds on every pull request', href: getPath('/verification#model-bounds') },
  { feature: 'Metadata consensus', detail: 'KRaft quorum with KIP-595 wire codecs', href: getPath('/features/kraft') },
  { feature: 'Kafka wire protocol', detail: 'Apache Kafka 4.3 codecs generated from upstream schemas', href: getPath('/docs/kip-matrix') },
  { feature: 'Admin tooling', detail: 'Apache Kafka kafka-*.sh CLI tools and krabka-cli', href: getPath('/docs/cli') },
  { feature: 'Connect and CDC', detail: 'Separate krabka-connect PostgreSQL CDC worker and replicator', href: getPath('/docs/connect-postgres') },
  { feature: 'License', detail: 'Apache License 2.0', href: 'https://www.apache.org/licenses/LICENSE-2.0' },
];

const modules = [
  {
    title: 'Native KRaft consensus quorum',
    tag: 'krabka-broker',
    slug: getPath('/features/kraft'),
    desc: 'The Rust KRaft quorum stores cluster metadata in krabka-raft and krabka-kraft-core. It implements KIP-595 wire codecs, separate broker and controller roles, and dynamic quorum reconfiguration without ZooKeeper.',
    points: [
      'Byte-exact KRaft metadata records and in-memory image',
      'Dynamic voter addition and decommission without cluster restart',
      'Election and quorum decisions proved with Creusot; consensus model-checked with Stateright',
    ],
  },
  {
    title: 'Tiered storage',
    tag: 'krabka-broker',
    slug: getPath('/features/tiered-storage'),
    desc: 'krabka-remote-storage and krabka-object-store upload sealed partition segments to Amazon S3, Google Cloud Storage, or MinIO. The __remote_log_metadata topic stores the segment catalog.',
    points: [
      'Retention of sealed segments in object storage',
      'Local write-ahead log with async cloud offloading',
      'Retention and remote-read decisions are Creusot-proved kernels',
    ],
  },
  {
    title: 'krabka Connect and Postgres CDC',
    tag: 'krabka-connect',
    slug: getPath('/features/connect'),
    desc: 'The separate krabka-connect worker streams PostgreSQL WAL changes into Kafka topics with checkpointed, at-least-once delivery. Changes to each primary key stay in order; the connector does not take an initial snapshot.',
    points: [
      'PostgreSQL logical replication worker over pgoutput',
      'Distributed replicator (MirrorMaker 2 compatible)',
      'Schema-aware record transformations and checkpoints',
    ],
  },
  {
    title: 'Polyglot stream processing and Arrow',
    tag: 'krabka-streams-*',
    slug: getPath('/features/streams'),
    desc: 'Stream processing libraries for Rust, Go, and Java. The libraries provide state stores, Apache Arrow record-batch operators, schema serdes, and barrier coordination; support varies by language.',
    points: [
      'Native Rust streams (Tokio async pipeline and state stores)',
      'Go streams with Arrow record batches and barrier cuts',
      'Java client with schema registry and Arrow columnar serdes',
    ],
  },
  {
    title: 'Kubernetes native operator',
    tag: 'krabka-operator',
    slug: getPath('/features/operator'),
    desc: 'The operator reconciles krabka.io/v1alpha1 custom resources for Kafka clusters, node pools, topics, users, connectors, schema registries, and partition rebalancing.',
    points: [
      'CRDs for Kafka, KafkaNodePool, KafkaTopic, KafkaUser, and KafkaConnector',
      'StatefulSet rolling updates with readiness checks',
      'Integrated partition reassignment and rebalancing engine',
    ],
  },
  {
    title: 'Correctness and verification',
    tag: 'krabka-verified',
    slug: getPath('/verification'),
    desc: 'The broker forbids unsafe Rust. Creusot proves selected decision-kernel contracts, and Stateright checks crash and retry sequences within model bounds. CI reruns the proofs and models on every pull request.',
    points: [
      'unsafe_code forbidden under Cargo and Bazel',
      'Creusot proof sessions committed beside the code',
      'Stateright models with pinned unique-state counts',
    ],
  },
];
---

<BaseLayout
  image="/og/features.png"
  title="Features & Architecture Overview | krabka"
  description="Explore the architecture of krabka: native KRaft consensus, tiered storage, Kafka Connect and CDC, polyglot Arrow streams, the Kubernetes operator, and formal verification."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-left border-b border-white/10 pb-8 mb-12">
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Features and architecture
      </h1>
      <p class="mt-4 text-lg text-gray-300 max-w-3xl">
        The broker is written in <a href={getPath('/verification#memory-safety')} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">safe Rust</a>. Separate repositories provide clients, stream processing, connectors, and Kubernetes operations. Selected broker decisions have <a href="https://creusot.rs/" target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Creusot</a> proofs and <a href="https://www.stateright.rs/" target="_blank" rel="noopener noreferrer" class="text-krab-400 underline underline-offset-2 hover:text-krab-300">Stateright</a> models.
      </p>
    </div>

    <!-- Broker characteristics -->
    <div class="mb-20">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-white">Broker characteristics</h2>
        <p class="mt-1 text-gray-400 text-sm">
          Runtime, protocol, verification, and tooling details.
        </p>
      </div>

      <div class="frosted-card rounded-2xl overflow-hidden shadow-2xl border border-white/10">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-white/10 bg-slate-950/80 text-xs font-semibold uppercase text-gray-400 font-sans">
              <tr>
                <th scope="col" class="py-4 px-2 min-[340px]:px-3 sm:px-6">Feature</th>
                <th scope="col" class="py-4 px-2 min-[340px]:px-3 sm:px-6 text-krab-400 font-bold">Implementation</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 font-sans">
              {characteristics.map((row) => (
                <tr class="hover:bg-white/5 transition-colors">
                  <td class="py-3.5 px-2 min-[340px]:px-3 sm:px-6 font-semibold text-white"><a href={row.href} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">{row.feature}</a></td>
                  <td class="py-3.5 px-2 min-[340px]:px-3 sm:px-6 text-krab-300 font-medium">{row.detail}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 2. Modular Architecture Grid (6 Modules) -->
    <div class="mb-16">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-white">Components</h2>
        <p class="mt-1 text-gray-400 text-sm">
          Architecture, crates, and configuration for each component.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {modules.map((m) => (
          <a
            href={m.slug}
            class="frosted-card group rounded-2xl p-7 grid grid-rows-subgrid row-span-4 gap-y-0 hover:border-krab-500/50 hover:bg-slate-900/90 transition-all"
          >
            <!-- Subgrid: tag, title, text and checklist line up across a row of cards -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs text-krab-400 font-medium tracking-wider uppercase">
                {m.tag}
              </span>
              <span class="text-xs font-semibold text-gray-400 group-hover:text-krab-300 font-sans">
                Details
              </span>
            </div>

            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-krab-400 transition-colors">
              {m.title}
            </h3>

            <p class="text-sm text-gray-400 leading-relaxed mb-6">
              {m.desc}
            </p>

            <ul class="space-y-2 border-t border-white/5 pt-4 text-xs font-medium text-gray-300 font-sans">
              {m.points.map((pt) => (
                <li class="flex items-start gap-2">
                  <svg class="h-4 w-4 text-krab-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </a>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
