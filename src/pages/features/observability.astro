---
import BaseLayout from '../../layouts/BaseLayout.astro';

const o11yDemoRun = `# Launch the runnable full-signal Grafana observability stack
git clone https://github.com/krabka-io/krabka-o11y-demo
cd krabka-o11y-demo
docker compose up -d

# Open Grafana UI on http://localhost:3000 (admin / admin)`;
---

<BaseLayout
  title="Full-Signal Observability & Telemetry | Krabka"
  description="OpenTelemetry distributed tracing, Prometheus metrics, continuous CPU profiling, and pre-built Grafana dashboards in Krabka."
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <a href="/features" class="inline-flex items-center text-sm font-semibold text-krab-400 hover:text-krab-300 transition-colors font-sans mb-4">
        &larr; Back to Features Overview
      </a>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Full-Signal Observability
      </h1>
      <p class="mt-4 text-lg text-gray-300 leading-relaxed font-sans max-w-3xl">
        Observe every layer of your streaming cluster with zero external sidecars (<code class="text-krab-300 font-mono text-sm">crabka-telemetry</code>). Krabka natively exports Prometheus metrics, OpenTelemetry distributed traces, continuous CPU/memory profiles, and structured JSON/logfmt logs.
      </p>
    </div>

    <div class="space-y-8">
      
      <!-- Section A: Built-in Telemetry Signals -->
      <div class="frosted-card rounded-2xl p-8 border border-white/10 space-y-4">
        <h2 class="text-2xl font-bold text-white font-sans">First-Class Telemetry Signals (<code class="text-krab-400 font-mono text-xl">crabka-telemetry</code>)</h2>
        <p class="text-gray-300 leading-relaxed font-sans text-sm">
          Instead of deploying brittle JMX exporters or JVM agent bridges, Krabka exposes high-resolution telemetry natively:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-2 text-xs font-sans">
          <div class="bg-black/30 p-4 rounded-xl border border-white/5 space-y-1.5">
            <strong class="text-white font-bold">PromQL Metrics</strong>
            <p class="text-gray-400 leading-relaxed">Direct <code class="font-mono text-krab-300">/metrics</code> endpoint with partition lag histograms and commit queue depths.</p>
          </div>
          <div class="bg-black/30 p-4 rounded-xl border border-white/5 space-y-1.5">
            <strong class="text-white font-bold">OpenTelemetry Traces</strong>
            <p class="text-gray-400 leading-relaxed">End-to-end span propagation via W3C trace-context (<code class="font-mono text-krab-300">crabka-trace-context</code>).</p>
          </div>
          <div class="bg-black/30 p-4 rounded-xl border border-white/5 space-y-1.5">
            <strong class="text-white font-bold">Continuous Profiling</strong>
            <p class="text-gray-400 leading-relaxed">Live pprof endpoints for in-flight async CPU, allocations, and thread contention analysis.</p>
          </div>
          <div class="bg-black/30 p-4 rounded-xl border border-white/5 space-y-1.5">
            <strong class="text-white font-bold">OCSF Audit Logging</strong>
            <p class="text-gray-400 leading-relaxed">Security audit events serialized in standard OCSF format via <code class="font-mono text-krab-300">crabka-audit</code>.</p>
          </div>
        </div>
      </div>

      <!-- Section B: Runnable Grafana Demo -->
      <div class="frosted-card rounded-2xl p-8 border border-white/10 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-white font-sans">Run Observability Demo Stack (<code class="text-krab-400 font-mono text-lg">krabka-o11y-demo</code>)</h2>
          <button type="button" class="copy-btn flex items-center gap-1.5 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-gray-200 hover:bg-white/20 hover:text-white transition-all font-sans" data-copy={o11yDemoRun}>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            <span>Copy Commands</span>
          </button>
        </div>
        <pre class="bg-black/50 p-4 rounded-xl font-mono text-xs text-krab-300 overflow-x-auto border border-white/5"><code>{o11yDemoRun}</code></pre>
      </div>

      <!-- Section C: Structured Logs -->
      <div class="frosted-card rounded-2xl p-8 border border-white/10 space-y-4">
        <h2 class="text-2xl font-bold text-white font-sans">Structured JSON & logfmt Encoding</h2>
        <p class="text-gray-300 leading-relaxed font-sans text-sm">
          Logs are emitted with structured key-value semantics (<code class="font-mono text-xs text-krab-300">crabka-logfmt</code>), supporting direct ingestion into Grafana Loki, Datadog, or Elasticsearch with zero regex log parsing rules.
        </p>
      </div>

    </div>

    <div class="mt-12 pt-8 border-t border-white/10 flex justify-between items-center font-sans text-sm">
      <a href="/features/operator" class="text-gray-400 hover:text-white">&larr; Kubernetes Operator</a>
      <a href="/features" class="text-krab-400 hover:text-krab-300 font-semibold">Features Overview &rarr;</a>
    </div>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const textToCopy = btn.getAttribute('data-copy');
      if (textToCopy) {
        navigator.clipboard.writeText(textToCopy);
        const span = btn.querySelector('span');
        if (span) {
          span.textContent = 'Copied!';
          setTimeout(() => {
            span.textContent = 'Copy Commands';
          }, 2000);
        }
      }
    });
  });
</script>
