---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPath } from '../utils/paths';

// These paths are a contract. Published Helm charts point their Chart.yaml icon
// at /logo.png, and the component repositories link the marks below. Do not
// rename or move a file here without updating every consumer.
const marks = [
  { file: '/logo.png', use: 'The chart icon and the square mark at 250 x 250. Published Chart.yaml files point here.', dark: false },
  { file: '/logo.svg', use: 'The square mark as vector art. Use it wherever the size is not fixed.', dark: false },
  { file: '/brand/krabka-square.png', use: 'The square mark, full resolution, for a light background.', dark: false },
  { file: '/brand/krabka-square-black.png', use: 'The square mark for a dark background.', dark: true },
  { file: '/brand/krabka-wide.png', use: 'The horizontal lockup for a light background.', dark: false },
  { file: '/brand/krabka-wide-black.png', use: 'The horizontal lockup for a dark background.', dark: true },
  { file: '/brand/krabka-tall.png', use: 'The vertical lockup for a light background.', dark: false },
  { file: '/brand/krabka-tall-black.png', use: 'The vertical lockup for a dark background.', dark: true },
  { file: '/brand/krabka-text-wide.png', use: 'The horizontal lockup with the wordmark, for a light background.', dark: false },
  { file: '/brand/krabka-text-wide-black.png', use: 'The same lockup for a dark background.', dark: true },
  { file: '/brand/krabka-text-tall.png', use: 'The vertical lockup with the wordmark.', dark: false },
];

const colors = [
  { name: 'Vermilion', hex: '#ff4d2e', use: 'The accent. Claws, links, and the active state.' },
  { name: 'Deep vermilion', hex: '#c82408', use: 'The pressed and hover state of the accent.' },
  { name: 'Pacific navy', hex: '#0c1322', use: 'The page ground.' },
  { name: 'Abyss', hex: '#080d1a', use: 'The navigation bar and the darkest surface.' },
];

// ponytail: static previews preserve the download URLs; regenerate these when the originals change.
const preview = (file: string) => file.endsWith('.png') ? `/brand/previews/${file.split('/').pop()!.replace(/\.png$/, '.webp')}` : file;
---

<BaseLayout
  title="Brand Assets | krabka"
  description="The krabka marks, lockups and colours, with the stable URL of every file. Helm charts and the component repositories link these paths directly."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <div class="border-b border-white/10 pb-4">
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Brand Assets</h1>
      <p class="text-gray-400 mt-2 text-base">
        The marks, the lockups, and the URL each one is served from.
      </p>
    </div>

    <p class="text-sm text-gray-300 leading-relaxed">
      Every path below is stable. Published Helm charts point their
      <code class="font-mono text-krab-300">Chart.yaml</code> icon at
      <code class="font-mono text-krab-300">/logo.png</code>, and the component repositories link the
      marks from their own documentation. Treat a rename here as a breaking change.
    </p>

    <div class="frosted-card rounded-xl overflow-hidden border border-white/10">
      <!-- Below sm each row is a preview beside its path and description, so nothing is clipped. -->
      <table class="block sm:table w-full text-left text-xs">
        <thead class="hidden sm:table-header-group bg-slate-950/80 border-b border-white/10 uppercase text-gray-400 font-sans">
          <tr>
            <th class="py-3 px-4">Preview</th>
            <th class="py-3 px-4">Path</th>
            <th class="py-3 px-4">Use it for</th>
          </tr>
        </thead>
        <tbody class="block sm:table-row-group divide-y divide-white/5 font-sans">
          {marks.map((m) => (
            <tr class="grid grid-cols-[5rem_minmax(0,1fr)] grid-rows-[auto_1fr] gap-x-3 gap-y-1 p-3 sm:table-row sm:p-0 hover:bg-white/5 transition-colors">
              {/* min-w-0! because custom.css gives a table cell in a card a minimum width for scrolling, wider than these grid tracks. */}
              <td class="row-span-2 min-w-0! sm:py-3 sm:px-4">
                {/* A vertical lockup is taller than wide, so its tile is too; in a wide tile it shrank to a speck. */}
                <div class={`inline-flex w-20 items-center justify-center rounded-lg ${m.file.includes('tall') ? 'h-24' : 'h-14'} ${m.dark ? 'bg-[#000] border border-white/10' : 'bg-[#fff]'}`}>
                  <img src={getPath(preview(m.file))} alt={m.use} class={`max-w-16 object-contain ${m.file.includes('tall') ? 'max-h-[5.5rem]' : 'max-h-12'}`} loading="lazy" />
                </div>
              </td>
              {/* Below sm the path may break anywhere to fit its track; from sm up it stays whole, since the path is what people copy. */}
              <td class="min-w-0! break-all sm:break-normal sm:whitespace-nowrap sm:py-3 sm:px-4">
                <a class="font-mono text-krab-400 hover:text-krab-300 text-xs" href={getPath(m.file)}>{m.file}</a>
              </td>
              <td class="min-w-0! text-gray-300 sm:py-3 sm:px-4">{m.use}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-white">Colours</h2>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {colors.map((c) => (
        <div class="frosted-card rounded-xl border border-white/10 overflow-hidden">
          <div class="h-16 w-full border-b border-white/20" style={`background:${c.hex}`}></div>
          <div class="p-4 space-y-1">
            <div class="text-sm font-bold text-white">{c.name}</div>
            <div class="font-mono text-xs text-krab-300">{c.hex}</div>
            <p class="text-xs text-gray-400">{c.use}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="text-sm text-gray-400">
      The marks are Apache 2.0 licensed with the rest of the project. Use them to refer to krabka. Do
      not use them as the mark of your own product, and do not restyle or recolour them.
    </p>
  </div>
</BaseLayout>
