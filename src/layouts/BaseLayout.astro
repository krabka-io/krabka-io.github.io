---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getPath } from '../utils/paths';
import versions from '../data/versions.json';
import '../styles/fonts.css';
import '../styles/custom.css';
import '../styles/theme-light.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
}

const {
  title = "krabka | Kafka-compatible broker in safe Rust",
  description = "A Kafka protocol-compatible broker and native KRaft consensus quorum in safe Rust, with Creusot-proved decision kernels and Stateright model checking.",
  type = "website",
  image = "/og-image.png",
} = Astro.props;

const siteUrl = Astro.site || 'https://krabka.io';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImageURL = new URL(getPath(image), siteUrl);
// The site-wide card shows the tagline; a section's card shows the page's title.
const imageAlt = image === '/og-image.png' ? 'krabka: Kafka-compatible broker in safe Rust' : title;

// The project-level card goes on the home page only; every other page describes
// itself, not the software.
const isHome = Astro.url.pathname === getPath('/');
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "krabka",
  "operatingSystem": "Linux, macOS, Windows",
  "applicationCategory": "DeveloperApplication",
  "description": description,
  "url": siteUrl.toString(),
  "softwareVersion": versions.broker.version,
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "sameAs": ["https://github.com/krabka-io/krabka-broker"],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Organization",
    "name": "krabka-io",
    "url": "https://github.com/krabka-io"
  }
};
---

<!doctype html>
<html lang="en" class="dark motion-safe:scroll-smooth scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Theme before first paint: the saved choice, else the system's. -->
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    
    <!-- Favicon Suite (SVG, PNG, Apple Touch, ICO) -->
    <link rel="icon" type="image/svg+xml" href={getPath("/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={getPath("/favicon-32x32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={getPath("/favicon-16x16.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={getPath("/apple-touch-icon.png")} />
    <link rel="shortcut icon" href={getPath("/favicon.ico")} />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="preload" href={getPath('/fonts/inter-latin-wght-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="krabka releases" href={getPath('/releases.xml')} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#080d1a" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="krabka" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL.href} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Schema.org JSON-LD -->
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <slot name="head" />
    <!-- Cloudflare Web Analytics: cookieless. Load only on the configured site,
         so local checks and previews do not send production analytics. -->
    {import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script is:inline define:vars={{ beaconToken: import.meta.env.PUBLIC_CF_BEACON_TOKEN, siteHostname: new URL(siteUrl).hostname }}>
        if (location.hostname === siteHostname) {
          const beacon = document.createElement('script');
          beacon.async = true;
          beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          beacon.dataset.cfBeacon = JSON.stringify({ token: beaconToken });
          document.head.appendChild(beacon);
        }
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-ocean-950 text-gray-100 selection:bg-krab-500/30 selection:text-krab-200">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-krab-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Skip to main content</a>
    <Navbar />
    <main id="main" tabindex="-1" data-pagefind-body class="flex-grow focus:outline-none">
      <slot />
    </main>
    <Footer />
    <!-- One polite live region for every copy button on the page. -->
    <div id="copy-status" role="status" class="sr-only"></div>
    <!-- The Cluster Lab's isolation service worker (public/docs/lab/coi-sw.js, scope /docs/lab/ only), registered
         from every page once it has loaded: a visitor who reaches the lab from here opens it isolated, with no reload.
         The COEP value is the one coi.js chose for this browser; on the lab itself coi.js registers it. -->
    <script is:inline define:vars={{ labWorker: getPath('/docs/lab/coi-sw.js'), labScope: getPath('/docs/lab/') }}>
      if ('serviceWorker' in navigator && window.isSecureContext && location.pathname.indexOf(labScope) !== 0) {
        addEventListener('load', function () {
          var coep = 'credentialless';
          try {
            if (localStorage.getItem('krabka-coi-coep') === 'require-corp') coep = 'require-corp';
          } catch (e) {}
          navigator.serviceWorker.register(labWorker + '?coep=' + coep, { scope: labScope }).catch(function () {});
        });
      }
    </script>
  </body>
</html>

<script>
  import { enhanceHeadings } from '../utils/headings';

  enhanceHeadings();

  // Copy buttons. Any `.copy-btn[data-copy]` works, and each code fence in a
  // Markdown guide gets one injected, so hand-written and synced pages behave alike.
  const status = document.getElementById('copy-status');
  const timers = new WeakMap<HTMLElement, number>();

  let statusTimer = 0;

  async function copy(btn: HTMLElement, text: string) {
    let ok = true;
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // No clipboard over plain http, in a sandboxed frame, or when permission is denied.
      ok = false;
    }
    // Some buttons hold an icon plus a <span> label; others are bare text.
    const label = btn.querySelector('span') ?? (btn.children.length ? null : btn);
    if (label) {
      btn.dataset.label ??= label.textContent?.trim() ?? 'Copy';
      if (!btn.style.minWidth) {
        // Size the button for "Copied!" up front so the swap moves neither the row nor a sibling.
        label.textContent = 'Copied!';
        btn.style.minWidth = `${btn.offsetWidth}px`;
      }
      label.textContent = ok ? 'Copied!' : 'Copy failed';
      clearTimeout(timers.get(btn));
      timers.set(btn, window.setTimeout(() => { label.textContent = btn.dataset.label ?? 'Copy'; }, 2000));
    }
    if (status) {
      // Clear first so the same message announces again, and clear after so it
      // is not left behind as stray text for a screen reader in browse mode.
      status.textContent = '';
      clearTimeout(statusTimer);
      statusTimer = window.setTimeout(() => {
        status.textContent = ok ? 'Copied to clipboard' : 'Copy failed, select the text';
        statusTimer = window.setTimeout(() => { status.textContent = ''; }, 4000);
      }, 50);
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLElement>('.copy-btn[data-copy]');
    if (btn) void copy(btn, btn.dataset.copy!);
  });

  document.querySelectorAll<HTMLElement>('.markdown-body pre.astro-code').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code-fence';
    wrap.innerHTML =
      '<div class="flex justify-end rounded-t-xl border border-b-0 border-white/12 bg-[#050811] px-2 pt-1.5">' +
      '<button type="button" class="copy-btn rounded bg-white/5 px-2 py-1 text-xs text-gray-300 transition-colors hover:bg-white/10 hover:text-white">Copy</button></div>';
    const btn = wrap.querySelector<HTMLElement>('.copy-btn')!;
    btn.dataset.copy = pre.textContent ?? '';
    // Name each button for the section its code sits under; "Copy" alone repeats up to seven times a page.
    let heading: Element | null = pre;
    while (heading && !/^H[1-6]$/.test(heading.tagName)) heading = heading.previousElementSibling;
    btn.setAttribute('aria-label', `Copy code${heading ? `: ${heading.textContent?.trim()}` : ''}`);
    pre.replaceWith(wrap);
    wrap.append(pre);
  });
</script>
