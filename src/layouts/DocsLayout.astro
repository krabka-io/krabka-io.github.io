---
import BaseLayout from './BaseLayout.astro';
import { getPath } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
  // A markdown page under src/pages sets `layout` to this file and passes the
  // three props in its frontmatter instead.
  frontmatter?: { title: string; description: string; currentSlug: string };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? Astro.props.title ?? '';
const description = frontmatter?.description ?? Astro.props.description ?? '';
const currentSlug = frontmatter?.currentSlug ?? Astro.props.currentSlug ?? '';
// An .astro page styles its own body. A markdown page has no classes of its
// own, so the typography plugin styles it here.
const proseClass = frontmatter
  ? `prose prose-invert prose-sm max-w-none
     prose-headings:text-white prose-headings:font-bold
     prose-a:text-krab-400 hover:prose-a:text-krab-300 prose-a:no-underline
     prose-strong:text-white
     prose-code:text-krab-300 prose-code:font-mono prose-code:before:content-none prose-code:after:content-none
     prose-pre:bg-black/50 prose-pre:border prose-pre:border-white/5 prose-pre:rounded-xl
     prose-table:text-xs prose-th:text-gray-400 prose-th:uppercase prose-th:tracking-wider
     prose-td:align-top prose-hr:border-white/10`
  : '';

const docSections = [
  {
    category: 'Start Here',
    items: [
      { label: 'Introduction', slug: '/docs' },
      { label: 'Quickstart Guide', slug: '/docs/quickstart' },
      { label: 'Milestone 20 Qualification', slug: '/docs/qualification' },
      { label: 'Ecosystem Architecture', slug: '/docs/architecture' },
      { label: 'Runtime Architecture', slug: '/docs/runtime-architecture' },
      { label: 'Consensus Playground', slug: '/docs/playground' },
    ],
  },
  {
    category: 'Core Broker',
    items: [
      { label: 'Broker Engine', slug: '/docs/broker' },
      { label: 'KRaft Consensus', slug: '/docs/kraft' },
      { label: 'Tiered Storage', slug: '/docs/tiered-storage' },
      { label: 'Storage Formatting', slug: '/docs/formatting' },
    ],
  },
  {
    category: 'Polyglot Streams',
    items: [
      { label: 'Go Streams & Arrow', slug: '/docs/streams-go' },
      { label: 'Java Streams & Arrow', slug: '/docs/streams-java' },
      { label: 'Rust Streams & Client', slug: '/docs/streams-rs' },
      { label: 'Barrier Cuts & Epochs', slug: '/docs/barriers' },
      { label: 'Schema Registry & Serdes', slug: '/docs/schema-registry' },
      { label: 'Serdes & Data Formats', slug: '/docs/data-formats' },
    ],
  },
  {
    category: 'Connect & CDC',
    items: [
      { label: 'PostgreSQL CDC Source', slug: '/docs/connect-postgres' },
      { label: 'Cluster Replicator', slug: '/docs/replicator' },
    ],
  },
  {
    category: 'Operations & K8s',
    items: [
      { label: 'Kubernetes Operator', slug: '/docs/operator' },
      { label: 'Operator CRD Reference', slug: '/docs/crds' },
      { label: 'CLI Tooling (krabka-cli)', slug: '/docs/cli' },
      { label: 'Helm Chart Repository', slug: '/docs/helm-charts' },
    ],
  },
  {
    category: 'Performance & Benchmarks',
    items: [
      { label: 'Benchmark Methodology', slug: '/docs/benchmarks' },
    ],
  },
  {
    category: 'Compatibility',
    items: [
      { label: 'Kafka KIP Matrix', slug: '/docs/kip-matrix' },
    ],
  },
  {
    category: 'Observability',
    items: [
      { label: 'OpenTelemetry & PromQL', slug: '/docs/observability' },
    ],
  },
];

// Find active category
const activeCategory = docSections.find((sec) =>
  sec.items.some((item) => item.slug === currentSlug || (item.slug === '/docs' && currentSlug === '/docs/'))
)?.category || 'Docs';

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://krabka-io.github.io/krabka-website/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Docs",
      "item": "https://krabka-io.github.io/krabka-website/docs"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": activeCategory,
      "item": `https://krabka-io.github.io/krabka-website${currentSlug}`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": title,
      "item": `https://krabka-io.github.io/krabka-website${currentSlug}`
    }
  ]
};
---

<BaseLayout
  title={`${title} | Krabka Documentation`}
  description={description}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} slot="head" />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      
      <!-- Sticky Left Sidebar -->
      <aside class="lg:col-span-3">
        <div class="sticky top-24 space-y-6 max-h-[calc(100vh-8rem)] overflow-y-auto pr-3">
          <div class="pb-2 border-b border-white/10">
            <span class="text-xs font-bold uppercase tracking-wider text-krab-400 font-sans">
              Documentation Hub
            </span>
          </div>

          <nav class="space-y-6 text-sm font-sans" aria-label="Docs navigation">
            {docSections.map((sec) => (
              <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">
                  {sec.category}
                </h4>
                <ul class="space-y-1">
                  {sec.items.map((item) => {
                    const itemUrl = getPath(item.slug);
                    const isActive = Astro.url.pathname === itemUrl || (item.slug === '/docs' && Astro.url.pathname === getPath('/docs'));
                    return (
                      <li>
                        <a
                          href={itemUrl}
                          class={`block px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                            isActive
                              ? 'bg-krab-500/15 text-krab-400 font-bold border border-krab-500/30'
                              : 'text-gray-300 hover:text-white hover:bg-white/5'
                          }`}
                        >
                          {item.label}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Main Docs Content -->
      <main class="lg:col-span-9 space-y-4">
        <!-- Breadcrumbs UI -->
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-sans text-gray-400 pb-2">
          <a href={getPath('/')} class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href={getPath('/docs')} class="hover:text-white transition-colors">Docs</a>
          <span>/</span>
          <span class="text-gray-400">{activeCategory}</span>
          <span>/</span>
          <span class="text-krab-400 font-semibold">{title}</span>
        </nav>

        <div class="frosted-card rounded-2xl p-8 lg:p-10 border border-white/10 space-y-6">
          {frontmatter && (
            <div class="border-b border-white/10 pb-4">
              <h1 class="text-3xl font-extrabold text-white sm:text-4xl">{title}</h1>
            </div>
          )}
          <div class={proseClass}>
            <slot />
          </div>
        </div>
      </main>

    </div>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const textToCopy = btn.getAttribute('data-copy');
      if (textToCopy) {
        navigator.clipboard.writeText(textToCopy);
        const span = btn.querySelector('span');
        if (span) {
          span.textContent = 'Copied!';
          setTimeout(() => {
            span.textContent = 'Copy';
          }, 2000);
        }
      }
    });
  });
</script>
