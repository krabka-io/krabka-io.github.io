---
import fs from 'node:fs';
import BaseLayout from './BaseLayout.astro';
import { getPath } from '../utils/paths';

// Where a page's text lives, for "Edit this page" and "Report an issue". A
// synced guide passes its own; a page of this site finds its file below.
interface Source {
  repo: string;
  path: string;
  branch?: string;
  commit?: string;
  date?: string;
}

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
  wide?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
  source?: Source;
  image?: string;
  // A markdown page under src/pages sets `layout` to this file and passes the
  // three props in its frontmatter instead.
  frontmatter?: { title: string; description: string; currentSlug: string };
}

const { frontmatter, image = '/og/docs.png' } = Astro.props;
const title = frontmatter?.title ?? Astro.props.title ?? '';
const description = frontmatter?.description ?? Astro.props.description ?? '';
const currentSlug = frontmatter?.currentSlug ?? Astro.props.currentSlug ?? '';
const wide = Astro.props.wide;

// An .astro page styles its own body. A markdown page has no classes of its
// own, so it takes the same `markdown-body` styling as the synced guides,
// including the scroll container around each table.
const proseClass = frontmatter ? 'markdown-body' : '';

const docSections = [
  {
    category: 'Start Here',
    items: [
      { label: 'Introduction', slug: '/docs' },
      { label: 'Quickstart Guide', slug: '/docs/quickstart' },
      { label: 'Migrating from Apache Kafka', slug: '/docs/migration' },
    ],
  },
  {
    category: 'Browser Tools',
    items: [
      { label: 'Choose a Browser Tool', slug: '/docs/browser-tools' },
      { label: 'Consensus Playground', slug: '/docs/playground' },
      { label: 'Cluster Lab', slug: '/docs/lab' },
      { label: 'Verification Playground', slug: '/docs/verification-playground' },
      { label: 'Proof Explorer', slug: '/docs/proof-explorer' },
      { label: 'Correctness & Verification', slug: '/verification' },
    ],
  },
  {
    category: 'Architecture',
    items: [
      { label: 'Ecosystem Architecture', slug: '/docs/architecture' },
      { label: 'Runtime Architecture', slug: '/docs/runtime-architecture' },
    ],
  },
  {
    category: 'Core Broker (krabka-broker)',
    items: [
      { label: 'Overview & Quickstart', slug: '/docs/broker' },
      { label: 'Configuration Reference', slug: '/docs/broker/config-reference' },
      { label: 'Kafka Compatibility Overview', slug: '/docs/kip-matrix' },
      { label: 'KIP Matrix (generated)', slug: '/docs/broker/kip_matrix' },
      { label: 'Format Divergences', slug: '/docs/broker/format-divergences' },
      { label: 'Verification Catalog', slug: '/docs/broker/verification' },
      { label: 'Roadmap', slug: '/docs/broker/roadmap' },
    ],
  },
  {
    category: 'Java Streams (krabka-streams-java)',
    items: [
      { label: 'Overview & Quickstart', slug: '/docs/streams-java' },
      { label: 'Getting Started', slug: '/docs/streams-java/getting-started' },
      { label: 'Architecture', slug: '/docs/streams-java/architecture' },
      { label: 'Configuration', slug: '/docs/streams-java/configuration' },
      { label: 'API Reference', slug: '/docs/streams-java/api-reference' },
      { label: 'Columnar Processing', slug: '/docs/streams-java/columnar' },
      { label: 'Columnar Operators', slug: '/docs/streams-java/columnar-operators' },
      { label: 'Serdes', slug: '/docs/streams-java/serdes' },
      { label: 'Schema Registry', slug: '/docs/streams-java/schema-registry' },
      { label: 'Barrier Alignment', slug: '/docs/streams-java/barriers' },
      { label: 'Coordination', slug: '/docs/streams-java/coordination' },
      { label: 'Testing', slug: '/docs/streams-java/testing' },
      { label: 'Runtime Constraints', slug: '/docs/streams-java/limitations' },
      { label: 'Troubleshooting', slug: '/docs/streams-java/troubleshooting' },
    ],
  },
  {
    category: 'Go Streams (krabka-streams-go)',
    items: [
      { label: 'Overview & Quickstart', slug: '/docs/streams-go' },
      { label: 'Getting Started', slug: '/docs/streams-go/getting-started' },
      { label: 'Configuration', slug: '/docs/streams-go/configuration' },
      { label: 'Columnar Processing', slug: '/docs/streams-go/columnar' },
      { label: 'Serdes', slug: '/docs/streams-go/serdes' },
      { label: 'Schema Registry', slug: '/docs/streams-go/schema-registry' },
      { label: 'Barrier Cuts', slug: '/docs/streams-go/barriers' },
      { label: 'Coordination Primitives', slug: '/docs/streams-go/coordination' },
      { label: 'Testing', slug: '/docs/streams-go/testing' },
      { label: 'Architecture', slug: '/docs/streams-go/architecture' },
    ],
  },
  {
    category: 'Operations & Deployment',
    items: [
      { label: 'Operations Index', slug: '/docs/operations' },
      { label: 'Deploy & Rolling Upgrade', slug: '/docs/broker/operations/deploy' },
      { label: 'Backup & Restore', slug: '/docs/broker/operations/backup-restore' },
      { label: 'Restore from Archive', slug: '/docs/broker/operations/runbooks/restore-from-archive' },
      { label: 'Metrics & Alerts', slug: '/docs/broker/operations/metrics' },
      { label: 'Scale a Cluster', slug: '/docs/broker/operations/scaling' },
      { label: 'Helm Chart Repository', slug: '/docs/helm-charts' },
      { label: 'CLI Tooling (krabka-cli)', slug: '/docs/cli' },
    ],
  },
  {
    category: 'Kubernetes Operator',
    items: [
      { label: 'Overview & Install', slug: '/docs/operator' },
      { label: 'CRD Explorer', slug: '/docs/operator/crds' },
      ...['Kafka', 'KafkaNodePool', 'KafkaTopic', 'KafkaUser', 'KafkaConnector', 'KafkaRebalance', 'SchemaRegistry', 'KafkaGrpcGateway'].map((kind) => ({ label: kind, slug: `/docs/operator/crds/${kind.toLowerCase()}` })),
      { label: 'Upstream Reference', slug: '/docs/operator/reference' },
    ],
  },
  {
    category: 'Rebalancer',
    items: [
      { label: 'Overview & Workflow', slug: '/docs/rebalancer' },
      { label: 'Configuration & API', slug: '/docs/rebalancer/reference' },
      { label: 'Broker Integration Tests', slug: '/docs/rebalancer/broker-tests' },
    ],
  },
  {
    category: 'Gateway',
    items: [
      { label: 'Overview & Configuration', slug: '/docs/gateway' },
      { label: 'Upstream Reference', slug: '/docs/gateway/reference' },
      { label: 'CloudEvents Ingestion', slug: '/docs/gateway/cloudevents' },
      { label: 'GitLab Ingestion', slug: '/docs/gateway/gitlab-ingestion' },
      { label: 'GitHub Firehose', slug: '/docs/gateway/github-firehose' },
    ],
  },
  {
    category: 'Ecosystem & Connect',
    items: [
      { label: 'Rust Client & Streams', slug: '/docs/streams-rs' },
      { label: 'Serdes & Data Formats', slug: '/docs/data-formats' },
      { label: 'PostgreSQL CDC Source', slug: '/docs/connect-postgres' },
    ],
  },
  {
    // How the project is built, released and qualified: for contributors, not
    // for running krabka.
    category: 'Project Internals',
    items: [
      { label: 'Release Qualification (M23)', slug: '/docs/qualification' },
      { label: 'Broker Qualification Gates', slug: '/docs/broker/qualification' },
      { label: 'Broker KIP Inventory', slug: '/docs/broker/kip_inventory' },
      { label: 'Proof Contract Audit', slug: '/docs/broker/proof-contract-audit' },
      { label: 'Mutation Sweep Baseline', slug: '/docs/broker/mutants-baseline' },
      { label: 'Docgen Contract', slug: '/docs/broker/docgen-contract' },
      { label: 'Broker Release Process', slug: '/docs/broker/releasing' },
      { label: 'Java Streams Build and Release', slug: '/docs/streams-java/build-and-release' },
    ],
  },
];

const normalize = (p: string) => p.replace(/\/$/, '') || '/';
const currentNorm = normalize(currentSlug || Astro.url.pathname);

const isItemActive = (slug: string) => {
  const normSlug = normalize(slug);
  const fullSlug = normalize(getPath(slug));
  return currentNorm === normSlug || currentNorm === fullSlug;
};

const isCategoryActive = (sec: typeof docSections[0]) => {
  return sec.items.some((item) => {
    if (isItemActive(item.slug)) return true;
    const itemNorm = normalize(item.slug);
    if (item.slug !== '/docs' && currentNorm.startsWith(itemNorm + '/')) return true;
    const fullNorm = normalize(getPath(item.slug));
    if (item.slug !== '/docs' && currentNorm.startsWith(fullNorm + '/')) return true;
    return false;
  });
};

// An exact item match wins over the most specific parent prefix. Nested
// operations runbooks belong to Operations, not the broker overview.
const activeSection =
  docSections.find((sec) => sec.items.some((item) => isItemActive(item.slug))) ??
  docSections.filter(isCategoryActive).sort((a, b) => {
    const matchingLength = (sec: typeof docSections[0]) => Math.max(...sec.items.map((item) =>
      currentNorm.startsWith(normalize(getPath(item.slug)) + '/') ? item.slug.length : 0));
    return matchingLength(b) - matchingLength(a);
  })[0];
const activeCategory = activeSection?.category || 'Docs';
// A synced guide's title carries its component, "Roadmap (Broker)"; the crumb
// already names the category, so it matches the sidebar and the page heading.
const crumbTitle = title.replace(/ \((Broker|Java Streams|Go Streams|Rust Streams|Connect|Operator|Gateway|Rebalancer|CLI)\)$/, '');

const site = Astro.site ?? 'https://krabka.io';
const pageUrl = new URL(Astro.url.pathname, site).href;
const sectionUrl = activeSection && new URL(getPath(activeSection.items[0].slug), site).href;
const crumbs: [string, string][] = [
  ['Home', new URL(getPath('/'), site).href],
  ['Docs', new URL(getPath('/docs'), site).href],
  ...(sectionUrl && sectionUrl !== pageUrl ? [[activeCategory, sectionUrl] as [string, string]] : []),
  [crumbTitle, pageUrl],
];
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": crumbs.map(([name, item], i) => ({ "@type": "ListItem", "position": i + 1, name, item })),
};

// Previous and next page, in sidebar order.
const flat = docSections.flatMap((sec) => sec.items);
const here = flat.findIndex((item) => isItemActive(item.slug));
const prev = here > 0 ? flat[here - 1] : null;
const next = here >= 0 && here < flat.length - 1 ? flat[here + 1] : null;

// A page of this site lives under src/pages in the website repository.
const ownFile = [`src/pages${currentNorm}.astro`, `src/pages${currentNorm}.md`, `src/pages${currentNorm}/index.astro`]
  .find((f) => fs.existsSync(f));
const source: Source | undefined = Astro.props.source ?? (ownFile ? { repo: 'krabka-io.github.io', path: ownFile } : undefined);
const repoUrl = `https://github.com/krabka-io/${source?.repo ?? 'krabka-io.github.io'}`;
const editUrl = source && `${repoUrl}/edit/${source.branch ?? 'main'}/${source.path}`;
const issueUrl = `${repoUrl}/issues/new?title=${encodeURIComponent(`Docs: ${crumbTitle}`)}&body=${encodeURIComponent(`Page: ${pageUrl}\n\n`)}`;
const syncedOn = source?.date?.slice(0, 10);
const isDocsHome = currentNorm === normalize(getPath('/docs'));
---

<BaseLayout
  title={`${title} | krabka docs`}
  description={description}
  type="article"
  image={image}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} slot="head" />

  <div class:list={['mx-auto px-4 sm:px-6 lg:px-8 py-10 font-sans', wide ? 'max-w-[112rem]' : 'max-w-[96rem]']}>
    <div class:list={['grid grid-cols-1 gap-8 lg:grid-cols-[15rem_minmax(0,1fr)]', !wide && 'xl:grid-cols-[15rem_minmax(0,1fr)_13rem]']}>

      <!-- Sticky Left Sidebar -->
      <aside aria-label="Documentation menu" data-pagefind-ignore>
        <!-- The page-wide skip link lands here, at the top of the menu; this one jumps past it. -->
        <a href="#docs-article" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-krab-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Skip to article</a>
        <!-- Below lg the whole menu folds behind one summary, so the page starts
             at its content. From lg up the script below keeps it open. -->
        <details id="docs-nav" open class="lg:contents">
          <summary class="flex cursor-pointer select-none items-center justify-between rounded-lg border border-white/10 bg-white/[0.03] px-3.5 py-2.5 text-sm font-semibold text-gray-100 lg:hidden">
            <span>Documentation menu</span>
            <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
            </svg>
          </summary>
        <!-- Only from lg up is the menu a sticky column that scrolls on its own; on a phone it
             is part of the page flow so it does not become a nested scroller. -->
        <div class="mt-3 space-y-4 lg:sticky lg:top-24 lg:mt-0 lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto lg:pr-3">
          <form action={getPath('/search')} method="get" role="search" class="relative">
            <label for="docs-search" class="sr-only">Search the documentation</label>
            <input
              id="docs-search"
              name="q"
              type="search"
              placeholder="Search docs…"
              class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-gray-100 placeholder:text-gray-500 focus:border-krab-500/60 focus:outline-none"
            />
          </form>

          <!-- Standalone API Reference Directory Nav Component -->
          <a
            href={getPath('/api')}
            class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-semibold text-gray-200 hover:text-white hover:bg-white/5 border border-white/10 bg-white/[0.02] transition-colors group"
          >
            <span class="flex items-center gap-2">
              <svg class="h-3.5 w-3.5 text-krab-400 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
              <span>API Reference Directory</span>
            </span>
            <span class="text-[11px] text-gray-400 font-mono">/api</span>
          </a>

          <nav class="space-y-2 text-sm" aria-label="Documentation navigation">
            {docSections.map((sec) => {
              const active = sec === activeSection;
              const isOpen = active || sec.category === 'Start Here';

              return (
                <details class="group rounded-lg border border-white/5 bg-white/[0.02] overflow-hidden" open={isOpen}>
                  <summary class="flex items-center justify-between px-3 py-2 text-xs font-semibold text-gray-300 hover:text-white cursor-pointer select-none list-none transition-colors">
                    <span class={active ? 'text-krab-400 font-bold' : ''}>{sec.category}</span>
                    <svg class="h-3 w-3 text-gray-500 transition-transform duration-200 group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </summary>
                  <ul class="px-2 pb-2 pt-1 space-y-0.5">
                    {sec.items.map((item) => {
                      const activeItem = isItemActive(item.slug);
                      return (
                        <li>
                          <a
                            href={getPath(item.slug)}
                            aria-current={activeItem ? 'page' : undefined}
                            class={`block px-2.5 py-1.5 lg:py-1 rounded-md text-xs transition-colors ${
                              activeItem
                                ? 'bg-krab-500/15 text-krab-400 font-semibold'
                                : 'text-gray-400 hover:text-white hover:bg-white/5'
                            }`}
                          >
                            {item.label}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </details>
              );
            })}
          </nav>
        </div>
        </details>
        <script is:inline>
          (function () {
            var nav = document.getElementById('docs-nav');
            var wide = window.matchMedia('(min-width: 64rem)');
            if (!wide.matches) nav.open = false;
            wide.addEventListener('change', function (e) { nav.open = e.matches; });
          })();
        </script>
      </aside>

      <!-- Main Docs Content -->
      <div id="docs-article" tabindex="-1" class="docs-page min-w-0 space-y-4 focus:outline-none">
        <!-- Breadcrumbs UI. The links pad out to a 28px hit area without growing the row. -->
        <nav aria-label="Breadcrumb" data-pagefind-ignore class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-xs text-gray-400 pb-2">
          <a href={getPath('/')} class="-my-1.5 py-1.5 hover:text-white transition-colors">Home</a>
          <span aria-hidden="true">/</span>
          <a href={getPath('/docs')} class="-my-1.5 py-1.5 hover:text-white transition-colors">Docs</a>
          {activeSection && (
            <>
              <span aria-hidden="true">/</span>
              <a href={getPath(activeSection.items[0].slug)} class="-my-1.5 py-1.5 hover:text-white transition-colors">{activeSection.category}</a>
            </>
          )}
          <span aria-hidden="true">/</span>
          <span class="text-gray-200 font-medium" aria-current="page">{crumbTitle}</span>
        </nav>

        <!-- Below xl the page's sections fold into one menu at the top; from xl up they sit in the right rail. -->
        {!wide && (
          <details class="toc-inline hidden rounded-lg border border-white/10 bg-white/[0.02] xl:hidden" data-pagefind-ignore>
            <summary class="cursor-pointer select-none px-3.5 py-2.5 text-xs font-semibold text-gray-200">On this page</summary>
            <ul class="toc-list px-3.5 pb-3 text-xs"></ul>
          </details>
        )}

        <div class:list={['frosted-card rounded-2xl border border-white/10 space-y-6', wide ? 'p-4 sm:p-6' : 'p-4 sm:p-8 lg:p-10']}>
          {isDocsHome && (
            <div class="rounded-lg border border-krab-500/20 bg-krab-500/5 px-4 py-3 text-xs text-gray-400 flex items-start gap-3">
              <svg class="h-4 w-4 text-krab-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div class="leading-relaxed">
                <span class="font-medium text-gray-200">krabka-broker 1.x:</span> every 1.x broker reads the on-disk formats an earlier 1.x broker wrote, and rolling upgrades within 1.x work. Data that a 0.x broker wrote must be reformatted. The Rust APIs, configuration and the other krabka components still change between releases. See the <a href={getPath('/news/krabka-1-0-0')} class="text-krab-400 hover:underline">1.0.0 announcement</a> and <a href={getPath('/versions')} class="text-krab-400 hover:underline">release status</a>.
              </div>
            </div>
          )}

          {source?.commit && (
            <aside aria-label="Guide source and version scope" data-pagefind-ignore class="rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-xs leading-relaxed text-gray-400">
              Guide source: <a href={`${repoUrl}/blob/${source.commit}/${source.path}`} target="_blank" rel="noopener noreferrer" class="break-all font-mono text-gray-300 underline underline-offset-2 hover:text-white">{source.repo}@{source.commit.slice(0, 7)}</a>
              {source.branch && <> · branch <code>{source.branch}</code></>}
              {syncedOn && <> · source commit date <time datetime={source.date}>{syncedOn}</time></>}.
              <span class="block mt-1">This guide may include unreleased changes. Check the guide at your installed release tag and the <a href={getPath('/versions')} class="text-krab-400 underline underline-offset-2 hover:text-krab-300">release status</a> before applying commands.</span>
            </aside>
          )}

          {frontmatter ? (
            <>
              <div class="border-b border-white/10 pb-4">
                <h1 class="text-3xl font-extrabold text-white sm:text-4xl">{title}</h1>
              </div>
              <div class={proseClass}>
                <slot />
              </div>
            </>
          ) : (
            <slot />
          )}

          <footer data-pagefind-ignore class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-gray-400 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
              {editUrl && <a href={editUrl} target="_blank" rel="noopener noreferrer" class="text-gray-300 underline underline-offset-2 hover:text-white">Edit this page</a>}
              <a href={issueUrl} target="_blank" rel="noopener noreferrer" class="text-gray-300 underline underline-offset-2 hover:text-white">Report an issue</a>
            </div>
            {source?.commit && (
              <div>
                Synced from <a href={`${repoUrl}/blob/${source.commit}/${source.path}`} target="_blank" rel="noopener noreferrer" class="font-mono text-[11px] text-gray-300 underline hover:text-white">{source.repo}@{source.commit.slice(0, 7)}</a>
                {source.branch && <> ({source.branch}{syncedOn && <>, {syncedOn}</>})</>}; may describe unreleased changes.
              </div>
            )}
          </footer>
        </div>

        {(prev || next) && (
          <nav aria-label="Previous and next page" data-pagefind-ignore class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {prev ? (
              <a href={getPath(prev.slug)} rel="prev" class="rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3 transition-colors hover:border-krab-500/40 hover:bg-white/5">
                <span class="block text-[11px] uppercase tracking-wider text-gray-400">Previous</span>
                <span class="block text-sm font-semibold text-gray-100">← {prev.label}</span>
              </a>
            ) : <span />}
            {next && (
              <a href={getPath(next.slug)} rel="next" class="rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3 text-right transition-colors hover:border-krab-500/40 hover:bg-white/5">
                <span class="block text-[11px] uppercase tracking-wider text-gray-400">Next</span>
                <span class="block text-sm font-semibold text-gray-100">{next.label} →</span>
              </a>
            )}
          </nav>
        )}
      </div>

      {!wide && (
        <aside aria-label="On this page" data-pagefind-ignore class="hidden xl:block">
          <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
            <p class="toc-title hidden pb-2 text-[11px] font-semibold uppercase tracking-wider text-gray-400">On this page</p>
            <ul class="toc-list border-l border-white/10 text-xs"></ul>
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import { enhanceHeadings } from '../utils/headings';

  // The page's sections, from its own h2 and h3 headings, listed in the right
  // rail and the folded menu, with the section in view marked.
  const article = document.getElementById('docs-article');
  const lists = document.querySelectorAll<HTMLUListElement>('.toc-list');
  const headings = enhanceHeadings().filter((h) => (h.tagName === 'H2' || h.tagName === 'H3') && article?.contains(h));
  if (lists.length && headings.length > 1) {
    for (const list of lists) {
      list.innerHTML = headings
        .map((h) => {
          // The heading's own text, without the "#" link BaseLayout appends.
          const text = [...h.childNodes]
            .filter((n) => !(n instanceof Element && n.classList.contains('heading-anchor')))
            .map((n) => n.textContent)
            .join('')
            .trim();
          const indent = h.tagName === 'H3' ? 'pl-5' : 'pl-3';
          return `<li><a href="#${h.id}" class="-ml-px block border-l border-transparent py-1 ${indent} leading-snug text-gray-400 hover:text-white">${text.replace(/</g, '&lt;')}</a></li>`;
        })
        .join('');
    }
    document.querySelectorAll('.toc-inline, .toc-title').forEach((el) => el.classList.remove('hidden'));

    const links = (id: string) => document.querySelectorAll<HTMLAnchorElement>(`.toc-list a[href="#${CSS.escape(id)}"]`);
    let current = '';
    const mark = (id: string) => {
      if (id === current) return;
      if (current) links(current).forEach((a) => { a.classList.remove('toc-active'); a.removeAttribute('aria-current'); });
      links(id).forEach((a) => { a.classList.add('toc-active'); a.setAttribute('aria-current', 'location'); });
      current = id;
    };
    // The current section is the last heading above the top fifth of the window.
    const update = () => {
      const line = window.innerHeight * 0.2;
      let id = headings[0].id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= line) id = h.id;
        else break;
      }
      mark(id);
    };
    let queued = false;
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    }, { passive: true });
    update();
  }
</script>
