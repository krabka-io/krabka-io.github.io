# Every input of the Why3 web bundle, pinned. `aspect`-style digests are not in
# play here: the Bazel action's inputs are this file, the scripts beside it and
# the locked base image, so a change to any of them rebuilds the bundle.
#
# Creusot v0.13.0 is what krabka-broker proves with (see its .creusot-version),
# and these are the Why3 and Alt-Ergo releases its creusot-setup pins.
CREUSOT_TAG=v0.13.0
CREUSOT_COMMIT=318615be3b8bbc60d1f6d52469ba5c0bdebed4f1
# creusot-deps.opam pins Why3 to this commit of its GitLab repository, which
# is ahead of the 1.8.2 release: the Coma files Creusot 0.13.0 writes use
# `[%#span]` references that the 1.8.2 parser does not know.
WHY3_VERSION=1.8.2+git-54c92f96
WHY3_GIT=https://gitlab.inria.fr/why3/why3.git
WHY3_COMMIT=54c92f96bb0711d6e991c18f10bfbc08d90d028b
ALT_ERGO_VERSION=2.6.2
ALT_ERGO_URL=https://github.com/OCamlPro/alt-ergo/releases/download/v2.6.2/alt-ergo-2.6.2.tbz
ALT_ERGO_SHA256=39e2c9128a7d1e89f332e31a2716f359f3b9e1a925fe81f11fa4a749b5d24d82
# The compiler opam builds inside the image. js_of_ocaml 6.2.0 needs OCaml < 5.5,
# and Wolfi ships whatever OCaml is newest, so the switch pins its own.
OCAML_VERSION=5.3.0
JS_OF_OCAML_VERSION=6.2.0

# Official browser distributions, matching Creusot's native solver versions.
Z3_VERSION=4.15.3
Z3_WEB_URL=https://registry.npmjs.org/z3-solver/-/z3-solver-4.15.3.tgz
Z3_WEB_SHA256=f44631572a42c8a7a45c632c9a4c47a98a2c29a55c6bf72b1624fbb29646e2f8
CVC5_VERSION=1.3.1
CVC5_WEB_URL=https://github.com/cvc5/cvc5/releases/download/cvc5-1.3.1/cvc5-Wasm.zip
CVC5_WEB_SHA256=85427c77c0e506292a46a25652909b71ee444371ffaa4804c40956dedbcf5c67
CVC5_SOURCE_URL=https://codeload.github.com/cvc5/cvc5/tar.gz/refs/tags/cvc5-1.3.1
CVC5_SOURCE_SHA256=ce1dce7b1ba8ade0ba7937b8ad7aa6ffa1df0dd9586963ead082baa299ef32d5
