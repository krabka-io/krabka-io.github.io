"""The Why3 web bundle: Why3, Alt-Ergo, Z3 and cvc5 for the browser.

The proof explorer on /docs/proof-explorer re-checks the broker's Creusot
proof sessions in the browser. That needs Why3 (to split a Coma file into the
recorded verification conditions and print them for the prover) and Alt-Ergo
(to discharge them), both as web workers. js_of_ocaml compiles them from the
releases Creusot v0.13.0 pins, inside a builder container whose base is the
locked Wolfi image in image.apko.yaml, the same shape as krabka-broker's
//tools/creusot.

    bazel build //why3-web:bundle        # bazel-bin/why3-web/why3-web.tar
    bash why3-web/install.sh             # the same, unpacked into public/why3-web/

The bundle is a Bazel output whose inputs are the locked base, pins.env, the
scripts and the worker source here, so a tree that changes none of them reuses
the cached tar instead of rebuilding OCaml for half an hour.
"""

load("@rules_apko//apko:defs.bzl", "apko_image")
load("@rules_img//img:convert.bzl", "image_manifest_from_oci_layout")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:media_types.bzl", "GZIP_LAYER")

package(default_visibility = ["//visibility:public"])

apko_image(
    name = "base_oci",
    config = "image.apko.yaml",
    contents = "@why3_web_base_lock//:contents",
    tag = "krabka-why3-web-base:locked",
    tags = ["manual"],
)

image_manifest_from_oci_layout(
    name = "base",
    src = ":base_oci",
    architecture = "amd64",
    layers = [GZIP_LAYER],
    os = "linux",
    tags = ["manual"],
)

# Everything the build inside the container reads: the pins, the build script,
# the Why3 configuration and driver the worker embeds, the prelude generator
# port and the worker source.
image_layer(
    name = "builder_layer",
    srcs = {
        "/usr/local/bin/build-why3-web": ":build-why3-web.sh",
        "/opt/why3-web/pins.env": ":pins.env",
        "/opt/why3-web/why3.conf": ":why3.conf",
        "/opt/why3-web/try_alt_ergo.drv": ":try_alt_ergo.drv",
        "/opt/why3-web/gen-prelude.mjs": ":gen-prelude.mjs",
        "/opt/why3-web/stage-smt.mjs": ":stage-smt.mjs",
        "/opt/why3-web/smt-worker.js": ":smt-worker.js",
        "/opt/why3-web/worker/proof_worker.ml": "//why3-web/worker:proof_worker.ml",
        "/opt/why3-web/worker/dune": "//why3-web/worker:dune",
        "/opt/why3-web/alt-ergo/ae_worker.ml": "//why3-web/alt-ergo:ae_worker.ml",
        "/opt/why3-web/alt-ergo/ae_worker_stubs.js": "//why3-web/alt-ergo:ae_worker_stubs.js",
        "/opt/why3-web/alt-ergo/dune.stanza": "//why3-web/alt-ergo:dune.stanza",
    },
    default_metadata = file_metadata(mode = "0755"),
    tags = ["manual"],
)

image_manifest(
    name = "builder_image",
    base = ":base",
    entrypoint = ["/usr/local/bin/build-why3-web"],
    layers = [":builder_layer"],
    tags = ["manual"],
)

image_load(
    name = "builder_load",
    image = ":builder_image",
    tag = "docker.io/krabka-io/why3-web-builder:creusot-0.13.0",
    tags = ["manual"],
)

filegroup(
    name = "builder_tar",
    srcs = [":builder_load"],
    output_group = "tarball",
    tags = ["manual"],
)

# Docker is the Linux isolation boundary only: compilers, libraries, package
# manager and source pins all come from builder_image. The action needs the
# network for opam and the pinned source archives, so it runs unsandboxed and
# locally, and Bazel caches its one output.
genrule(
    name = "bundle",
    srcs = [
        ":run-builder.sh",
        ":builder_tar",
    ],
    outs = ["why3-web.tar"],
    cmd = "$(location :run-builder.sh) $(location :builder_tar) $@",
    local = True,
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
