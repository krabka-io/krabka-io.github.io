{
  "name": "krabka-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run prepare:benchmark-archive && node scripts/sync-docs.mjs && node --experimental-strip-types scripts/sync-proofs.mjs && astro dev",
    "start": "npm run prepare:benchmark-archive && astro dev",
    "sync-docs": "node scripts/sync-docs.mjs",
    "sync-proofs": "node --experimental-strip-types scripts/sync-proofs.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:benchmark": "node --test scripts/benchmark.test.mjs scripts/benchmark-openmessaging-shards.test.mjs scripts/publish-openmessaging.test.mjs scripts/benchmark-website.test.mjs scripts/benchmark-archive.test.mjs scripts/news-benchmark-claims.test.mjs",
    "lint": "eslint scripts",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,mts}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,mts}\"",
    "build:playground": "bash playground/build.sh",
    "build:why3-web": "bash why3-web/install.sh",
    "build:broker": "bash playground/broker-wasi/build.sh",
    "build:site": "npm run prepare:benchmark-archive && astro build && npm run check-sitemap && pagefind --site dist",
    "build": "npm run prepare:benchmark-archive && npm run build:playground && node scripts/sync-docs.mjs && node --experimental-strip-types scripts/sync-proofs.mjs && astro build && npm run check-sitemap && pagefind --site dist",
    "check-links": "node scripts/check-links.mjs",
    "check-catalog": "node --experimental-strip-types scripts/check-catalog.mjs",
    "check-seo": "node scripts/check-seo.mjs",
    "check-api-links": "node scripts/check-api-links.mjs",
    "check-production": "node scripts/check-production.mjs",
    "test:website": "node --experimental-strip-types --test scripts/snippets-workflow.test.mjs scripts/ci-changes.test.mjs scripts/deployment-contract.test.mjs scripts/tool-downloads.test.mjs scripts/doc-title.test.mjs scripts/site-check-suites.test.mjs scripts/site-checks.test.mjs scripts/sitemap.test.mjs scripts/lastmod.test.mjs scripts/sync-docs.test.mjs scripts/sync-proofs.test.mjs scripts/versions.test.mjs scripts/heading-ids.test.mjs scripts/satteri-base-links.test.mjs scripts/page-budgets.test.mjs scripts/operator-crds.test.mjs && node scripts/check-sync-links.mjs",
    "check-component-docs": "node --test scripts/operator-crds.test.mjs && node scripts/check-component-docs.mjs",
    "check-site": "node scripts/check-site.mjs",
    "check-page-budgets": "node scripts/check-page-budgets.mjs",
    "build:brand": "node scripts/brand-previews.mjs",
    "check-lab": "node scripts/check-lab.mjs",
    "check-lab-acls": "node scripts/check-lab-acls.mjs",
    "check-lab-presets": "node scripts/check-lab-presets.mjs",
    "check-lab-migrate": "node scripts/check-lab-migrate.mjs",
    "check-lab-clusters": "node scripts/check-lab-clusters.mjs",
    "check-lab-experiments": "node scripts/check-lab-experiments.mjs",
    "check-lab-external": "node scripts/check-lab-external.mjs",
    "check-lab-logs-ui": "node scripts/check-lab-logs-ui.mjs",
    "check-lab-analyzer": "node scripts/check-lab-analyzer.mjs",
    "check-lab-observe": "node scripts/check-lab-observe.mjs",
    "gen-kafka-schemas": "node scripts/gen-kafka-schemas.mjs",
    "repin-kernels": "node scripts/repin-kernels.mjs",
    "check-lab-logs": "node scripts/check-lab-logs.mjs",
    "check-real-broker": "node scripts/check-real-broker.mjs",
    "check-wasi": "node scripts/check-wasi.mjs",
    "check-proof-highlight": "node scripts/check-proof-highlight.mjs",
    "check-proof-workers": "node scripts/check-proof-workers.mjs",
    "check-proof-smt": "node scripts/check-proof-smt.mjs",
    "check-proof-readability": "node scripts/check-proof-readability.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check-snippets": "node scripts/check-snippets.mjs",
    "test:snippets": "node --test scripts/snippets/extract.test.mjs",
    "prepare:benchmark-archive": "node scripts/prepare-benchmark-archive.mjs",
    "check:benchmark-viewer": "node scripts/check-benchmark-viewer.mjs",
    "check-sitemap": "node scripts/check-sitemap.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.7",
    "clsx": "^2.1.1",
    "github-slugger": "2.0.0",
    "js-yaml": "5.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tailwindcss/typography": "^0.5.20",
    "eslint": "9.39.1",
    "globals": "16.4.0",
    "pagefind": "^1.5.2",
    "playwright": "1.64.0",
    "prettier": "3.8.1",
    "sax": "^1.6.1"
  }
}
