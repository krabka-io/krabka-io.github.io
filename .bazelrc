# The website's Bazel module builds one thing: the Why3 web bundle under
# //why3-web, whose only host requirement is Docker. Everything else about the
# site is npm.
build --incompatible_strict_action_env
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
test --test_output=errors

# The toolchain genrule under //why3-web shells out to Docker; without this,
# a failure there reports only the target name.
build --verbose_failures

try-import %workspace%/user.bazelrc

# The Why3 web bundle takes a long time to build; keep the outputs of the
# cacheable actions across local runs. CI does not use this directory: the
# bundle genrule is local and unsandboxed, so it is never answered from here,
# and deploy.yml caches the unpacked bundle instead.
build --disk_cache=~/.cache/bazel-disk
